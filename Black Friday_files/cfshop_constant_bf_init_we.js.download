function getRandomInt(min, max) {
	min = Math.ceil(min);
	max = Math.floor(max);
	return Math.floor(Math.random() * (max - min + 1)) + min;
}


function mysteryDiscount(subtotal){
	/*
	 N/A 	 N/A
	  100 	  500
	  250 	  1,250
	  500 	  2,500
	  1,000 	  5,000
	  1,500 	  7,500

	*/
	var min, max;
	var savings = 0;

	if(subtotal >= 10000) {
		min = 100;
		max = 500;
	}

	if(subtotal >= 25000) {
		min = 250;
		max = 1250;		}
	if(subtotal >= 50000) {
		min = 500;
		max = 2500;
	}
	if(subtotal >= 100000) {
		min = 1000;
		max = 5000;		}

	if(subtotal >= 200000) {
		min = 1500;
		max = 7500;
	}

	savings = (min) ? getRandomInt(min, max) : 0;

	return savings;
}

function updateTranslations(){

	$('#checkoutTitle').text(checkout);
	$('#checkoutBalance').text(act_balance_text);
	$('#checkoutCost').text(regtotal);
	$('#checkoutRemaining').text(rmdr_balance_text);
	$('#btn-confirm').text(checkout);
	$('#checkoutCancel').text(cancelText);
	$('#btn-checkout').text(checkout);
	$('#btn-close').text(continueShoppingActionText);
	$('#cartTitleName').text(cartTitle);
	$('#totalCartText').text(cartTotalText);
	$('.cart-item-ui-remove').text(removeText);
}

function showModalMessage(message, header = general_error_title){

	if(header){
		$('#modalMessageTitle').html(header);
	}
	if(message){
		$('#message').html('<p>' + message + '</p>');
	}


	var strings = [
					  '<h1 id="modalMessageTitle">'
					,   header
					, '</h1>'
					,  '<div id="message">'
					,      message
					,  '</div>'
					,  '<div id="controls"><button id="btn-close">' + continueShoppingActionText + '</button></div>'

				   ];

	var string = strings.join('');

	$('.modal__checkout-message').html(string);

	activateModal('.modal__checkout-message')

}

let discountPriceCount = 0;
function addToConsole(string)
{
	if(debug){
		try{

			if(typeof string === 'string' && string.includes('new discount PRICE')){

				discountPriceCount++;
			}

			console.log(string);
		}catch(e){
			console.log(e)
		}
	}
}

function addCommas(nStr)
{

	if(parseInt(nStr) && nStr === 0 || isNaN(nStr)) { return 0;}

	nStr += '';
	let x = nStr.split('.');
	let x1 = x[0];
	let x2 = x.length > 1 ? '.' + x[1] : '';
	let rgx = /(\d+)(\d{3})/;
	while (rgx.test(x1)) {
		x1 = x1.replace(rgx, '$1' + commaVal + '$2');
	}
	return x1 + x2;
}

function init(){

    if(smartOptions.show_cart){
		$('.cart_table').smartCart(smartOptions);
    }else{
        $('#menuNavWallet').smartCart(smartOptions);
    }

	let initiated = false;

	$(document).ajaxStop(function() {
		if(!initiated){
			initiated = true;

			try{initializeClock();}catch(e){console.log(e);}
			try{startCarousels();}catch(e){console.log(e);}
			try{startModals();}catch(e){console.log(e);}
			try{startModalsVideo();}catch(e){console.log(e);}

			//Independent Order
			try{initializeAccordions();}catch(e){console.log(e);}
			try{initializeScrollFX();}catch(e){console.log(e);}
			try{initializeTabs();}catch(e){console.log(e);}
			try{initializeToolTips();}catch(e){console.log(e);}

			//console.log('Counted: ' + discountPriceCount + ' discounts performed');
		}
	});
}

