function updateBonuses(items){

	// reward TIER_IDs are 2-6

	var showReward = null;

	addToConsole(items);
	if(!(items)){ return;}
	addToConsole('showing bonuses received');

	$.each(items, function(i, reward) {

		var progressElem = ".progress" + (parseInt(reward.TIER_ID, 10) - 1);
		//$( progressElem ).attr('obtained', '');
		
		$( progressElem + ' > .status').html('<span>' + obtainedText + '</span>');
		$( progressElem + ' > .status').addClass('icon').addClass('cfshop-icon-checked');

		showReward = progressElem;
		addToConsole('showing reward for ', showReward);

	});
}