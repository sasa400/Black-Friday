function drawSocial() {
  var socialLinksDOM = "";
  if (Array.isArray(socialLinks) && socialLinks.length >= 1) {
    socialLinksDOM += '<section class="footer__sns">';
    socialLinks.forEach(function(socialLinksi){
      socialLinksDOM += '<a = href="'+ socialLinksi.url +'" title="'+ socialLinksi.url +'" target="_blank">';
      socialLinksDOM += '<div class="footer__sociallink" id="sns-'+ socialLinksi.service + '" style="background-image:url(\'';
      if ( $('.wrapper__footer').data('themedark') != null ){
        socialLinksDOM += socialLinksImage.urlWhite;
      } else {
        socialLinksDOM += socialLinksImage.urlBlack;
      }
      socialLinksDOM += '\')"></div></a>';
    });
    socialLinksDOM += '</section>';
  }
  if ( $('.wrapper__footer').data('sns') != null ){
    $('.wrapper__footer').append(socialLinksDOM);
  }
}

function drawFooter() {
  var localCIBIDOM = "";
  var partnerCIBIDOM = "";
  var copyrightTextDOM = "";
  var footerLinksDOM = "";

  if ( $('.wrapper__footer').data('gamelogo') == null ){
    var localCIBIshift = localCIBI.shift();
    drawLocalCIBI()
  } else {
    localCIBIshift = localCIBI;
    drawLocalCIBI()
  }
  function drawLocalCIBI() {
    localCIBI.forEach(function(localCIBIi){
      localCIBIDOM += '<img src="';
        if ( $('.wrapper__footer').data('themedark') != null ){
          localCIBIDOM += localCIBIi.urlWhite;
        } else {
          localCIBIDOM += localCIBIi.urlBlack;
        }
      localCIBIDOM +='" height="60" title="' + localCIBIi.title + '"/>';
    });
  }

  if ( Array.isArray(partnerCIBI) && partnerCIBI.length >= 1 ){
    partnerCIBI.forEach(function(partnerCIBIi){
      partnerCIBIDOM += '<img src="';
        if ( $('.wrapper__footer').data('themedark') != null ){
          partnerCIBIDOM += partnerCIBIi.urlWhite;
        } else {
          partnerCIBIDOM += partnerCIBIi.urlBlack;
        }
      partnerCIBIDOM += '" height="60" title="' + partnerCIBIi.title + '"/>';
    });
  }

  copyrightText.forEach(function(copyrightTexti){
    copyrightTextDOM += '&copy; ' + copyrightTexti + '&nbsp;';
  });
  copyrightTextDOM += copyrightTrade;
  footerLinks.forEach(function(footerLinksi){
    footerLinksDOM += '<li><a href="' + footerLinksi.url + '" target="_blank">' + footerLinksi.label + '</a></li>';
  });

  var footerModules = '<section class="footer__cibi">';
    footerModules += '<article class="footer__cibi-local">' + localCIBIDOM + '</article>';
      if (Array.isArray(partnerCIBI) && partnerCIBI.length >= 1){
        footerModules += '<article class="footer__cibi-partner">' + partnerCIBIDOM + '</article>';
      }
    footerModules += '</section><section class="footer__copyrights"><p>' + copyrightTextDOM + '</p><ul>' + footerLinksDOM + '</ul></section>';
  $('.wrapper__footer').append(footerModules);
  $('.copyright-year').append(copyrightDate);
}

/* /////////////////////////////
        STYLING SECTION
//////////////////////////////*/
function styleFooter() {
  if (Array.isArray(partnerCIBI) && partnerCIBI.length >= 1) {
    $('.footer__cibi').css( "justify-content", "space-between" );
    $('.footer__copyrights').css( "align-items", "stretch" );
    $('.footer__copyrights').css( "justify-content", "flex-start");
  }
  else {
    $('.footer__cibi-local').css({"justify-content": "center", "text-align": "center"});
    $('.footer__copyrights').css({"align-content": "center", "text-align": "center"});
    $('.footer__copyrights > ul').css( "justify-content", "center");
  }
  if($('.wrapper__footer').data('themecustom') != null ) {
    var bgColor = $('.wrapper__footer').data('bgcolor');
    var copyColor = $('.wrapper__footer').data('copycolor');
    var linkColor = $('.wrapper__footer').data('linkcolor');
    $('.wrapper__footer').css( "background-color", bgColor );
    $('.footer__copyrights p').css( "color", copyColor );
    $('.footer__copyrights a').css( "color", linkColor );
  }
  else {
    if($('.wrapper__footer').data('themedark') != null ) {
      $('.wrapper__footer').css( "background-color", "#222222" );
      $('.footer__copyrights a').css( "color", "#FFFFFF");
      $('.footer__sns').css( "border-color", "#444444");
    }
    else {
      $('.wrapper__footer').css( "background-color", "#EFEFEF" );
      $('.footer__copyrights a').css( "color", "#000000");
      $('.footer__sns').css( "border-color", "#DDDDDD");
    }
  }
  $('.footer__copyrights li:first-child a').css( "color", '#f37820' );
}


//Initialize Color Mode for Footer Logos
function footerThemeInit() {
  if ($("html").attr("data-theme") == "light") {
    footerLogos('black');
  } else if ($("html").attr("data-theme") == "dark") {
    footerLogos('white');
  }
}

