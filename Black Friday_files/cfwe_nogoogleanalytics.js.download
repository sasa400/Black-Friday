//Functions in this section are for controlling the dark mode toggle option.
// modified to use local storage for mode persistence
// Dark Mode Controller.
function darkModeOn(initialMode) {

  initialMode = (typeof initialMode !== 'undefined' && ('dark' === initialMode || 'light' === initialMode)) ? initialMode : null;
  
  switch (initialMode)
  {
    case 'dark':{
      makeDarkMode();
    }break;
    case 'light':{
      makeLightMode();
    }break;
    
    default:{

      var mode = window.localStorage.getItem('sgw_darkmode');
      if(null !== mode)
      { 
        // a mode has been set - use it
        // but it is basically the opposite of what is actually set

        switch(mode)
        {
          case 'dark':{
            makeLightMode();
          }break;
          case 'light':{
            makeDarkMode();
          }break;
        }
      }else{
        // no mode has been set
        // so toggle between states
      
          if ($("html").attr("data-theme") == "dark") {
          makeLightMode();  
          } else {
          makeDarkMode();
          }
      }
    }break;
  }
  
  function makeDarkMode(){
    window.localStorage.setItem('sgw_darkmode', "dark");
    $("html").attr("data-theme","dark");
    footerLogos('white');
  }   

  function makeLightMode(){
    window.localStorage.setItem('sgw_darkmode', "light");
    $("html").attr("data-theme","light");
    footerLogos('black'); 
  }   
}

function footerLogos(newColor) {
  let oldColor;
  if(newColor == 'white') {
    oldColor = "black";
  } else if(newColor == 'black') {
    oldColor = "white";
  }
  // Swap CIBI logos
  $(".footer__cibi-local").find("img").each(function(){
    let cibiUrlSrc = $(this).attr('src');
    cibiUrlSrc = cibiUrlSrc.replace(oldColor, newColor);
    $(this).attr("src", cibiUrlSrc);
  });
  // Swap SNS logos
  let snsUrlSrc = $(".footer__sociallink").attr('style');
  snsUrlSrc = snsUrlSrc.replace(oldColor, newColor);
  $(".footer__sociallink").attr('style', snsUrlSrc);
}
