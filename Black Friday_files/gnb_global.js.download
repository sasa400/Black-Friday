    $(document.body).on('mouseenter', '#gnm_menu_getzp', function() {
      var ZPBalanceElement = $(this).find(".addzp.menu-item-balance"); 

      if ($(ZPBalanceElement).hasClass('zp-requested')) 
        return true;  //nothing to do because ajax for zp has been called

      //otherwise, call ajax for zp amount
      $(ZPBalanceElement).addClass('zp-requested');
      $.ajax({
        dataType: "jsonp",
        url: "https://www.z8games.com/loging/restAPI/account.php?request=getzpbalance", 
        success: function(result) {
          ZPBalanceElement.html(formatWithCommas(result.ZPBalance) + " ZP");
        }
      });
    });
    

    function closeGNBNotice() {
    if ($('#sgw_gnb_noticediv:hidden').length === 1) 
      return false;

    $('#sgw_gnb_noticediv').hide();
    adjustPageForGNB();   
  }

  
