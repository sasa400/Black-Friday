        $("#sgw_gnb_div").removeClass("lightboxmode");
        $(".gnm_dropdown_block").hide();
            $(".gnm_dropdown").removeClass('open');
      }
    });


    $(document.body).on('click', '.gnm_menu_button' ,function(){
      if(window.innerWidth < breakPoint){
        $(".gnm_dropdown").removeClass('open');
            $(this).parent().addClass('open');
            $(".gnm_dropdown_block").hide();
            $(this).next().slideDown();
        }
      });


   $(document.body).on('mouseenter', '.gnm_dropdown', function() {
    if(window.innerWidth > breakPoint){
      if(isIE){ 
        $(".gnm_dropdown_block").hide();
            $(this).children('.gnm_dropdown_block').show();
      }else{
        $(".gnm_dropdown_block").hide();
            $(this).children('.gnm_dropdown_block').slideDown();
      }       
    }     
  });

    $(document.body).on('mouseleave', '.gnm_dropdown', function() {
        if(window.innerWidth > breakPoint){
            $(".gnm_dropdown_block").hide();
      }
    });
   
    
