				var imgData = item.IMG_URL_LIST.split('|');

				let carouselString = imgsString;

				for(let i=0; i<imgData.length; i++){

					var imgParts = imgData[i].split('::::');
					var imgRarityNum = ((parseInt(imgParts[1],10)-1) >= 0) ? (parseInt(imgParts[1],10)-1) : null;
					var imgRarityString = (imgRarityNum) ? '<img src="' + rarity_root_folder + 'rarity-' + (imgParts[1]-1) + '.webp" alt="" class="card_rarity"></img>' : '';

					if('' !== imgRarityString){
						carouselString += '<div class="card_image"><div><img loading="lazy" src="' + imgParts[0] + '" alt="' + item.IMAGE_NAME + '">' + imgRarityString + '</div></div>';
					}else{
						carouselString += '<div class="card_image"><div><img loading="lazy" src="' + imgParts[0] + '" alt="' + item.IMAGE_NAME + '"></div></div>';
					}
				}

				imgsString = '<div class="card_image"><div class="glider">' + carouselString + '</div><button aria-label="<-" class="glider-prev icon cfshop-icon-left-small"></button><button aria-label="->" class="glider-next icon cfshop-icon-right-small"></button></div>';

			}else{

			}

			try{
				currency = (item.CURRENCY) ? item.CURRENCY : defaultCurrency;
			}catch(e){}

			priceDiv =  $('#' + ITEM_ID + ' > .card_ui').clone();
			priceDiv.find('button').remove();

			if(item.ITEM_ICON){
				iconTypeString = '<div class="card_tag icon cfshop-icon-' + item.ITEM_ICON + 'item"></div>';
			}

			if('CFSHOP' !== mi.options.shop_type){
				if(item.IS_VVIP){
					iconTypeString = '<div class="card_tag icon cfshop-icon-vipitem"></div>';

					if((typeof item.EXISTS_CNT !== 'undefined') && parseInt(item.EXISTS_CNT,10) >= 0){
						//possesionString = '  <div class="details_counter icon owned_' + item.ITEM_ID + '">' + weapon_own_pt1_text + '&nbsp;<span>' + item.EXISTS_CNT + '</span>&nbsp;' + weapon_own_pt2_text + '</div>';
					}
				}else{
					disclaimerString = $('#' + ITEM_ID + ' > .card_disclaimer > ul').clone().html();
					//possesionString = '<div class="details_counter owned_' + item.ITEM_ID + '">' + ownedText + ':&nbsp;<span>' + item.EXISTS_CNT + '</span></div>';
				}
			}else{
				disclaimerString = $('#' + ITEM_ID + ' > .card_disclaimer > ul').clone().html();
			}

			try{
				if('CRATE' == item.CART_TYPE){
					//possesionString = '<div class="details_counter owned_' + item.ITEM_ID + '" style="display:none;"></div>';
				}
			}catch(e){}

			extendedDescription = (item.SHORT_DESCRIPTION) ? '<span class="card_label_sub">&nbsp;&mdash;&nbsp;' + item.SHORT_DESCRIPTION + '</span>' : '';
			regularDescription = (item.DESCRIPTION) ? item.DESCRIPTION : '';

			let line_Arr = [

				'<div class="card">'
				,	imgsString
				, 	iconTypeString
				,'	<div class="card_label">'
                ,'		<p class="card_label_main">' + ((item.ITEM_NAME) ? item.ITEM_NAME : item.ITEM_NAME) + extendedDescription  + '</p>'
              	,	'</div>'

				,'	<div class="details_text">'
				,'		<p>' + regularDescription + '</p>'
              	,	'</div>'

				,'	<div class="card_disclaimer">'
				,			disclaimerString
              	,	'</div>'

				//,	possesionString

				,'	<div class="card_ui">'
				,		priceDiv.html()
              	,	'</div>'

				,'	<div class="modal_ui">'
				,'		<button class="close_button"><span>' + close_text + '</span></button>'
				,'		<button class="card_button sc-add-to-cart" data-item_id="' + ITEM_ID + '" data-ITEM_ID="' + ITEM_ID + '"><span data-item_id="' + ITEM_ID + '" data-ITEM_ID="' + ITEM_ID + '">' + add_to_cart_text + '</span></button>'
				,'	</div>'
			  	,'</div>'

			];

			var showCollectionID = parseInt(item.COLLECTIONID, 10);

			if(item.COLLECTIONID){

				mi._getCollectionInfo(showCollectionID, item.IMG_URL, item.ITEM_NAME);
			}

			let lines = line_Arr.join('');

			$('.item_details').append(lines);
			loadModal('#details_modal', 'top');
			//showModal(animationDirection);

			if(item.SHOW_COUNTDOWN && item.TIME_REMAINING_SECONDS){
				initializeClock();
			}

		},

		_renderShopItems(items){

			var mi = this;
			let currentCategoryName = ''

			//var discount = mi._discountLevelAmount();

			//for (let i = 0; i < (result.dsWebshopSaleItemResult).length; i++) {
			$.each(items, function(i, item) {
				//let item = result.dsWebshopSaleItemResult[i];

				//addToConsole(item);

				item.ITEM_ID = parseInt(item.ITEM_ID,10);
				// set defaults
				item.QUANTITY = 1;
				item.QUANTITYSELECT = 0;

				currentCategoryName = (item.ITEM_CATEGORY).toLowerCase().replace(/[^a-zA-Z0-9]/g,'');

				if((-1 !== currentCategoryName.indexOf('package') || -1 !== currentCategoryName.indexOf('limit'))){

					// add to no discount List
					if(-1 !== (mi.options.itemsNotDiscountedList.indexOf(item.ITEM_ID))){

						addToConsole('mi.options.itemsNotDiscountedList');
						addToConsole(mi.options.itemsNotDiscountedList);

						mi._logMessage('_updateProductDiscount: skipping item: ' + item.ITEM_ID);

						// we have to set discount price for this cart to work
						item.DISCOUNTPRICE = item.ORIGINAL_PRICE;
						item.PRICE = item.DISCOUNTPRICE;		// and the cart uses PRICE for calculation

					}


				}else{
					// we know this for a fact
					if(item.ORIGINAL_PRICE && mi.options.discount){
						var newPrice = item.ORIGINAL_PRICE - (item.ORIGINAL_PRICE * (mi.options.discount/100) );
						item.DISCOUNTPRICE = Math.floor(newPrice).toFixed(0); // round down
						item.PRICE = item.DISCOUNTPRICE;

					}else{
						if(item.PRICE){
							item.DISCOUNTPRICE = item.PRICE;
						}
					}
				}


				// required for checking conditions and restrictions
				item.EXISTS_CNT = 0;
				item = mi._setDefaultItemProperties(item);
				mi._createDOMBFSaleProducts(item.ITEM_ID,mi.options._saleProducts[item.ITEM_ID]);

			});

			//mi._discountLevelAmount();
			mi._triggerEvent("showShopPurchasePage");
		},
		/**
	    *
		*  This function requires that the CATEGORY field is a full string because it is used as the title of the section
		*  We create an anchor with the CATEGORY by removing all spaces and converting it to lowercase
		*
		* 1. Generate the Menu from the categories (item.ITEM_CATEGORY) [if necessary]
		* 2. Generate the section from the categories (item.ITEM_CATEGORY) [if necessary]
		* 3. Add the items to the section generated in part 2 above
		*
		// */

		_createDOMBFSaleProducts: function (id, item){

            var mi = this;
			let categories = [];
			let categoriesContent = [];
			let currentCategoryName = '';
			let currentSubCategoryName = null;
			let priceDiv = '';
			let defaultCurrency = 'ZP';
			let currency = defaultCurrency;
			let currentCategoryAnchorName, previousCategoryAnchorName = '';
			let itemDOMStringArray = [];
			let itemDOMString = '';
			let categoryDOMMenuString = '';
			let categoryDOMSectionString = '';
            let iconType = '';
			let iconTypeString = '';
			let extendedDescription = '';
			let disclaimerString = '';
			let discountString = '';
			let possesionString = '';

			let limitedPackageItem = false;

			let regularDescription = '';

			let imgDimensions = 'width="540" height="400"';

			let trailFlag = false;

			let showSubcategories = true;

			try{

				//extendedDescription =(item.hasOwnProperty('DESCRIPTION')) ? '<span class="card_label_sub">&nbsp;&mdash;&nbsp;' + item.DESCRIPTION + '</span>' : '';
				extendedDescription = (item.SHORT_DESCRIPTION) ? '<span class="card_label_sub">&nbsp;&mdash;&nbsp;' + item.SHORT_DESCRIPTION + '</span>' : '';
			}catch(e){
				addToConsole(item);
				addToConsole(e);
				extendedDescription = '';
			}

			try{

	            currentCategoryName = (item.ITEM_CATEGORY).replace(/_YEAR_/g,' ' + mi.options.yearDate);
				currentCategoryAnchorName = (item.ITEM_CATEGORY).toLowerCase().replace(/[^a-zA-Z0-9]/g,'');
			}catch(e){
				addToConsole(item);
				currentCategoryName = 'not found';
			}

            /**
             *
             * Create the menu and sections
             *
             */

            // check if category exists
            if(previousCategoryAnchorName !== currentCategoryAnchorName){

                previousCategoryAnchorName = currentCategoryAnchorName;

                // check if element has been created or not
                if(!($('#' + currentCategoryAnchorName).length)){

                    addToConsole(currentCategoryAnchorName + ' does not exist');

					if(-1 !== currentCategoryAnchorName.indexOf('package') || -1 !== currentCategoryAnchorName.indexOf('limit')){

						//categoryDOMSectionString = '<section class="breakout zone"><div class="limited-package"><div id="'+currentCategoryAnchorName+'" class="limited-package-heading"><h3>Limited Package</h3></div></section>';
						categoryDOMSectionString = '<section id="'+currentCategoryAnchorName+'" class="sgwz8_shop"></section>';

					}else{

						categoryDOMMenuString = '<a href="#'+currentCategoryAnchorName+'" role="menuitem"><button class="nav_button ' + currentCategoryAnchorName + '">'+currentCategoryName+'</button></a>';
						categoryDOMSectionString = '<section id="'+currentCategoryAnchorName+'" class="fixed column-grid col-5 cards sgwz8_shop"><h2>'+currentCategoryName+'</h2></section>';

						// add menus
						$("#categoriesDropdown").append(categoryDOMMenuString);
					}

                    // add sections
                    //$(".container-grid > .nav_wrapper.nav_sub").append(categoryDOMSectionString);

					//$(".fixed column-grid").append(categoryDOMSectionString);

					$("#tiers").before(categoryDOMSectionString);

                }
            }

			// check sub category
			if(item.hasOwnProperty('ITEM_SUBCATEGORY') && '' !== item.ITEM_SUBCATEGORY && null !== item.ITEM_SUBCATEGORY){
				currentSubCategoryName = currentCategoryAnchorName + '_' + (item.ITEM_SUBCATEGORY).toLowerCase().replace(/[^a-zA-Z0-9]/g,'');
				//currentCategoryAnchorName = currentSubCategoryName;
			}else{
				currentSubCategoryName = null;
			}

			if(currentSubCategoryName){

				if(showSubcategories){

					if(!($('#' + currentSubCategoryName).length)){
						categoryDOMSectionString = '<section id="'+currentSubCategoryName+'" class="fixed column-grid col-5 cards sgwz8_shop"></section>';

						categoryDOMMenuString = '<a href="#'+currentSubCategoryName+'" role="menuitem"><button class="nav_button">'+item.ITEM_SUBCATEGORY+'</button></a>';

						$("#categoriesDropdown").append(categoryDOMMenuString);
						$('#' + previousCategoryAnchorName).removeClass('cards').removeClass('col-5').removeClass('column-grid');
						$('#' + previousCategoryAnchorName).append(categoryDOMSectionString);
					}

					currentCategoryAnchorName = currentSubCategoryName;
				}else{

					if(!($('.nav_button:contains("'+item.ITEM_SUBCATEGORY+'")').length)){
						categoryDOMMenuString = '<a href="#'+item.ITEM_ID+'" role="menuitem"><button class="nav_button">'+item.ITEM_SUBCATEGORY+'</button></a>';
						$("#categoriesDropdown").append(categoryDOMMenuString);
					}
				}
			}
            /*
            //	Create the DOM string
            //
            // */

            try{
                currency = (item.CURRENCY) ? item.CURRENCY : defaultCurrency;
            }catch(e){addToConsole(e)}

			priceDiv = mi._createPriceDivElements(item);

			if(item.DISCLAIMER){
				disclaimerString = '<li>' + (item.DISCLAIMER).replace(/(?:\r\n|\r|\n)/g, '</li><li>') + '</li>';
			}

			if(item.IS_VVIP){
				iconTypeString = '<div class="card_tag icon cfshop-icon-vipitem"></div>';
			}

			if(-1 !== currentCategoryAnchorName.indexOf('package') || -1 !== currentCategoryAnchorName.indexOf('limit')){

				trailFlag = true;
				limitedPackageItem = true;

				if(limitedPackageItem || trailFlag || (item.SHOW_COUNTDOWN && item.TIME_REMAINING_SECONDS)){
				//if(item.SHOW_COUNTDOWN && item.TIME_REMAINING_SECONDS){
					let myEndDate = item.END_DATE;
					disclaimerString += '<li><div class="timer" data-date="' + myEndDate + '" data-range="dhms" data-servertime="'+ item.SERVER_TIME +'" aria-label="Countdown Timer"></div></li>';
				}

				mi.options.itemsNotDiscountedList.push(item.ITEM_ID);
				addToConsole('adding ' + item.ITEM_ID + ' to mi.options.itemsNotDiscountedList)')

				itemDOMStringArray = [
					'<section class="breakout zone sgwz8_shop" data-unique-key="'+ item.ITEM_ID +'" id="'+ item.ITEM_ID +'">'
					,' <div class="limited-package">'
						,'<div class="limited-package-heading"><h3>'+ currentCategoryName +'</h3></div>'
					,'    <figure class="card_image">'
					,'        <img ' + imgDimensions + ' loading="lazy" src="'+ item.IMG_URL + '" alt="' + item.ITEM_NAME + '" onerror="this.onerror=null; this.src=\'https://z8games.akamaized.net/cfna/templates/assets/imgs/webshop/cfshop-missing-item-image.webp\'">'
					,'    </figure>'
					//,'    <div class="card_ui">'
					//,       discountString
					,       priceDiv
					//,'        <button class="card_button button-add sc-add-to-cart" data-id="'+ id +'" data-ITEM_ID="'+ id +'"><span>' + add_to_cart_text + '</span></button>'
					//,'    </div>'
					,'    <div class="card_label">'
					,'        <p class="card_label_main">' + item.ITEM_NAME + extendedDescription + '</p>'
					,'        <button data-ITEM_ID=' + item.ITEM_ID + ' class="card_info icon cfshop-icon-info" data-popup="details_modal" data-animation="top" aria-haspopup="true" aria-label="' + learn_more_text + '"></button>'
					,'    </div>'
					,'    <div class="card_disclaimer">'
					,'		<ul>'
					,			disclaimerString
					,'		</ul>'
					,'    </div>'
					,' </div>'
					,'</section>'
				];

			}else{
				itemDOMStringArray = [
					'<div class="card sc-product-item" data-unique-key="'+ item.ITEM_ID +'" id="'+ item.ITEM_ID +'">'
					,'    <figure class="card_image">'
					,'        <img ' + imgDimensions + ' loading="lazy" src="'+ item.IMG_URL + '" alt="' + item.ITEM_NAME + '" onerror="this.onerror=null; this.src=\'https://z8games.akamaized.net/cfna/templates/assets/imgs/webshop/cfshop-missing-item-image.webp\'">'
					,'    </figure>'
					,	  iconTypeString
					//,'    <div class="card_ui">'
					//,       discountString
					,       priceDiv
					//,'        <button class="card_button button-add sc-add-to-cart" data-id="'+ id +'" data-ITEM_ID="'+ id +'"><span>' + add_to_cart_text + '</span></button>'
					//,'    </div>'
					,'    <div class="card_label">'
					,'        <p class="card_label_main">' + item.ITEM_NAME + extendedDescription + '</p>'
					,'        <button data-ITEM_ID=' + item.ITEM_ID + ' class="card_info icon cfshop-icon-info" data-popup="details_modal" data-animation="top" aria-haspopup="true" aria-label="' + learn_more_text + '"></button>'
					,'    </div>'
					,'    <div class="card_disclaimer">'
					,'		<ul>'
					,			disclaimerString
					,'		</ul>'
					,'    </div>'
					,'</div>'
				];
			}

            itemDOMString = itemDOMStringArray.join('');

			//addToConsole(itemDOMString);

			// add the item to the DOM
			if(trailFlag){
				$('#' + currentCategoryAnchorName).before(itemDOMString);
			}else{
				$('#' + currentCategoryAnchorName).append(itemDOMString);
			}

			if(limitedPackageItem || trailFlag || (item.SHOW_COUNTDOWN && item.TIME_REMAINING_SECONDS)){
			//if(item.SHOW_COUNTDOWN && item.TIME_REMAINING_SECONDS){
				initializeClock();

				//alert('Register this: ' + item.ITEM_NAME + ' with ' + item.TIME_REMAINING_SECONDS + ' seconds remaining.')
				mi._registerTimeLimitedItem(item.ITEM_ID, item.TIME_REMAINING_SECONDS);
			}
		},

		/**
		 * This function adds some additional properties for restrictions checking
		 * It uses existing properties, and any sale specific rules to modify it's properties
		 *
		 * We need this to verify that we can perform all checks on an item before/during cart updating
		 * This function also makes sure that it is in the local internal array of all sale items
		 *
		 * @param {obj} item
		 */
		_setDefaultItemProperties: function (item){

			var mi = this;

			item.unique_key = item.ITEM_ID;

			item.DISCOUNTPRICE = item.PRICE;	// redundancy for old code

			if(!item.ORIGINAL_PRICE || !item.hasOwnProperty('ORIGINAL_PRICE')){
				addToConsole('manually adding original price of ' + item.PRICE + item.CURRENCY + ' for: ' + item.ITEM_NAME + ' ' + item.ITEM_NAME)
				item.ORIGINAL_PRICE = item.PRICE;
			}

			// default max limits

			// somehow LIMIT_PER_USER is sent as  null
			if(null == item.LIMIT_PER_USER && null != item.RESTRICTIONS){
				item.LIMIT_PER_USER = item.RESTRICTIONS;
			}

			// removed so that IS_VVIP is a tag only
			/*
			if(!item.LIMIT_PER_USER && item.IS_VVIP){
				item.LIMIT_PER_USER = maxVIPLimit; // max 14 VIPs
			}

			if(!item.RESTRICTIONS && item.IS_VVIP){
				item.RESTRICTIONS = maxVIPLimit; // max 14 VIPs
			}
			// */

			// Double check if this user has item in inventory

			if(mi.options.userInventory && mi.options.userInventory[item.ITEM_ID]){

				addToConsole('user has item in previous inventory: ' + item.ITEM_ID)

				var userItem = mi.options.userInventory[item.ITEM_ID];

				if(item.LIMIT_PER_USER && userItem.EXISTS_CNT){
					item.LIMIT_PER_USER = item.LIMIT_PER_USER - userItem.EXISTS_CNT;
				}
			}

			// use a property to capture status
			item.LOCKED = 0;

			// as a default, just lock the item if it has a condition; it should be unlocked when we get the user's inventory
			if(item.CONDITION && (null !== item.CONDITION || '' !== item.CONDITION)){
				item.LOCKED = 1;
				mi._lockITEM_ID(item.ITEM_ID);
			}

			// required for checking conditions and restrictions
			//item.EXISTS_CNT = 0;

			mi.options._saleProducts[item.ITEM_ID] = item;

			return item;
		},


        /*
         * Get the parameters of a product by seaching elements with name attribute/data.
         * Product details will be return as an object
         *
         *
         * I need to get it from my own object instead (which is _saleProducts)
         * But a COPY, not the original object.
         *
         */
        _getProductDetails: function (elm) {
            var mi = this;
            var p = {};

			addToConsole(elm);
			addToConsole(elm.data('item_id'));
			addToConsole(elm.data('id'));

            //p = _saleProducts[elm.data('ITEM_ID')];
            p = mi.options._saleProducts[elm.data('item_id')];

            // I don't want the actual object

            // works everywhere else except IE
            //var newP = Object.assign({}, p);

            // for IE cause they're special
            var newP = $.extend({}, p);

            return newP;
        },

		/**

		// can only purchase max 14 items at a time (7 vips, 7 skins/fx/dolls)
		// based on _getCartAllItemsCount
		*/
		_cartMaxLimitReached: function(cartType, ITEM_ID){

			var mi = this;

			addToConsole('_cartMaxLimitReached checking max limit of ' + cartType)

			if('Doll' == cartType || 'Mascote' == cartType || 'DOLL' == cartType || 'MASCOTE' == cartType ){
				cartType = 'SKIN';
			}

			const cartMaxCount = ('pt' == document.documentElement.lang) ? (maxSkins * maxVIPLimit) + (maxItems * maxVIPLimit) + (maxCrates * maxVIPLimit) : maxSkins + maxItems;
            const cartTypeLimit = maxVIPLimit;

			addToConsole('_cartMaxLimitReached check max limit cartMaxCount: ' + cartMaxCount)
			addToConsole('_cartMaxLimitReached check max limit cartTypeLimit: ' + cartTypeLimit)

			var title = general_error_title;
			var message = maxCart_error_message;
			var actionVerb = "cancel";
			var actionText = continueShoppingActionText;

			var cartCount = 0;
			var skinsCount = 0;
			var itemsCount = 0;
			var cratesCount = 0;

			var lastItemID = null;

			var retVal = false;

			// get TYPE counts (unique for BR, total for WE)
			skinsCount = mi._countofTypeInCart('SKIN');
			cratesCount = mi._countofTypeInCart('CRATE');
			itemsCount = mi._countofTypeInCart('ITEM');

			addToConsole(' - _cartMaxLimitReached check - skinsCount: ' + skinsCount);
			addToConsole(' - _cartMaxLimitReached check - cratesCount: ' + cratesCount);
			addToConsole(' - _cartMaxLimitReached check - cratesCount: ' + cratesCount);

			if('pt' == document.documentElement.lang){
				// additional check if ITEM_ID already in cart
				let itemIDCartCount = mi._countofITEM_IDInCart(ITEM_ID);

				// the user is adding a unique item ID so we should add to the count
				if(!itemIDCartCount){

					if(cartType == 'SKIN'){skinsCount++; }
					if(cartType == 'CRATE'){cratesCount++; }
					if(cartType == 'ITEM'){itemsCount++; }
				}
			}

			if((skinsCount > maxSkins) || (cratesCount > maxCrates) || (itemsCount > maxItems)){

				addToConsole(' - _cartMaxLimitReached - player  reached max');

				// since this function works on the cart and NOT the last processed item, we might need to use the last itemID in an error message
				if(null !== mi.options.lastProccessedItemID && mi.options.show_cart){
					//addToConsole('show cart is ' + mi.options.show_cart + ' and lastProccessedItemID is ' + mi.options.lastProccessedItemID)
					lastItemID = mi.options.lastProccessedItemID;
				}

				mi._popUpGeneralMessage(title, message, actionVerb, actionText, lastItemID);
				retVal = true;
				return retVal;
			}

			if(cartCount >= cartMaxCount){

				addToConsole(' - _cartMaxLimitReached - player  reached max cart items');

				// since this function works on the cart and NOT the last processed item, we might need to use the last itemID in an error message
				if(null !== mi.options.lastProccessedItemID && mi.options.show_cart){
					//addToConsole('show cart is ' + mi.options.show_cart + ' and lastProccessedItemID is ' + mi.options.lastProccessedItemID)
					lastItemID = mi.options.lastProccessedItemID;
				}

				mi._popUpGeneralMessage(title, message, actionVerb, actionText, lastItemID);
				retVal = true;
				return retVal;
			}

			return retVal;

		},
		_checkItemConditions: function (p) {

			var mi = this;

			let statusCheckPass = true;

			addToConsole(' - _checkItemConditions - sanity check' + p.ITEM_ID);

			if(p.hasOwnProperty('LIMIT_PER_USER') && p.LIMIT_PER_USER && p.LIMIT_PER_USER !== -1){

				// this restriction condition test is probably done elsewhere since the quantity is part of the function
				//

				let userCartItemCount = mi._countofITEM_IDInCart(p.ITEM_ID);

				if(userCartItemCount > p.LIMIT_PER_USER){
					// check the cart count and the users's inventory
					addToConsole('you should not pass, check the cart count and the inventory');

					var title = general_error_title;
					var message = max_reached_message; //webshop_item_max_reached;
					var actionVerb = "cancel";
					var actionText = continueShoppingActionText;

					mi._popUpGeneralMessage(title, message, actionVerb, actionText, p.ITEM_ID);

					addToConsole('-- _checkItemConditions: adding temp true')
					statusCheckPass = false;
					return false;
				}
			}
			return statusCheckPass; // && otherStatus
		},

		/**
		 * Preload the cart without checking anything
		 * @param {obj} p
		 * @returns
		 */
		_preloadToCart: function (p) {
            var mi = this;

            p.unique_key = p.ITEM_ID;

            if (mi.options.combineProducts) {
                var pf = $.grep(mi.cart, function (n, i) {
                    return mi._isObjectsEqual(n, p);
                });

                if (pf.length > 0) {

                    var idx = mi.cart.indexOf(pf[0]);

                    var newQty = (mi.cart[idx]['QUANTITY'] - 0) + (p.QUANTITY - 0);

					if(newQty){
						mi.cart[idx]['QUANTITY'] = newQty;
						p = mi.cart[idx];
					}
                } else {
					if((p.QUANTITY - 0)){
						mi.cart.push(p);
					}
                }
            } else {
				if((p.QUANTITY - 0)){
					mi.cart.push(p);
				}
            }

			if((p.QUANTITY - 0)){
				// _addUpdateCartItem(p) does hasCartChange()
				mi._addUpdateCartItem(p);

				// update to show selected
				//$('#' + p.unique_key).find('a').addClass('button-selected').removeClass('button-add');
			}
			return p;
		},

        /*
         * Add the product object to the cart
         */
        _addToCart: function (p, quantity = 1) {
            var mi = this;
            var restrictionTestPass = false;

			quantity = (parseInt(quantity) > 0) ? parseInt(quantity) : 1;

			// disable price checking for CFShop

			if('CFSHOP' !== mi.options.shop_type){
				addToConsole('_addToCart');
				addToConsole(p);
				//addToConsole(p.hasOwnProperty('PRICE'));
				if (!p.hasOwnProperty('PRICE')) {
					mi._logError(' - _addToCart - Price is not set for the item');
					addToConsole(' - _addToCart - DISCOUNTPRICE is not set for the item : ' + p.ITEM_ID);
					return false;
				}
			}

            if (!p.hasOwnProperty(mi.options.paramSettings.productQuantity)) {
                mi._logMessage(' - _addToCart - Quantity not found, default to 1');
				addToConsole(' - _addToCart - Quantity not found, default to 1 for item : ' + p.ITEM_ID);
                p[mi.options.paramSettings.productQuantity] = 1;
            }

            p.unique_key = p.ITEM_ID;

            if (mi.options.combineProducts) {
                var pf = $.grep(mi.cart, function (n, i) {
                    return mi._isObjectsEqual(n, p);
                });

				// combined products listing

                if (pf.length > 0) {

                    var idx = mi.cart.indexOf(pf[0]);

                    var newQty = (mi.cart[idx][mi.options.paramSettings.productQuantity] - 0) + quantity;

                    restrictionTestPass = mi._checkRestrictions(p, newQty);

                    addToConsole('QTY: ' + newQty + ' checking restrictions on pf.length > 0 : ' + restrictionTestPass);

                    if(restrictionTestPass){
						mi._triggerEvent("quantityUpdated", [p, newQty]);
                    }

                } else {

					restrictionTestPass = mi._checkRestrictions(p, 1);

                    addToConsole('checking restrictions on pf.length < 0 : ' + restrictionTestPass);

                    if(restrictionTestPass){
                        mi._triggerEvent("itemAdded", [p, 1]);
                    }
                }
            } else {

				// non-combined products listing

                restrictionTestPass = mi._checkRestrictions(p, p[mi.options.paramSettings.productQuantity]);

                addToConsole('checking restrictions on no combination of products which is not what we do here! : ' + restrictionTestPass);

                if(restrictionTestPass){
                    mi._triggerEvent("itemAdded", [p, 1]);
                }
            }

            addToConsole(mi.cart);

            if(restrictionTestPass){
                //mi._addUpdateCartItem(p);
                return p;
            }else{
				return false;
			}
        },
        /*
         * Remove the product object from the cart
         */
        _removeFromCart: function (unique_key) {
            var mi = this;
            $.each(mi.cart, function (i, n) {

				var currKey = parseInt(n.unique_key,10);
				var givenKey = parseInt(unique_key,10);

                if (currKey === givenKey) {
                    var itemRemove = mi.cart[i];

                    // remove restrictions
                    //itemRemove.LIMIT_PER_USER = itemRemove.LIMIT_PER_USER - itemRemove[mi.options.paramSettings.productQuantity];

                    mi._updateCartQuantity(itemRemove.unique_key, 0);

                    // Trigger "itemRemoved" event
                    mi._triggerEvent("itemRemoved", [itemRemove, 0]);

                    addToConsole('removing from cart: ' + unique_key);

                    mi.cart.splice(i, 1);
                    //$('*[data-product-unique-key="' + unique_key + '"]').removeClass('sc-added-item');
                    //mi._hasCartChange();

                    return false;
                }
            });

			// remove dom from cart
			$('#_cart_item_' + unique_key).remove();

            mi._hasCartChange();
        },
        /*
         * Clear all products from the cart
         */
        _clearCart: function () {
            //this.cart = [];
            var mi = this;

            $.each(mi.cart, function (i, n) {
                //individual check
                var itemRemove = mi.cart[i];

				mi._removeFromCart(itemRemove);

                // Trigger "itemRemoved" event
                mi._triggerEvent("itemRemoved", [itemRemove, 0]);
                //return true;
            })
            //empty cart
            mi.cart = [];

            // Trigger "cartCleared" event
            mi._triggerEvent("cartCleared");
            mi._hasCartChange();
        },
        /*
         * Update the quantity of an item in the cart
		 *  // only after it has been saved in the database
         */
        _updateCartQuantity: function (unique_key, qty) {

            addToConsole('_updateCartQuantity UPDATING : ' + unique_key + ' quantity: ' + qty);

            var mi = this;
            var qv = (qty === 0) ? true : mi._getValidateNumber(qty) ;

			var updateCartFlag = false;

            addToConsole('_updateCartQuantity is qty: ' + qty + ' a valid number? ' + qv);

            $.each(mi.cart, function (i, n) {

				updateCartFlag = false;

				var currKey = parseInt(n.unique_key, 10);
				var givenKey = parseInt(unique_key, 10);

				addToConsole('_updateCartQuantity checking cart[' + n + ']: ' + currKey + ' vs given: ' + givenKey);

                if (currKey === givenKey) {

					addToConsole('_updateCartQuantity previous key found ' + unique_key + ' at: ' + n);

                    if (qv) {

						var p = mi.options._saleProducts[unique_key];
						let  newPrice = (p.DISCOUNTPRICE) ? p.DISCOUNTPRICE : p.PRICE;
						let productAmount = addCommas(qty * (newPrice - 0));

						mi.cart[i][mi.options.paramSettings.productQuantity] = qty;

						// update the value in the box on the cart
						$('div[data-unique-key='+unique_key+']').find('.sc-cart-item-qty').val(qty);
						$('#_cart_item_' + unique_key).find('.sc-cart-item-qty').val(qty);

						$('#_cart_item_' + unique_key).find('.sc-cart-item-amount > p').text(productAmount + ' ' + p.CURRENCY);

                    }

                    return false;
                }else{
					addToConsole('_updateCartQuantity previous key NOT found ' + unique_key);
                }
            });
        },

		_getCartItembyID: function (ITEM_ID){

            var mi = this;
            addToConsole('_getCartItembyID start');

			let p = null;

            $.each(mi.cart, function (i, n) {
				var currKey = parseInt(n.unique_key, 10);
				var givenKey = parseInt(ITEM_ID, 10);

				addToConsole('_updateCartQuantity checking cart[' + n + ']: ' + currKey + ' vs given: ' + givenKey);

                if (currKey === givenKey) {
					p = mi.cart[i];
					return;
				}
			});

			addToConsole('_getCartItembyID end');
			return p;
		},
        /*
         * Update the UI of the cart list
		 * Update the subtotals and totals for known currencies
         */
        _addUpdateCartItem: function (p) {

            //var mi = this;

            //mi._hasCartChange();

            //addToConsole(this.cart)
        },
		// for updating the count on the item in the dom if we want
		_upDateDOMItemCount: function(item, count){
