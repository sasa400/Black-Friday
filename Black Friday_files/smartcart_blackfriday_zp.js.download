        /**
         * Get Discount Level based on ZP amount
         */
		 _discountLevelAmount: function(subtotal){

            var mi = this;
            var discount = 0;
			var result = [];
            subtotal = (subtotal - 0) ? subtotal : 0;
            var strings = [];

            //if(mi.options.toolbarSettings.showDiscountSummary){

				//var result = discountProgressBar(subtotal);

				if(mi.options.DiscountTiers){
					result = mi._updateDiscountProgress(mi.options.DiscountTiers, subtotal);
				}

				// update the progress bar with previously won rewardsWon

				if(mi.options.rewardWon && (typeof updateBonuses === "function")){
					updateBonuses(mi.options.rewardWon);
				}

				discount = (result && result[0]) ? result[0] : 0;
				mi.options.discount = discount;
				// check if coupon should be displayed
				//mi._displayCoupon();

				mi.options.SpendMoreForSavings = (result && result[1]) ? result[1] : 0;

				if(result && result[3]){
					// mystery Discount
					//addToConsole('mysteryDiscount', result[3])
				}

			//}else{
				//mi._logMessage('do not display discounts');
			//}

            return discount;
       },

        /**
         *
         * Update the discounted price on each product.
         *
         */
		 _updateProductDiscount: function(discount){

            var mi = this;

            var key;
			var price_elem; // = $('#' + item.ITEM_ID).find('.price_listed'); //.card_ui .price_listed
			var price_disc_elem;
			var modal_price_elem;
			var price_cart_elem;

			var keys = Object.keys(mi.options._saleProducts);
			var keysLength = keys.length;

			//$('.price_listed').hide();
			//$('.price_discount').hide();


			//for (var i = 0; i < keysLength; i++) {
			for (key in mi.options._saleProducts) {

                let item = mi.options._saleProducts[key];

				//let item = mi.options._saleProducts[keys[i]];

                //addToConsole('_updateProductDiscount: ' + item.ITEM_ID + ' (' + item.ITEM_NAME + ') ' + ' ORIGINAL_PRICE: ' + item.ORIGINAL_PRICE);

				//mi._logMessage('_updateProductDiscount: discount is: ' + discount);

				// find DOM elements
				price_elem = $('.price_listed_' + item.ITEM_ID);
				price_disc_elem  = $('.price_discount_' + item.ITEM_ID);

				// price cart element
				price_cart_elem = $('#_cart_item_' + item.ITEM_ID).find('.sc-cart-item-amount > p');

                // skip items that are not discounted

                if(-1 !== (mi.options.itemsNotDiscountedList.indexOf(item.ITEM_ID))){

					addToConsole('mi.options.itemsNotDiscountedList');
					addToConsole(mi.options.itemsNotDiscountedList);

                    mi._logMessage('_updateProductDiscount: skipping item: ' + item.ITEM_ID);

					// we have to set discount price for this cart to work
					item.DISCOUNTPRICE = item.ORIGINAL_PRICE;
					item.PRICE = item.DISCOUNTPRICE;		// and the cart uses PRICE for calculation

                }else{
					if(discount-0){

						//addToConsole('DISCOUNT: ' + discount + ' Percent Off: ' + (discount/100));

						var newPrice = item.ORIGINAL_PRICE - (item.ORIGINAL_PRICE * (discount/100) );

						item.DISCOUNTPRICE = Math.floor(newPrice).toFixed(0); // round down

						addToConsole(item.ITEM_ID + ' (' + item.ITEM_NAME + ') ' + ' new discount PRICE: ' + item.DISCOUNTPRICE);

						item.PRICE = item.DISCOUNTPRICE;

						price_elem.attr('data-original-price', addCommas(item.ORIGINAL_PRICE) + ' ' + item.CURRENCY);
						price_elem.text(addCommas(item.DISCOUNTPRICE) + ' ' + item.CURRENCY);

						price_disc_elem.text(discount + '%');
						//price_disc_elem.show();

						// update the modal price
						if(mi.options.currentModalITEM_ID && item.ITEM_ID == mi.options.currentModalITEM_ID){

							//var modal_price_elem = $('.item_details').find('.price_listed');
							modal_price_elem = $('.item_details > .card > .card_ui > .price_listed');

							modal_price_elem.text(addCommas(item.DISCOUNTPRICE) + ' ' + item.CURRENCY);
							price_elem.attr('data-original-price', addCommas(item.ORIGINAL_PRICE) + ' ' + item.CURRENCY);
						}

						// update the cart price
						if(price_cart_elem){

							addToConsole('we should update new discount price for ' + item.ITEM_ID)

							// get quantity
							let qty = $('#_cart_item_' + item.ITEM_ID).find('.sc-cart-item-qty').val();
							qty = parseInt(qty,10);

							if(qty > 0){

								addToConsole('updating new discount price on #price_cart_elem')

								let productAmount = addCommas(qty * (newPrice - 0));
								price_cart_elem.text(productAmount + ' ' + item.CURRENCY);
							}
						}

					}else{

						// we have to set discount price for this cart to work
						item.DISCOUNTPRICE = item.ORIGINAL_PRICE;
						item.PRICE = item.DISCOUNTPRICE;		// and the cart uses PRICE for calculation

					}
				}
            }
        },
		/*
		// get weapon collection info
		*/
		_getCollectionInfo: function(id, img, title){

			$.ajax({
				data: {term : 'collectionRanking', usn: '-1', collection_ID: id},
				//data: {term : 'collectionRanking', usn: '-1', collection_ID: 51},
				type: 'get',
				url: collectionURI,
				success: function(result) {

					//addToConsole(result)

					if(result.APIresult === "000" && result.Collection_Info && result.Collection_Info[0])
					{
						let target = '#details_modal > div.modal-wrap > div.item_details > div.card > div.card_ui';
						let collectionImgString, reward1String, reward2String = null;
						let expr = /\.jpg$|\.png$/;

						title = (result.Collection_Info[0].collection_Name) ? result.Collection_Info[0].collection_Name : '';
						let ncImg = (result.Collection_Info[0].nameCardImgURL) ? result.Collection_Info[0].nameCardImgURL : null;
						let collectionImg = (result.Collection_Info[0].collection_Image) ? result.Collection_Info[0].collection_Image : null;

						if("Item" == result.Collection_Info[0].reward_type && expr.test(result.Collection_Info[0].reward_image)){
							addToConsole('getCollectionInfo there is a reward item to display: ' + result.Collection_Info[0].reward_image)
							img = wCollBaseURL + result.Collection_Info[0].reward_image;
						}else{
							img = null;
						}

						collectionImgString = (collectionImg) ? '<img class="collection-icon" src="' + collectionImg  + '" alt="collection icon">' : null;
						reward1String = (img) ? '<img class="collection-icon" src="' + img  + '" alt="collection reward 1">' : null;
						reward2String = (ncImg) ? '<img class="collection-icon" src="' + ncImg  + '" alt="collection reward 2">' : null;

						let stringArr = [
									'<div class="details_collection">'
										,'<div class="collection-heading">'
											,'<div class="collection-title icon cfshop-icon-collection">' + title + '</div>'
											,'<div class="collection-owners">' + result.pagingInfo[0].totalCnt + '</div>'
										,'</div>'
										,'<div class="collection-content">'
											,collectionImgString
											,reward1String
											,reward2String
										,'</div>'
									,'</div>'
						];

						if(title){
							$(target).before(stringArr.join(''));
						}else{
							$(target).before('');
						}
					}
				},
				fail: function(result) {
					addToConsole('could not get collection info.');
				}
			});
		},
		_updateCheckoutModal: function (animationDirection = 'top'){
			let mi = this;

            var allGood = false;

            var string = '';

            var title = confirmPurchaseText;
            var balanceText1 = act_balance_text;
            var balanceText2 = rmdr_balance_text;
            var total_price = regtotal;
            var buttonMessageText = checkout;
            var cancelButtonText = cancelText;

            var curr_balance = mi.options.myBalance;

            var price = mi._getSubTotal();

			let cartList = [];

			let currenciesCount = 0;
			let errorsCount = 0;

			let ZPError = false;
			let EPError = false;


			$.each(mi.options.currencySettings.accepted, function (i, currency) {


				cartList.push(currency);
				cartList[currency] = [];
				cartList[currency].showError = false;

				let subTotal = mi._getSubTotalbyCurrency(currency);
				let cartCount = mi._getItemCountbyCurrency(currency);

				addToConsole('There are ' + cartCount + ' items totalling: ' + subTotal + currency);

				if(subTotal >= 0 && cartCount > 0){

					currenciesCount++;

					cartList[currency].subtotal = subTotal;
					cartList[currency].balance = mi.options['my' + currency + 'Balance'];
					cartList[currency].showError = false;
					cartList[currency].rmdr_balance = (cartList[currency].balance - cartList[currency].subtotal);

					cartList[currency].showError = (cartList[currency].rmdr_balance < 0) ? true : false;
				}
			});

			$.each(cartList, function (i, currency) {
				if(cartList[currency].showError){

					errorsCount++;

					if('ZP' == currency){
						ZPError = true;
					}

					if('EP' == currency){
						EPError = true;
					}

					addToConsole(cartList[currency] + ' error due to insufficient funds');
					//mi._showMessage({'result': 120, 'APImessage': insufficient_funds_messg});

					cartList[currency].errorMessage = insufficient_funds_messg;

				}
			});

			addToConsole('errorsCount: ' + errorsCount)
			addToConsole('currenciesCount: ' + currenciesCount)
			addToConsole('ZPError: ' + ZPError)
			addToConsole('EPError: ' + EPError)

			if(errorsCount && errorsCount == currenciesCount){

				// do not let this user do anything

				$('.confirmButton').attr('disabled', true);
				$('.confirmButton').removeClass('checkoutCart');

				// we have to show some kind of message
				mi._showMessage({'result': 120, 'APImessage': insufficient_funds_messg});

				loadModal('#modal_checkout', 'top');
			}

			if(errorsCount <= currenciesCount){

				if(errorsCount){
					// we have to show some kind of message
					mi._showMessage({'result': 120, 'APImessage': insufficient_funds_messg});
					//mi._showMessage({'result': 120, 'APImessage': webshop_msg_719});

				}

				if(ZPError){
					$('.confirmButton').addClass('gotodeposit').removeClass('checkoutCart');
					$('.confirmButton > span').text(insufficient_funds_action_text);
					$('.confirmButton').attr('disabled', false);
				}else{

					$('.confirmButton').addClass('checkoutCart').removeClass('gotodeposit');
					$('.confirmButton > span').text(checkout);
					$('.confirmButton').attr('disabled', false);

					// we will not let the user continue if EP is insufficient
					if(EPError){

						mi._showMessage({'result': 120, 'APImessage': webshop_msg_719});

						$('.confirmButton').addClass('gotodeposit').removeClass('checkoutCart');
						$('.confirmButton > span').text(webshop_msg_719);
						$('.confirmButton').attr('disabled', true);
					}
				}

				loadModal('#modal_checkout', 'top');
			}
		},
        /**
         *
         * @param {*} data
         * @param {*} ITEM_ID
         * @param {*} animationDirection
         */
		_createShopModal: function (data, ITEM_ID, animationDirection = 'top'){

			let mi = this;

