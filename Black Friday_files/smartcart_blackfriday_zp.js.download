				}
			}
		},

        /*
         * Calculates the cart discount and updates page based on number of items selected
         */
        _getCartDiscount: function () {

            //addToConsole('- checking discount -');


            var mi = this;

            var cartCount = mi.cart.length;
            var itemsCount = mi._getCartAllItemsCount();
            var subtotal = mi._getRegTotal(); //mi._getSubTotal();
            var subtotal_without_special_items = mi._getNoDiscountsRegTotal(); //mi._getSubTotal();
            var discount = 0;
            var newPrice = 0;
            var productAmount = 0;
            var cartList = $('.sc-cart-item-list', this.cart_element);
            var elmMain;

            try{
                if(!mi.options.flatDiscount){
                    //discount = mi._discountLevel(itemsCount);

					// updated for 2019 - nope I was wrong. Just use subtotal
                    //var discount = mi._discountLevelAmount(subtotal_without_special_items);

                    var discount = mi._discountLevelAmount(subtotal);

                    addToConsole('discount level: ' + discount);

                    mi._updateDiscountDom(discount);

                    if(discount){

                        // update the page items

						$('.price_discount').show();

						mi._updateProductDiscount(discount);

						// update the dom modal discount
						//$('item_details').find('price_discount').text(discount + '%');

                        //updateItemDetails(discount);

                        // update the shopping cart

                        var itemsCount = 0;
                        $.each(mi.cart, function (i, p) {

                            // skip special items

                            if(-1 !== (mi.options.itemsNotDiscountedList.indexOf(p.ITEM_ID))){
                                mi._logMessage('_getCartDiscount: skipping item: ' + p.ITEM_ID);

                            }else{

                                addToConsole('p.ITEM_ID: ' + p.ITEM_ID);
                                var quan = p[mi.options.paramSettings.productQuantity];
                                addToConsole('('+ quan +') * p.DISCOUNTPRICE: ' + p.DISCOUNTPRICE);
                                addToConsole('mi.options._saleProducts[p.ITEM_ID].DISCOUNTPRICE: ' + mi.options._saleProducts[p.ITEM_ID].DISCOUNTPRICE);
                                //p[mi.options.paramSettings.productPrice] = options._saleProducts[p.ITEM_ID].DISCOUNTPRICE;
                                p[mi.options.paramSettings.productPrice] = mi.options._saleProducts[p.ITEM_ID].DISCOUNTPRICE;

                                // get latest discount price
                                newPrice = mi.options._saleProducts[p.ITEM_ID].DISCOUNTPRICE;

                                productAmount = (p[mi.options.paramSettings.productQuantity] - 0) * (newPrice - 0);

                                //addToConsole('update the price for ' + p.ITEM_ID + ' since ' + p.DISCOUNTPRICE + ' = ' + options._saleProducts[p.ITEM_ID].DISCOUNTPRICE);
                                addToConsole('update the price for ' + p.ITEM_ID + ' since ' + p.DISCOUNTPRICE + ' = ' + mi.options._saleProducts[p.ITEM_ID].DISCOUNTPRICE);
                                // itemsCount += (p[mi.options.paramSettings.productQuantity] - 0);

                                // ajax call update player's invoice

                                if(!mi.options.preload_action){
                                    //saveInvoiceItem(p.ITEM_ID, productAmount, quan);
                                }
                            }
                        });
                    }
                }else{
					addToConsole('add flat discount to everything')
				}
            }catch(e){
                addToConsole(e.message);
            }

            return discount;
        },

        /*
         * Handles the changes in the cart
         */
        _hasCartChange: function () {

			var mi = this;

			addToConsole('_hasCartChange() called');

            // show subtotals

            if (mi.cart.length === 0) {
                //$('.sc-cart-item-list', this.cart_element).empty().append($('<div class="sc-cart-empty-msg">' + this.options.lang.cartEmpty + '</div>'));

                //$(this.options.productContainerSelector).removeClass('sc-added-item');
                $('.sc-cart-checkout, .sc-cart-clear').addClass('disabled');
				//$('.sc-cart-item-list').addClass('empty-item-list-flex');


                // Trigger "cartEmpty" event
                //mi._triggerEvent("cartEmpty");
				$(".emptycart").show();
            } else {

                $('.sc-cart-item-list > .sc-cart-empty-msg', mi.cart_element).remove();

                $('.sc-cart-checkout, .sc-cart-clear').removeClass('disabled');


				var myCartCount = mi._getCartAllItemsCount();

				$('#cartCount').text(myCartCount);

				$('.cartTotalCount').text(myCartCount);

				addToConsole('myCartCount: ' + myCartCount);

            }

			if('BLACKFRIDAY' === mi.options.shop_type){
				addToConsole('get cart discount on cart change')
				mi._getCartDiscount();
			}

            mi._refreshCartDisplayTotals();
        },
        /*
         * Gets the cart formatted subtotal
         */
        _getCartSubtotal: function () {
            var mi = this;
            var subtotal = mi._getSubTotal();
            return mi._getMoneyFormatted(subtotal);
        },
        /*
         * Calculates the cart sub price total
         */
        _getSubTotal: function () {
            var mi = this;
            var subtotal = 0;
            $.each(mi.cart, function (i, p) {

				// verify that this is a populated sales product
				//p = mi.options._saleProducts[p.ITEM_ID];

                if (mi._getValidateNumber(p.PRICE)) {
                    subtotal += (p.PRICE - 0) * (p[mi.options.paramSettings.productQuantity] - 0);
                }

            });
            return subtotal;
        },
        /*
         * Calculates the cart regular price total without items that don't get discounts
         * Since we calculate discount percentage based on the total original price of regular items ONLY
         */
        _getNoDiscountsRegTotal: function () {
            var mi = this;
            var fullprice = 0;
            $.each(mi.cart, function (i, p) {

				// verify that this is a populated sales product
				//p = mi.options._saleProducts[p.ITEM_ID];

                if(-1 !== (mi.options.itemsNotDiscountedList.indexOf(p.ITEM_ID))){
                    mi._logMessage('_getNoDiscountsRegTotal: skipping item: ' + p.ITEM_ID);

					// should the addition of the mysterybox be added to the full original price to allow the player to get higher discounts?
					// if so, then we do not need _getNoDiscountsRegTotal, we can just use _getRegTotal:
					//fullprice += (p['ORIGINAL_PRICE'] - 0);

                }else{
                    if (mi._getValidateNumber(p.DISCOUNTPRICE)) {
                        fullprice += (p['ORIGINAL_PRICE'] - 0) * (p[mi.options.paramSettings.productQuantity] - 0);
                    }
                }

            });
            return fullprice;
        },
        /*
         * Calculates the cart regular price total
         */
        _getRegTotal: function () {
            var mi = this;
            var fullprice = 0;
            $.each(mi.cart, function (i, p) {

				// verify that this is a populated sales product
				//p = mi.options._saleProducts[p.ITEM_ID];

                if (mi._getValidateNumber(p.DISCOUNTPRICE)) {

					//addToConsole('_getRegTotalbyCurrency -> fullprice: ' + (p['ORIGINAL_PRICE'] - 0) + ' * ' + (p[mi.options.paramSettings.productQuantity] - 0))

                    fullprice += (p['ORIGINAL_PRICE'] - 0) * (p[mi.options.paramSettings.productQuantity] - 0);
                }else{
					addToConsole('_getRegTotal could not verify price of ' + p.ITEM_ID);
				}
            });
            return fullprice;
        },
        /*
         * Calculates the cart regular price total for a particular currency
         */
        _getRegTotalbyCurrency: function (currency = 'ZP') {
            var mi = this;
            var fullprice = 0;
            $.each(mi.cart, function (i, p) {

				// verify that this is a populated sales product
				//p = mi.options._saleProducts[p.ITEM_ID];

                if (mi._getValidateNumber(p.ORIGINAL_PRICE)){ // && p.CURRENCY && p.CURRENCY === currency) { -- not necessary for  Boxing Week/ Black Friday
					let original_price = parseInt(p['ORIGINAL_PRICE'],10);

					//addToConsole('_getRegTotalbyCurrency -> fullprice: ' + (p['ORIGINAL_PRICE'] - 0) + ' * ' + (p[mi.options.paramSettings.productQuantity] - 0))

                    fullprice += (p['ORIGINAL_PRICE'] - 0) * (p[mi.options.paramSettings.productQuantity] - 0);
                }else{
					addToConsole('_getRegTotalbyCurrency could not verify price of ' + p.ITEM_ID);
				}
            });
            return fullprice;
        },
        /*
         * Calculates the cart discount price total for a particular currency
         */
        _getSubTotalbyCurrency: function (currency = 'ZP') {
            var mi = this;
            var fullprice = 0;
            $.each(mi.cart, function (i, p) {

				// verify that this is a populated sales product
				let inv_p = mi.options._saleProducts[p.ITEM_ID];

                if (mi._getValidateNumber(inv_p.PRICE)){ // && p.CURRENCY && p.CURRENCY === currency) { -- not necessary for  Boxing Week/ Black Friday

					//addToConsole('_getSubTotalbyCurrency -> fullprice: ' + (p['PRICE'] - 0) + ' * ' + (p[mi.options.paramSettings.productQuantity] - 0))

                    fullprice += (inv_p['PRICE'] - 0) * (p[mi.options.paramSettings.productQuantity] - 0);
                }else{
					addToConsole('_getSubTotalbyCurrency could not verify price of ' + p.ITEM_ID);
				}

				/*
                if (mi._getValidateNumber(p.DISCOUNTPRICE) && p.CURRENCY && p.CURRENCY === currency) {
                    fullprice += (p['DISCOUNTPRICE'] - 0) * (p[mi.options.paramSettings.productQuantity] - 0);
                }
				// */


            });
            return fullprice;
        },
        /*
         * Calculates the cart discount price total for a particular currency
         */
        _getItemCountbyCurrency: function (currency = 'ZP') {
            var mi = this;
            var itemNums = 0;
            $.each(mi.cart, function (i, p) {

				// verify that this is a populated sales product
				p = mi.options._saleProducts[p.ITEM_ID];

                if (mi._getValidateNumber(p.PRICE)){ // && p.CURRENCY && p.CURRENCY === currency) { -- not necessary for  Boxing Week/ Black Friday
                    itemNums += (p[mi.options.paramSettings.productQuantity] - 0);
                }else{
					addToConsole('_getItemCountbyCurrency could not verify price of ' + p.ITEM_ID);
				}
            });
            return itemNums;
        },
        /*
         * Gets the cart formatted regular price total
         */
        _getCartRegPrice: function () {
            var mi = this;
            var fullprice = mi._getRegTotal();
            return this._getMoneyFormatted(fullprice);
        },
        /*
         * Calculates the cart savings by subtracting the subtotal from the original price total
         */
        _getCartSavings: function () {
            var mi = this;
            var subtotal = mi._getSubTotal(), fullprice = mi._getRegTotal();
            //return this._getMoneyFormatted(fullprice - subtotal);
			return (fullprice - subtotal);
        },

        /*
         * Calculates the cart savings by subtracting the subtotal from the original price total by currency
         */
        _getCartSavingsbyCurrency: function (currency = 'ZP') {
            var mi = this;
            var subtotal = mi._getSubTotalbyCurrency(currency), fullprice = mi._getRegTotalbyCurrency(currency);
            //return this._getMoneyFormatted(fullprice - subtotal);
			return (fullprice - subtotal);
        },

        /*
         * get unique cart item IDs
		 * // we need to know what's in the cart to disallow player's from adding similar items
         */
        _getCartUniqueITEM_IDs: function () {
            var mi = this;
            var ITEM_IDs = [];
            $.each(mi.cart, function (i, p) {

				// verify that this is a populated sales product
				p = mi.options._saleProducts[p.ITEM_ID];

				if('CFSHOP' !== mi.options.shop_type){

					if (mi._getValidateNumber(p.PRICE)) {
						ITEM_IDs.push(p.ITEM_ID);
					}
				}else{
					ITEM_IDs.push(p.ITEM_ID);
				}

            });
            return ITEM_IDs;
        },

        /*
         * Calculates the number of all cart items
         */
        _getCartAllItemsCount: function () {
            var mi = this;
            var itemsCount = 0;
            $.each(mi.cart, function (i, p) {

				// verify that I'm putting a populated salesItem in the cart by resetting p from local data
				var p_details = mi.options._saleProducts[p.ITEM_ID];
				addToConsole('_getCartAllItemsCount: validating price DETAILS: ' + p_details.PRICE + ' is a number ' + parseInt(p_details.PRICE,10))
				itemsCount += (p[mi.options.paramSettings.productQuantity] - 0);

            });
            return itemsCount;
        },

        /**
         *
         * Check if there is a limit on the item to be purchased.
         *
		 * CFSHOP does checks for
		 * 	-	COUNT_AVAILABLE - sorry about that Justin I will tell you to remove it
		 * 	-	IS_VVIP
		 * 	-	TOTAL_COUNT
		 * 	-	LIMIT_PER_USER
		 * 	-	ITEM_LEFT_COUNT
		 * 	-	RESTRICTIONS
		 *
		 *
		 * VVIP sale does checks for
		 * 	-	RESTRICTIONS
		 * 	-	CONDITION
		 *
         */
        _checkRestrictions: function (p, qty) {

			var result = false;
			var mi = this;
			var ITEM_ID = p.ITEM_ID;

			addToConsole('Restriction Test -> checking ITEM_ID: ' + ITEM_ID + ' with adding qty: ' + qty);
			addToConsole('Restriction Test Limit : ' + mi.options._saleProducts[ITEM_ID].LIMIT_PER_USER + ' which could be different from ' + p.LIMIT_PER_USER);
			// LIMIT_PER_USER

			addToConsole( (qty-0) + ' > ' + (p.LIMIT_PER_USER - 0) );

			if(mi.options._saleProducts[ITEM_ID].RESTRICTIONS-0){

				// we only want to use LIMIT_PER_USER now so double check
				if(!mi.options._saleProducts[ITEM_ID].hasOwnProperty('LIMIT_PER_USER')){
					mi.options._saleProducts[ITEM_ID].LIMIT_PER_USER = mi.options._saleProducts[ITEM_ID].RESTRICTIONS-0;
				}

				addToConsole('there is a restriction of ' + p.LIMIT_PER_USER + ' on item: ' + ITEM_ID);

				if(qty > mi.options._saleProducts[ITEM_ID].LIMIT_PER_USER){
				//if(qty  > (p[mi.options.paramSettings.productLimit] - 0)){
				//if(qty > p.LIMIT_PER_USER){

					result = false;

					var string = mi.options.lang.max_reached; // + "\n" + p.DISPLAYNAME + ' ITEMID: ' + p.ITEMID;

					mi._logMessage('outputting a show message at _checkRestrictions');
					mi._showMessage({'result': -8000, 'APImessage': string});

				}else{
					result = true;
				}

			}else{

				addToConsole('there is NO restriction on this item: FREE FOR ALL');
				result = true;
			}

           return result;
        },

		/*

		Some items have a condition restriction where the mercenary is only allowed to purchase IFF they have the corresponding item

			ex: user can only purchase skin for M4 if user either has M4XSZ or is purchasing M4XSZ

			returns true if user passes condition
			returns false if user does NOT pass condition
		// */
		_checkItemConditionRestrictionFlag(CONDITIONAL_ITEM_IDs){

			var mi = this;
			var returnVal = false;

			if(!CONDITIONAL_ITEM_IDs){
				return returnVal;
			}
			try{

				let IDs = CONDITIONAL_ITEM_IDs.split(',');

				IDs.forEach((ITEM_ID) => {

					//let firstITEM_ID = parseInt(IDs[0],10);
					var givenKey = parseInt(ITEM_ID, 10);


					// check if mercenary posseses item

					addToConsole('_checkItemConditionRestriction checking user inventory on given: ' + givenKey);

					if(mi.options._saleProducts && mi.options._saleProducts[givenKey] && mi.options._saleProducts[givenKey].EXISTS_CNT){

						addToConsole('_checkItemConditionRestriction -> user POSSESSES inventory on given: ' + givenKey);
						returnVal = true;
						return returnVal;
					}

					// check if mercenary placed in cart

					$.each(mi.cart, function (i, n) {

						var currKey = parseInt(n.unique_key, 10);

						addToConsole('_checkItemConditionRestriction -> checking cart[' + n + ']: ' + currKey + ' vs given: ' + givenKey);

						if (currKey === givenKey){

							// user has placed item in cart
							returnVal = true;
							return returnVal;
						}

					});

				});

			}catch(e){

				addToConsole(e);
				return returnVal;

			}

			return returnVal;
		},

        /**
         *
         * Show the mercenary exactly how much they are going to spend / reduce their ZP
         */
        _confirmCart: function() {

            var mi = this;
            var allGood = false;

            var string = '';

            var title = confirmPurchaseText;
            var balanceText1 = act_balance_text;
            var balanceText2 = rmdr_balance_text;
            var total_price = regtotal;
            var buttonMessageText = checkout;
            var cancelButtonText = cancelText;

            var curr_balance = mi.options.myBalance;

            var price = mi._getSubTotal();

			if(price <=0 ){
				return;
			}

            var rmdr_balance = (curr_balance - price);

            var enabled = (rmdr_balance >=0 ) ? '' : ' disabled="true"';

            var actionButton = (rmdr_balance >= 0) ? 'checkoutCart' : 'gotodeposit';
            var actionButtonText = (rmdr_balance >= 0) ? checkout : insufficient_funds_action_text;


			// update the button text and action based on remaining balance
			if(rmdr_balance < 0){

				// update the button to go to the deposit page

				//$('#controls').html('<button id="btn-close" class="' + actionButton + '">' + actionButtonText + '</button>');
				$('#controls').html('<button id="btn-close" style="background: transparent;border: 1px solid #ddd;border-radius: 3px;color: #000;z-index: 1;" class="' + actionButton + '">' + actionButtonText + '</button>');

			}else{

				$('#controls').html('<button id="btn-confirm" class="checkoutCart">' + actionButtonText + '</button>');

			}

            var strings = [

                                  '<ul>'
                                ,   '<li id="checkoutBalance">'
                                ,       balanceText1
                                ,   '</li>'
                                ,   '<li>'
                                ,       addCommas(curr_balance) + ' ZP'
                                ,   '</li>'
                                , '</ul>'

                                , '<ul>'
                                ,   '<li id="checkoutCost">'
                                ,       total_price
                                ,   '</li>'
                                ,   '<li>'
                                ,       addCommas(price) + ' ZP'
                                ,   '</li>'
                                , '</ul>'

                                , '<ul>'
                                ,   '<li id="checkoutRemaining">'
                                ,       balanceText2
                                ,   '</li>'
                                ,   '<li>'
                                ,       addCommas(rmdr_balance) + ' ZP'
                                ,   '</li>'
                                , '</ul>'

            ];

            string = strings.join('');

            $('.modal__checkout-confirm #wallet').html(string);
			activateModal('.modal__checkout-confirm');
			addToConsole('checkout confirm')

        },
		_isFullURL: function(string){

			var expr = /^http|\/\//;
			return expr.test(string);
		},

		_hasImgExtension: function(string){

			var expr = /\.jpg$|\.png$/;
			return expr.test(string);
		},

        /**
         *
         * Something happened. Show a message.
         */
        _showMessage: function(Object) {

            var mi = this;

            var options = {};

            var title = general_error_title;
            var message = nochar_msg_messg; //"Something bad happened. Perhaps it wasn't actually bad but it was a showstopper.";
            var actionText = cancelText;
            var actionVerb = "";

			var ITEM_ID = null;

			var couponPurchase = false;
			var discountAmount = 0;

			// which one to use
			addToConsole(Object);

			var myResult;

			if(Object.ITEM_ID){
				ITEM_ID = Object.ITEM_ID;
			}

			if(Object.p_o_ErrID){
				myResult = Object.p_o_ErrID
			}else{
				myResult =  (Object.result) ? Object.result : Object.APIresult;
			}

			try{
				if(Object.dsResult && Object.dsResult[0] && Object.dsResult[0].errID ){
					myResult = Object.dsResult[0].errID;
					message = Object.dsResult[0].errDesc;
				}
			}catch(e){}

			if(Object.APImessage){
				message = Object.APImessage;
			}

			mi._Z8Games_exception(Object);

			// this section is deprecated by _Z8Games_exception
			/*
            switch(myResult){}
			mi._popUpGeneralMessage(title, message, actionVerb, actionText, ITEM_ID, myResult);
			// */
        },
        /**
         * show a message to the shopper about the result of an action being processed
         */
		_cartItemEventCheck: function (result, ITEM_ID = null, product = null, quantity = null){

            var mi = this;
			var message = '';
			var retVal = false;

			//mi._logMessage(product[0]);
			if(null == ITEM_ID && product && product[0]){
				ITEM_ID = product[0].ITEM_ID;
			}

            mi._logMessage('_cartItemEventCheck processing: ' + ITEM_ID + ' quantity: ' + quantity);
			mi._logMessage(product);

			if(result && result.cartItems && result.cartItems[0] && result.cartItems[0].hasOwnProperty('result')){

				addToConsole(result.cartItems)
                var cartIntResult = parseInt(result.cartItems[0].result, 10);

                addToConsole('cartIntResult: ' + cartIntResult);

                switch(cartIntResult){

                    case 0: {
                        // item updated successfully

                        mi._logMessage('_cartItemEventCheck case 0 is success');
                        retVal = true;

                    } break;

                    case 2: {
                        // item added successfully

                        mi._logMessage('_cartItemEventCheck case 2');
                        retVal = true;

                    } break;

                    case -4: {
                        mi._logMessage('outputting a _cartItemEventCheck processing: show message at _triggerEvent -4');
                        mi._showMessage({'result': -4, 'APImessage': noCharacterMessage, 'ITEM_ID' : ITEM_ID});
                        retVal = false;
                        // reload cart with the preload function
                        //mi._reloadCart();
                    } break;

					case '-7':
                    case -7: {

                        message = (result.cartItems[0].message) ? result.cartItems[0].message : '-7 error';

                        mi._logMessage('outputting a _cartItemEventCheck processing: show message at _triggerEvent -7');
                        mi._showMessage({'result': -7, 'APImessage': message, 'ITEM_ID' : ITEM_ID});
                        retVal = false;
                        // reload cart with the preload function
                        //mi._reloadCart();
                    }break;

					case '-8':
					case -8:
					case '-9':
                    case -9: {
                        mi._logMessage('outputting a _cartItemEventCheck processing: show message at _triggerEvent -8');
                        mi._showMessage({'result': -8, 'APImessage': result.cartItems[0].message, 'ITEM_ID' : ITEM_ID});
                        retVal = false;
                        // reload cart with the preload function
                        //mi._reloadCart();
                    } break;

					case '-10':
                    case -10: {

                        message = (message) ? message : '-10 error';
                        retVal = false;

                        // user attempted to purchase special package more than once
                        if (typeof disableAddButton === "function"){

                            // we know the special item is in itemsNotDiscountedList
                            if(mi.options.itemsNotDiscountedList && mi.options.itemsNotDiscountedList.length){
                                // it should be the first item
                                disableAddButton(mi.options.itemsNotDiscountedList[0]);
                                addToConsole('disabling special package for the time being');

                                // and remove from cart (to be safe)
                                mi._removeFromCart(ITEM_ID);
                                addToConsole('cart removal: special package: ' + ITEM_ID);

                                // and hide if we can
                                $('#' + ITEM_ID).hide();
                                addToConsole('hide: special package: ' + ITEM_ID);
                            }
                        }

                        mi._logMessage('outputting a _cartItemEventCheckErrorResponses processing: show message at _triggerEvent -10');
                        mi._showMessage({'result': -10, 'APImessage': message, 'ITEM_ID' : ITEM_ID});

                    }break;

                    case -11:
					case '-11':
					case '-12':
					case -12: {
                        // user attempted to purchase duplicated character/item more than once
                        retVal = false;
                        mi._logMessage('outputting a show message at _triggerEvent -11');
                        mi._showMessage({'result': -12, 'APImessage': max_reached_message, 'ITEM_ID' : ITEM_ID});
                    }break;

					case '-15': case -15: case '-16': case -16: case '-17': case -17: case '-18': case -18: case '-19': case -19: case -103: case '-103': case -100: case '-100':
					case '-20': case -20: case '-21': case -21: case '-22': case -22: case '-23': case -23: case '-24': case -24: case '-25': case -25: case '-26': case -26:
					case '-14':
                    case -14: {

                        message = (result.cartItems[0].message) ? result.cartItems[0].message : '-14 error';

                        mi._logMessage('outputting a _cartItemEventCheck processing: show message at _triggerEvent -14');
                        mi._showMessage({'result': -14, 'APImessage': message, 'ITEM_ID' : ITEM_ID});
                        retVal = false;
                        // reload cart with the preload function
                        //mi._reloadCart();
                    } break;

                    case -91:{

                        // -91  is a 'not event item error'
                        // and remove from cart (to be safe)

                        mi._logMessage('outputting a _cartItemEventCheck processing: show message at _triggerEvent -91');
                        mi._showMessage({'result': -91, 'APImessage': result.cartItems[0].message, 'ITEM_ID' : ITEM_ID});
                        mi._removeFromCart(ITEM_ID);
                        retVal = false;
                        // reload cart with the preload function
                        //mi._reloadCart();
                    } break;

                    default: {

                        mi._logMessage('outputting a _cartItemEventCheck processing : show message at _triggerEvent ' + result.cartItems[0].result);
                        mi._showMessage({'result': result.cartItems[0].result, 'APImessage': result.cartItems[0].message, 'ITEM_ID' : ITEM_ID});
                        retVal = false;
                        // reload cart with the preload function
                        //mi._reloadCart();
                    } break;

                }
            }else{

                    mi._logMessage('outputting a _cartItemEventCheck processing : show message NO result.cartItems[0].result returned');
                    mi._showMessage({'result': -8006, 'APImessage': couldNotSaveCart, 'ITEM_ID' : ITEM_ID});
                    retVal = false;
            }

			return retVal;
        },
        /**
         * show a message to the shopper about the result of an action that could NOT be processed
         */
        _cartItemEventFail: function (result, ITEM_ID = null){
            // send message to user
            //addToConsole(couldNotSaveCart)
            var mi = this;
            var msg = couldNotSaveCart;
			let errorCode = -8000;

			try{
				if(result && result.cartItems && result.cartItems[0] && result.cartItems[0].result){
					errorCode = result.cartItems[0].result;
				}
				if(result && result.cartItems && result.cartItems[0] && result.cartItems[0].message){
					msg = result.cartItems[0].message;
				}

				if(result.APIresult && 'E500' == result.APIresult ){
					errorCode = result.APIresult;
					msg = result.APImessage;
				}
			}catch(e){
				addToConsole(e);
			}

            mi._logMessage('outputting a show message at _triggerEvent ' + errorCode);
            mi._showMessage({'result': errorCode, 'APImessage': msg, 'ITEM_ID' : ITEM_ID});
            // reload cart
            //mi._reloadCart();
			mi._refreshCartDisplayTotals();
        },

		_displayCheckoutErrors: function (messages = null){

			addToConsole('displaying checkout errors - start');

			var mi = this;

			let showErrors = false;

			//$('.generic_checkout_error').append('<p class="'specific_checkout_error'">' + next_message + '</p>');

			addToConsole(mi.options.storedErrorMessages)

			$.each(mi.options.storedErrorMessages, function (index, i) {
				showErrors = true;

				addToConsole(i)
				addToConsole(index)

				addToConsole('displaying checkout error for ITEM_ID: ' + i.ITEM_ID);
				addToConsole('displaying checkout errorID: ' + i.errorID);
				addToConsole('displaying checkout error: ' + i.error);

				if($('#_cart_item_' + i.ITEM_ID + ' > .cart_price').length){
					$('#_cart_item_' + i.ITEM_ID + ' > .cart_price').after(i.error);

					// we could probably add a switch case here for other errors.

					if(i.errorID && "824" == i.errorID){
						mi._lockITEM_ID(i.ITEM_ID);
					}

				}else{
					$('.checkout_error').append(i.error);
				}
			});

			// empty the stored messages
			mi.options.storedErrorMessages = [];

			if(messages){
				$('.checkout_error').append(string);
			}

			if(messages || showErrors){

				$('.checkout_error').show();
				$('.generic_checkout_error').show();

				setTimeout(function () {
					try{
						mi._hideAllCheckOutErrors();

					}catch(e){
						// refresh page just in case?
					}
				  }, 3000);
			}

			addToConsole('displaying checkout errors - end');

		},
		/**
		 *
		 * Perform this action to clear away all errors before attempting a purchase
		 *
		 */

		_hideAllCheckOutErrors: function(){

			$('.checkout_error').fadeOut();
			$('.generic_checkout_error').fadeOut();
			//$('.specific_checkout_error').remove();
			//$('.cart_error').remove();
			$('.specific_checkout_error').fadeOut();
			$('.cart_error').fadeOut();
		},

		/*
			Show a message to the user

			This method was originally the last stop before output of a message.
			We added
				ITEM_ID
			for the times we would have to store a message about a particular ITEM_ID before displaying to the user

			We added
				errorID
			for the same reason as ITEM_ID. errorID is usually a response from the API (which has been stripped by the time it gets to this method)

		// */
		_popUpGeneralMessage: function (title = general_error_title, message = general_delivery_error, actionVerb = cancelText, actionText = 'cancel', ITEM_ID = null, errorID = null){

			closeOpenDialog();

			addToConsole('_popUpGeneralMessage title ' + title);
			addToConsole('_popUpGeneralMessage actionVerb ' + actionVerb);
			addToConsole('_popUpGeneralMessage message ' + message);
			addToConsole('_popUpGeneralMessage actionText ' + actionText);
			addToConsole('_popUpGeneralMessage ITEM_ID ' + ITEM_ID);
			addToConsole('_popUpGeneralMessage errorID ' + errorID);

			// clear modal
			//$('.item_details').empty();
			$('.general_details').empty();

			var mi = this;

			var strings = [];
			var string = '';

			var closeButton = '<button class="close_button"><span>' + close_text + '</span></button>';

			if('gotologin' === actionVerb){
				// disallow closing the modal since the user must sign in to view page
				closeModal = null;
				closeButton = '';
				ITEM_ID = null;
				$('body').css('height', '100%');
				$('body').css('overflow', 'hidden');

				// if this is the show_cart page, we should just redirect to login page

				//if(this.options.show_cart){
				//	location.href = LOGIN_PAGE_URL;
				//	return;
				//}
			}

			// disallow any other action
			if('gotoCrossfire' === actionVerb || 'cancel' === actionVerb){
				closeButton = '';
				actionVerb+= ' close_button';
			}

            strings = [

				'<div class="message_modal">'
				,'	<div class="modal_header">'
				,'	  <h3>' + title + '</h3>'
				,'	</div>'
				,'	<div class="modal-textbox" style="text-align: center;">'
				,'		<p>' + message + '</p>'
				,'	</div>'
				,'	<div class="modal_ui">'
				,		closeButton
				,		'<button class="card_button ' + actionVerb + '"><span>' + actionText + '</span></button>'
				,'</div>'
			  ,'</div>'

            ];

			// if we are on the CART page, try to attach the error messages to the ITEM_ID instead of using a pop-up modal

			addToConsole('show cart is ' + mi.options.show_cart + ' and ITEM_ID is ' + ITEM_ID)

			if(mi.options.lastProccessedItemID){
				addToConsole('show cart is ' + mi.options.show_cart + ' and lastProccessedItemID is ' + mi.options.lastProccessedItemID)
			}

			if(ITEM_ID && mi.options.show_cart){

				var errorObj = {
					'ITEM_ID' : ITEM_ID,
					'errorID' : errorID,
					'error' : '<div class="cart_error"><p>' + title + ': ' + message + '</p></div>'
				};

				mi.options.storedErrorMessages.push(errorObj);

				if(mi.options.cartRenderComplete){

					addToConsole('_popUpGeneralMessage displaying cart error message: ' + string);
					mi._displayCheckoutErrors();

				}else{

					// wait until the cart is rendered

					return;
				}

			}else{

				var string = strings.join('');
				$('.general_details').append(string);
				//$('.item_details').append(string);

				loadModal('#general_modal', 'top')
				//loadModal('#details_modal', 'top');
			}

		},

        /*
         * Cart submit functionalities
         */
        _submitCart: function () {
            var mi = this;

			const webshopAPI = 'https://' + window.location.hostname + '/rest/webshopitems.json';

			var params = {
				'command': 'purchasecfshopcart'
				,'event': mi.options.shop_type
				,'event_id' : mi.options.shop_event_id
			};

			$.ajax({
				url: webshopAPI,
				type: 'POST',
				data: params,
				dataType: 'json', // added data type
				success: function(result) {
					addToConsole(result);

					if(	(result.returnValue == '0'
						|| result.status == 'true'
						|| result.apiresult == '000'
						|| result.APIresult == '000'
						)
						&& 0 == result.p_o_ErrID
					)
					{
						try{

							addToConsole('purchase success');

							mi._triggerEvent("cartSubmitted", [mi.cart]);
							//mi._clearCart();	// unnecessary because it will try to send a call to remove individually (which will be impossible)
							mi.cart = [];	// manually empty it

							// new success location
							mi._triggerEvent("showCompletePurchasePage");
							//mi._logMessage('outputting a show message at _submitCart _hasCartChange');

							//mi._hasCartChange();
							//mi._showMessage(result);
							return true;

						}catch(e){
							addToConsole(e.message);
							//mi._logMessage(e.message);
							mi._Z8Games_exception(result);
							return false;
						}

					} else {
						//mi._logMessage('outputting a show message at _submitCart ajax result success not true or 000');
						mi._Z8Games_exception(result);
						return false;
					}
				},
				fail: function(result) {
					addToConsole(result);
					mi._Z8Games_exception(result);
					return false;

				}
			});
        },

        // HELPER FUNCTIONS
        /*
         * Get the content of an HTML element irrespective of its type
         */
        _getContent: function (elm) {
            if (elm.is(":checkbox, :radio")) {
                return elm.is(":checked") ? elm.val() : '';
            } else if (elm.is("[value], select")) {
                return elm.val();
            } else if (elm.is("img")) {
                return elm.attr('src');
            } else {
                return elm.text();
            }
            return '';
        },
        /*
         * Compare equality of two product objects
         */
        _isObjectsEqual: function (o1, o2) {

            if(o1.unique_key == o2.unique_key){
                return true;
            }else{
                return false;
            }
        },
		// show an animation of the cart count
		_animateCount: function(){
			//for 2018
			//addToConsole('update this part of the code to highlight - ping animation - the number of items in the cart!')

			$('.animcartcount').addClass('pulseCartCount');
			setTimeout(function(){
				$('.animcartcount').removeClass('pulseCartCount');
			}, 500);
		},

        /*
         * Format money
         */
        _getMoneyFormatted: function (n) {
            n = n - 0;
            //return Number(n.toFixed(2)).toLocaleString(this.options.currencySettings.locales, this.options.currencySettings.currencyOptions);
            return addCommas(Number(n.toFixed(2)))
        },
        /*
         * Get the value of an element and empty value if the element not exists
         */
        _getValueOrEmpty: function (v) {
            return v && typeof v !== typeof undefined ? v : '';
        },
        /*
         * Validate Number
         */
        _getValidateNumber: function (n) {
            n = n - 0;

            if ((parseInt(n,10) >= 0) && n >= 0) {
                return true;
            }
            return false;
        },
        /*
         * Small templating function
         */
        _formatTemplate: function (t, o) {

            var r = t.split("{"),
                fs = '';
            for (var i = 0; i < r.length; i++) {
                var vr = r[i].substring(0, r[i].indexOf("}"));
                if (vr.length > 0) {
                    fs += r[i].replace(vr + '}', this._getValueOrEmpty(o[vr]));
                } else {
                    fs += r[i];
                }
            }
            return fs;
        },

		/** we will need to remove expired items from time to time when their countdown runs out */
		_removeItem(ITEM_ID){

			addToConsole('Removing expired item ID: ' + ITEM_ID);

			$('#' + ITEM_ID).fadeOut(1000,function(){
				$('#' + ITEM_ID).remove();
			});

		},

		_lockITEM_ID: function (id){
			if(id){
				$('#' + id).find('a').addClass('button-locked').removeClass('button-selected').removeClass('button-add');
				$('#' + id).find('.sc-add-to-cart').addClass('button-locked').removeClass('button-selected').removeClass('button-add');
				$('#' + id + ' > div > a').addClass('button-locked').removeClass('button-selected').removeClass('button-add');

				//card_button button-add sc-add-to-cart
				addToConsole('_lockITEM_ID locking: ' + id);

				$('button[data-id='+ id +']').addClass('button-locked').removeClass('button-selected').removeClass('button-add').attr('disabled', true);

				$('#'+ id).find('.sc-plus-item').attr('disabled', true);
				$('#'+ id).find('.sc-add-to-cart').attr('disabled', true);

			}
		},
		_unLockITEM_ID: function (id){

			if(id){
				$('#' + id).find('a').removeClass('button-locked').addClass('button-add');
				$('#' + id).find('.sc-add-to-cart').removeClass('button-locked').addClass('button-add');
				$('#' + id + ' > div > a').removeClass('button-locked').addClass('button-add');

				addToConsole('_unLockITEM_ID unlocking: ' + id);

				$('button[data-id='+ id +']').removeClass('button-locked').addClass('button-add').attr('disabled', false);

				$('#'+ id).find('.sc-plus-item').attr('disabled', false);
				$('#'+ id).find('.sc-add-to-cart').attr('disabled', false);

				//addToConsole($('button[data-id='+ id +']'));
			}
		},

		/*
			This function determines what to display and sends params to pop up a general message (with actions if necessary)

		*/
		_Z8Games_exception: function(result){

// mi._showMessage({
// 		'result': result.cartItems[0].result,
// 		'APImessage': result.cartItems[0].message,
// 		'ITEM_ID' : ITEM_ID});


			var mi = this;

			var actionVerb = null;
			var actionText = null;
			var itemID = null;


			var code = null;
			var message = '';
			var title = '';

			addToConsole('_Z8Games_exception');
			addToConsole(result);

			if(result && result.ITEM_ID){
				itemID = result.ITEM_ID;
			}

			if(result && result.APIresult){
				code = result.APIresult;
			}

			if(result && result.apiresult){
				code = result.apiresult;
			}

			if(result && result.result){
				code = result.result;
			}

			// most likely not signed in
			if(result && result.ZPBalance && "Error" == result.ZPBalance && !mi.options.userSignedIn){
				code = '612';
			}

			if(result.dsResult && result.dsResult[0] && result.dsResult[0].errID ){
				code = result.dsResult[0].errID;
				message = result.dsResult[0].errDesc;
			}

			if(null !== mi.options.lastProccessedItemID && null == itemID){
				itemID = mi.options.lastProccessedItemID;
			}

			try{
				if(result.p_o_ErrDesc && result.p_o_ErrID ){
					code = result.p_o_ErrID;
					message = result.p_o_ErrDesc;
				}
			}catch(e){}

			try{
				message = result.APImessage;
			}catch(e){}

			try{
				if(result.buyCart && result.buyCart[0] && result.buyCart[0].result && result.buyCart[0].message){
					code = result.buyCart[0].result;
					message = result.buyCart[0].message;
				}
			}catch(e){}

			/*

				common text and actions


				// general
										actionText = continueShoppingActionText;
										actionVerb = 'cancel';

				// purchase complete

										title = purchaseCompleteTitle;
										message = purchaseCompleteMessage;
										actionText = continueShoppingActionText;
										actionVerb = "success";

				// general error

											title = general_error_title;
											message = Object.buyCart[0].message;
											actionText = continueShoppingActionText;
											actionText = cancelText;
											actionVerb = 'cancel';

				// no character

										title = nochar_msg_title;
										message = nochar_msg_messg;
										actionText = nochar_msg_action_text;
										actionVerb = "cancel";

				// insufficient funds

										title = insufficient_funds;
										message = insufficient_funds_messg;
										actionText = insufficient_funds_action_text;
										actionVerb = "gotodeposit";

			*/

			switch(code)
			{
                case -8000 :
				case '-8000' : {
                        title = general_error_title;
                        actionText = continueShoppingActionText;
                        actionVerb = 'cancel';
				}
				break;
                case 200 : {
                        title = purchaseCompleteTitle;
                        message = purchaseCompleteMessage;
                        actionText = continueShoppingActionText;
                        actionVerb = "success";
				}
				break;
                case 500: case '500': case "E500"	:{

                        title = general_error_title;
                        actionText = cancelText;
                        actionVerb = 'cancel';

						if(-1 !== message.indexOf('auth.user_id')){
							message = webshop_msg_603;
							actionText = logged_in_action_text;
							actionVerb = "gotologin";
						}
				}
				break;
				case -4:
                case "-4"	:{
                        title = nochar_msg_title;
                        message = nochar_msg_messg;
                        actionText = nochar_msg_action_text;
                        actionVerb = "cancel";
				}
				break;
                case 0 :
				case "0" :
                case "000" : {

                        title = purchaseCompleteTitle;
                        message = purchaseCompleteMessage;
                        actionText = continueShoppingActionText;
                        actionVerb = "success";
				}
				break;

                case 120 :
                case "120"	:{
                        title = insufficient_funds;
                        message = insufficient_funds_messg;
                        actionText = insufficient_funds_action_text;
                        actionVerb = "gotodeposit";
				}
				break;

                case "6593":{

                    // please check duration or availability
                    //modal_Error('No Product Available', result)
                    //error_no_product();

					title = general_error_title;
					message = webshop_item_not_available;
					actionText = cancelText;
					actionVerb = 'cancel';
				}break;

                case "-135"	:
                case "-100"	:
				case "613"	:
				case 613	:
				case 603	:
				case 612	:
				case "612"	:{

					title = general_error_title;
					message = webshop_msg_603;
					actionText = logged_in_action_text;
					actionVerb = "gotologin";
				}
				break;

				case "-1382":
				case "-120"	:
				case "652"	:
				case "120"	:{
					//insufficient funds

					title = insufficient_funds;
					message = insufficient_funds_messg;
					actionVerb = "gotodeposit";
					actionText = insufficient_funds_action_text;
				}
				break;

				case "-99"	:
				case "-1"	:
				case "-10"	:
				case "-100"	:
				case -100	:
				case "-103"	:
				case -103	:
				case "651"	:
				case "99"	:{
					//purchase limit

					title = itemLimitTitle;
					message = itemLimitMessage;
					actionVerb = "cancel";
					actionText = continueShoppingActionText;
				}
				break;

				// with the cart now available, user's really have to sign in
				case "826" :
				case 826 : {
					title = general_error_title;
					message = webshop_msg_826;
					actionText = logged_in_action_text;
					actionVerb = "gotologin";
				}
				break;

				case "-888" :{
					//package select error

					title = general_error_title;
					message = package_select_error_message;
					actionVerb = "cancel";
					actionText = continueShoppingActionText;
				}
				break;

				case "-4" :
				case "-6" :{
					//package error

					title = general_error_title;
					message = package_error_message;
					actionVerb = "cancel";
					actionText = continueShoppingActionText;

				}
				break;

				case 7 :
				case "7" :{
					//character error

					title = general_error_title;
					message = webshop_msg_7;
					actionVerb = "cancel";
					actionText = continueShoppingActionText;

				}
				break;

				case '-15':
				case -15: {

					title = general_error_title;
					message = package_error_message;
					actionVerb = "cancel";
					actionText = continueShoppingActionText;

				}
				break;

				case '-10':
				case -10: {

					title = general_error_title;
					message = package_error_message;
					actionVerb = "cancel";
					actionText = continueShoppingActionText;

				}
				break;

				case -7 :
				case "-7" :{
					// max limit costume

					title = general_error_title;
					message = max_reached_message;
					actionVerb = "cancel";
					actionText = continueShoppingActionText;
				}
				break;

				case "8" : case 8 :{
						title = general_error_title;
						message = webshop_msg_8;
						actionVerb = "cancel";
						actionText = continueShoppingActionText;
				} break;
				case "9" : case 9 :{
						title = general_error_title;
						message = webshop_msg_9;
						actionVerb = "cancel";
						actionText = continueShoppingActionText;
				} break;
				case "11" : case 11 :{
						title = general_error_title;
						message = webshop_msg_11;
						actionVerb = "cancel";
						actionText = continueShoppingActionText;
				} break;
				case "12" : case 12 :{
						title = general_error_title;
						message = webshop_msg_12;
						actionVerb = "cancel";
						actionText = continueShoppingActionText;
				} break;

				case '-11':
				case -11:
				case '-14':
				case -14:
				case '-13':
				case -13:
				case '-12':
				case -12: {
						title = general_error_title;
						message = max_reached_message
						actionVerb = "cancel";
						actionText = continueShoppingActionText;
				}break;
				case "13" : case 13 :{
						title = general_error_title;
