;(function ($, window, document, undefined) {
    "use strict";
    // Default options

    var defaults = {
        cart: [], // initial products on cart
		xhrItemPool: [], // pool for sending items to API
		_RAWsaleProducts: [], // array of sale item objects passed in via ajax call
        _saleProducts: [], // array of sale item objects
        _saleProgress: [], // array of sale item progress objects
        _saleProgress40: [], // array of sale item progress objects
        resultName: 'cart_list', // Submit name of the cart parameter
        theme: 'null', // theme for the cart, related css need to include for other than default theme
        combineProducts: true, // combine similar products on cart
        highlightEffect: false, // highlight effect on adding/updating product in cart
        productContainerSelector: '.sc-product-item',
        productElementSelector: '*', // input, textarea, select, div, p
        addCartSelector: '.sc-add-to-cart',
        plusItemSelector: '.sc-plus-item',
        minusItemSelector: '.sc-minus-item',
        paramSettings: { // Map the paramters
            productOriginalPrice: 'ORIGINAL_PRICE',
            productPrice: 'PRICE',
            discount: 'DISCOUNT',
            productImg: 'IMG',
            productRestriction: 'RESTRICTIONS',
            productLimit: 'LIMIT_PER_USER',
            productQuantityInput: 'QUANTITYSELECT',
            productQuantity: 'QUANTITY',
            productName: 'NAME',
            productId: 'ITEM_ID'
        },
        lang: { // Language variables
            cartTitle: cartTitle,
            cartSubTitle: cartSubTitle,
            checkout: checkout,
            clear: clear_title,
            regtotal: regtotal,
            subtotal: subtotal,
            discount: discount_title,
            max_reached: max_reached_message,
            cartRemove: '×',
            cartEmpty: '<div class="emptyCartContainer"><span class="emptycart">' + cartEmptyMsgOne + '</span></div>'
        },
        submitSettings: {
            submitType: 'ajax', // form, paypal, ajax
            ajaxURL: 'https://' + window.location.hostname +'/rest/blackfriday.json', // Ajax submit URL
            ajaxSettings: {} // Ajax extra settings for submit call
        },
        currencySettings: {
            accepted: ['ZP'],
            locales: 'en-US', // A string with a BCP 47 language tag, or an array of such strings
            currencyOptions: {
                style: 'currency',
                currency: 'USD',
                currencyDisplay: 'symbol'
            } // extra settings for the currency formatter. Refer: https://developer.mozilla.org/en/docs/Web/JavaScript/Reference/Global_Objects/Number/toLocaleString
        },
        toolbarSettings: {
            showToolbar: false,
            showCheckoutButton: true,
            showClearButton: true,
            showRegularSummary: false,
            showDiscountSummary: false,		// set to false to NOT display discount line in cart (useful when flatDiscountPercent = 0, ie: no discounted prices)
            showCartSummary: true,
            checkoutButtonStyle: 'default', // default, paypal, image
            checkoutButtonImage: '', // image for the checkout button
            toolbarExtraButtons: [] // Extra buttons to show on toolbar, array of jQuery input/buttons elements
        },
        debug: (typeof debug !== 'undefined') ? debug : false,
        discount: 0,
		flatDiscount: 0,
		flatDiscountPercent: 0,
        myBalance: 0,
		myZPBalance: 0,
		myEPBalance: 0,
		vip_status: false,
		rewardsWon: null,
		yearDate: new Date().getFullYear(),
		MaxUniqueItems: (typeof limitMaxItems !== 'undefined' && parseInt(limitMaxItems ,10)) ? limitMaxItems : 60,
		couponReimbursed: 0,
        SpendMoreForSavings: 0,
        SpendMoreForSavingsString: '',
		lastRegularPrice: 0,
		itemsNotDiscountedList: [], //mi.options.itemsNotDiscountedList
		lastDiscountedSavings: 0,
		preload_action: false,
		userSignedIn: false,
		userHasCharacter: false,
		userInventory: [],
		storedErrorMessages: [],
		numItemsPerWebShopPage: 20,
		currentPage: 1,
		startrow: 1,
		endrow: 20,
		shop_type: 'CFSHOP',
		shop_event_id: -1,
		show_items: false,
		show_cart: false,
		cartRenderComplete: false,
		lastProccessedItemID: null,
		cartCountType: 'unique'
    };

    // The plugin constructor
    function SmartCart(element, options) {
        // Merge user settings with default, recursively
        this.options = $.extend(true, {}, defaults, options);
        // Cart array
        this.cart = [];
        // Cart element
        this.cart_element = $(element);
        // Call initial method
        this.init();
    }

    $.extend(SmartCart.prototype, {

        init: function () {

            //Set debug (if set)
            if (typeof debug !== 'undefined'){
                this.options.debug = debug;
            }

			let mi = this;

			// we must find out if the user is signed in.
			// Easiest way is to do a balance check

			mi._Z8Games_balanceCheck(
				function(){

					mi.getPlayerIGN(
						function(){
							mi.options.userHasCharacter = true;
							mi._Z8Games_shopevent();

							// check if mercenary has redeemable attendance items
							mi._getBFAttendance();
						},
						function(result){
							mi.options.userHasCharacter = false;
							mi.noCharacterMessage(result);
						}
					);
				},
				function(result){
					// please sign in
					mi.pleaseSignInMessage();
				}
			);

            // load items that are NOT discounted

            try{

                if(itemsNotDiscountedList && Array.isArray(itemsNotDiscountedList)){
                    mi.options.itemsNotDiscountedList = itemsNotDiscountedList;
                    mi._logMessage('INIT setting itemsNotDiscountedList: ' + itemsNotDiscountedList.join(', '));
                }
            }catch(e){
                // no mystery box, or special items that are not discounted
            }


            // Set the elements
            //mi._setElements();

            // Add toolbar
            //mi._setToolbar();

            // Assign plugin events
            mi._setEvents();

            //mi._updateProductsLimit();


            // get the user's settings
            var saved_cart;

            // Call UI sync
            //mi._hasCartChange();
        },

        // PRIVATE FUNCTIONS
        /*
         * Set basic elements for the cart
         */
        _setElements: function () {
            // The element store all cart data and submit with form
            var cartListElement = $('<input type="hidden" name="' + this.options.resultName + '" id="' + this.options.resultName + '" />');
            this.cart_element.append(cartListElement);
            // Set the cart main element
            this.cart_element.addClass('panel sc-cart sc-theme-' + this.options.theme);
            //this.cart_element.append('<div class="sc-cart-heading"><button type="button" class="hide_cart close" aria-label="Close"><span aria-hidden="true">×</span></button><h3>' + this.options.lang.cartTitle + '</h3><p>' + this.options.lang.cartSubTitle + '</p></div>'); //<span class="sc-cart-count badge">0</span>

        },
        /*
         * Set the toolbar for the cart
         */
        _setToolbar: function () {
            if (this.options.toolbarSettings.showToolbar !== true) {
                return false;
            }

            var toolbar = $('<div></div>').addClass('panel-footer sc-toolbar');
            var toolbarButtonPanel = $('<div class="sc-cart-toolbar" id="controls">');
            var toolbarDiscountPanel = $('<div class="sc-cart-discount">');
            var toolbarSummaryPanel = $('<div class="sc-cart-summary">');

            // Checkout Button
            if (this.options.toolbarSettings.showCheckoutButton) {
                var btnCheckout = '';
				btnCheckout = '<button id="btn-checkout" class="btn sc-cart-checkout" type="button">' + this.options.lang.checkout + '</button>';
                toolbarButtonPanel.append(btnCheckout);
            }

            // Add extra toolbar buttons
            if (this.options.toolbarSettings.toolbarExtraButtons && this.options.toolbarSettings.toolbarExtraButtons.length > 0) {
                toolbarButtonPanel.append(this.options.toolbarSettings.toolbarExtraButtons);
            }

            // Cart Summary
            if (this.options.toolbarSettings.showCartSummary) {
                var panelSubTotal = $('<div id="wallet" class="sc-cart-summary-subtotal">');

                panelSubTotal.append('<ul><li id="totalCartText">' + this.options.lang.regtotal + '</li><li id="cartTotal" class="sc-cart-subtotal money"></li></ul>');
                toolbarSummaryPanel.append(panelSubTotal);
            }

            toolbar.append(toolbarSummaryPanel);
            toolbar.append(toolbarButtonPanel);

            // Clear Button
            if (this.options.toolbarSettings.showClearButton) {

				var btnClear = $('<a class="btn-secondary sc-cart-clear" type="button" style="display: flex; justify-content: center; margin-top:-12px; padding-bottom:20px;">').text(this.options.lang.clear);

				toolbar.append(btnClear);
            }

			// close button
			toolbar.append('<a id="btn-closeX" class="hide_cart"><button></button></a>');

            //this.cart_element.append(toolbar);
			this.cart_element.after(toolbar);
        },
        /*
         * Set events for the cart
         */
        _setEvents: function () {
            var mi = this;

			// for CFShop

			let currency = $('button.nav_button.currency_button.active').attr('data-currency');
			let filter = $('button.nav_button.filter_button.active').attr('data-filter');
			let page = $('button.pagination_button.active').attr('data-page');

			$(document).delegate('.claimBFEventItem', 'click', function(e) {
                e.preventDefault();
                var itemID = $(this).attr('data-id');

                if ($(this).hasClass('disabled')) {
					//location.reload();
                    return false;
                }
				$(this).addClass('disabled');

				mi._claimBFEventItem(itemID);

            });

            $(document).delegate(".categoryanchor", 'click', function(e) {
				var aTagName = $(this).attr('movetarget');
				const element = document.getElementById(aTagName);
				element.scrollIntoView();
            })

			$(document).delegate('button.cfshop-icon-cart', 'click', function (e) {
				mi._triggerEvent("showCartPage");
			});


			$(document).delegate('button.pagination_button', 'click', function (e) {

				page = $(e.target).attr('data-page');
				mi._Z8Games_filterCFShop(filter,currency,page);

			});

            // show item popup
            $('.overlay').click(function (e) {
                e.preventDefault();
                var ITEM_ID = $(this).parent().parent().attr('id');

				if(!ITEM_ID){
					ITEM_ID = $(this).parent().parent().parent().attr('id');
				}

                mi._showItem(ITEM_ID);

            });


			// capture modal events
			$(document).delegate('.card_info', 'click', function(e) {

				e.preventDefault();
				//let ITEM_ID = $(e.target).parent().parent().attr('id');
				let ITEM_ID = $(e.target).attr('data-item_id');

				if(!ITEM_ID){

					ITEM_ID = $(e.target).attr('data-item_id');
				}

				// limited items have a different ID
				//addToConsole('ITEM_ID: ' + ITEM_ID);

				// all of the data required should be an attribute of the element
				let myData = $(e.target).data();
				//addToConsole(myData);
				mi._createShopModal(myData, parseInt(ITEM_ID,10), e.target.dataset.animation);
				//mi._showItem(ITEM_ID);

			});

            // capture cancel events to clear cart if necessary
            $(document).delegate('.cancel,.modal-header > .close', 'click', function(e) {

                e.preventDefault();
                //$('.modal').modal('hide');
				closeOpenDialog(); //modalHide();
            });

            // hide any active modals on click
            $(document).delegate('#btn-close, #checkoutCancel, #btn-closeX', 'click', function(e) {

                e.preventDefault();
				closeOpenDialog(); //modalHide();

            });

            // hide any active modals on click for purchase
            $(document).delegate('.checkout_proceed', 'click', function(e) {

                e.preventDefault();
				closeOpenDialog(); //modalHide();

				if(mi._getCartAllItemsCount() > 0){
					mi._Z8Games_balanceCheck(
						function(){mi._updateCheckoutModal(e.target.dataset.animation);},
						function(result){mi._Z8Games_exception(result);}
					);
				}
			});

            // hide any active modals on click for purchase
            $(document).delegate('#btn-confirm, .checkoutCart', 'click', function(e) {

                e.preventDefault();
				closeOpenDialog(); //modalHide();

				mi._Z8Games_balanceCheck(
					function(){

						mi._submitCart();

						var isSubmited = false;
						if(!isSubmited){
							//Submit

							//disable button
							$(".checkoutCart").attr('disabled', true);
							isSubmited = true;

							addToConsole(isSubmited)

							//stop function
							return;
						}

					},
					function(){
						// please sign in
						//mi._Z8Games_exception({'APIresult': '613', 'message': pleaseLoginContinue});
						mi.pleaseSignInMessage(webshop_msg_603);
					}
				);
            });

            // show the cart
            $(document).delegate('.show_cart', 'click', function(e) {

                e.preventDefault();

				mi.options.show_cart = true;
				addToConsole('checkout');

            });

			$(document).delegate('#donotshow', 'click', function(e) {

				if($('#donotshow').is(":checked")){
					localStorage.setItem('sgw_shop_cart_disclaimer_hide', true);
				}else{
					localStorage.setItem('sgw_shop_cart_disclaimer_hide', false);
				}
			});

            // hide the cart
            $(document).delegate('.hide_cart', 'click', function(e) {

				mi.options.show_cart = false;
                //mi._hasCartChange();

                e.preventDefault();
				closeOpenDialog();
				/** */
				try{
					var has_popup = ($(e.target).data('popup')) ? $(e.target).data('popup') : null;
					var popup_anim = ($(e.target).data('animation')) ? $(e.target).data('animation') : 'top';
					let disclaimerFlag = localStorage.getItem('sgw_shop_cart_disclaimer_hide');
					if(has_popup && !disclaimerFlag){
						loadModal('#' + has_popup, popup_anim);

					}else{

						closeOpenDialog(); //modalHide();
						mi._triggerEvent("showShopPurchasePage");
					}
				}catch(error){
					addToConsole(error)

					closeOpenDialog(); //modalHide();

					mi._triggerEvent("showShopPurchasePage");
				}
            });


            // login
            $(document).delegate('.gotologin', 'click', function(e) {

                e.preventDefault();
                location.href = LOGIN_PAGE_URL;

            });

            $(document).delegate('.gotoCrossfire', 'click', function(e) {

                e.preventDefault();
                location.href = window.location.origin;

            });

            // get some money
            $(document).delegate('.gotodeposit', 'click', function(e) {

                e.preventDefault();
                //location.href = DEPOSIT_PAGE_URL;
				window.open(
				  DEPOSIT_PAGE_URL,
				  '_blank'
				);

            });

            // reload page
            $(document).delegate('.success', 'click', function(e) {

                e.preventDefault();
                window.location.href = 'https://' + window.location.hostname + window.location.pathname;

            });

            // Cart clear event
			$(document).delegate('.sc-cart-clear', 'click', function(e) {
                if ($(this).hasClass('disabled')) {
                    return false;
                }
                e.preventDefault();
                $('.sc-cart-item-list > .sc-cart-item', this.cart_element).fadeOut("normal", function () {
                    $(this).remove();
                    mi._clearCart();
                    mi._hasCartChange();
                });
            });

            // Item remove event  cart-item-ui-remove
			$(document).delegate('.sc-cart-remove', "click", function (e) {

                e.preventDefault();
                $(this).parents('.sc-cart-item').fadeOut("normal", function () {

					var my_temp_unique_key = $(this).data('unique-key');

					addToConsole('remove item clicked for: ' + my_temp_unique_key);

					let p = mi._getCartItembyID(my_temp_unique_key);
					mi._triggerEvent("quantityUpdated", [p, 0]);

					mi._removeFromCart(my_temp_unique_key);
                    mi._updateCartQuantity(my_temp_unique_key, 0);

                    $(this).remove();
                    mi._hasCartChange();
                });
            });

            // Capture add to cart button events
            $(document).delegate(this.options.addCartSelector, "click", function (e) {

                e.preventDefault();
				closeOpenDialog(); //modalHide();

                if ($(this).hasClass('disabled') || $(this).hasClass('locked')) {
                    return false;
                }

				mi.options.lastProccessedItemID = $(this).data('item_id');

				addToConsole($(this).data());
				addToConsole($(this).data('item_id') + ' is being added to the cart');

				var p = mi._getProductDetails($(this));
				addToConsole(p);

				var currentCartIDs = mi._getCartUniqueITEM_IDs();

				addToConsole(currentCartIDs);

				// do a quick check to limit unique items

				if (mi.options.MaxUniqueItems !== 'undefined') {

					var countofUniqueItems = (Array.isArray(currentCartIDs) && currentCartIDs.length) ? currentCartIDs.length : 0;

					if(countofUniqueItems && countofUniqueItems >= parseInt(mi.options.MaxUniqueItems,10)){
						addToConsole(currentCartIDs + ' is more than max allowed');
						mi._showMessage({'result': -703, 'APImessage': cartUniqueLimit});
						return false;
					}
				}

				if(mi._checkItemConditions(p)){

					var myITEM_ID = parseInt(p.ITEM_ID,10);

					//p.QUANTITY = 1;

					addToConsole('p = mi._addToCart(p);')
					p = mi._addToCart(p,1);

					if(p){
						try{
							// visual display off added item
							addToConsole('show toast pops')
							toastPopover();
							//closeOpenDialog();
						}catch(e){}

					}else{
						addToConsole('there is no product after addToCart: why? it failed ._addToCart')
					}
				}else{
					// clear cart of p

					addToConsole('mi._checkItemConditions(p) returned false: could not add to cart');
				}

            });

            // Item quantity change event
			$(document).delegate('.sc-cart-item-qty', "change", function (e) {
                e.preventDefault();

				const previousQtyInputValue = this.oldvalue;
				var myElem = $(this);
				var myitemID = $(this).parents('.sc-cart-item').data('unique-key');
				var p = mi.options._saleProducts[myitemID];
				mi.options.lastProccessedItemID = myitemID;

				addToConsole(p);
				const previousQtyValue = parseInt(p.QUANTITY,10);

				addToConsole('previousQtyValue: ' + previousQtyValue + ' previousQtyInputValue: ' + previousQtyInputValue);
				addToConsole('previousQtyValue from p is no good wah: ' + previousQtyValue + ' previousQtyInputValue: ' + previousQtyInputValue);

				var currentCartIDs = mi._getCartUniqueITEM_IDs();

				addToConsole(currentCartIDs);

				// do a quick check to limit unique items

				if (mi.options.MaxUniqueItems !== 'undefined') {

					var countofUniqueItems = (Array.isArray(currentCartIDs) && currentCartIDs.length) ? currentCartIDs.length : 0;

					if(countofUniqueItems &&  countofUniqueItems >= parseInt(mi.options.MaxUniqueItems,10)){
						addToConsole(currentCartIDs + ' is more than max allowed');
						mi._showMessage({'result': -703, 'APImessage': cartUniqueLimit});
						return false;
					}
				}

				if(mi._checkItemConditions(p)){

					var curVal = mi._getContent(myElem);

					addToConsole('previous quantity: ' + previousQtyInputValue + ' new Val: ' + parseInt(curVal,10) + ' isNum: ' + (curVal == parseInt(curVal, 10)))

					if(!(curVal == parseInt(curVal, 10))){
						myElem.val(previousQtyInputValue);

						// refresh everything
						mi._hasCartChange();

						return;
					}else{
						curVal = parseInt(curVal,10);

						if(0 == curVal){

							mi._triggerEvent("quantityUpdated", [p, 0]);
							mi._removeFromCart($(this).parents('.sc-cart-item').data('unique-key'));
							myElem.parents('.sc-cart-item').remove();
						}
					}

					addToConsole('change qty: ' + curVal);

					if(curVal - 0){

						//mi._triggerEvent("quantityUpdated", [mi.cart[i], qty]);

						let p = mi._getCartItembyID($(this).parents('.sc-cart-item').data('unique-key'));

						if(mi._checkRestrictions(p, curVal)){
							mi._triggerEvent("quantityUpdated", [p, curVal]);
							//mi._updateCartQuantity($(this).parents('.sc-cart-item').data('unique-key'), curVal);
						}else{
							addToConsole('.sc-cart-item-qty failed and there should have been an error message')
							addToConsole('previous quantity used because of fail: ' + previousQtyInputValue)
							myElem.val(previousQtyInputValue);
							//mi._refreshCartDisplayTotals();
						}

					}else{
						mi._removeFromCart($(this).parents('.sc-cart-item').data('unique-key'));
						myElem.parents('.sc-cart-item').remove();
					}
					mi._hasCartChange();

				}else{
						// refresh everything
						mi._hasCartChange();
				}
            });

            // Item quantity change event
			$(document).delegate('.sc-plus-item', "click", function (e) {
                e.preventDefault();

                if ($(this).hasClass('disabled') || $(this).hasClass('locked')) {
                    return false;
                }

				var currentCartIDs = mi._getCartUniqueITEM_IDs();

				addToConsole(currentCartIDs);

				// do a quick check to limit unique items

				if (mi.options.MaxUniqueItems !== 'undefined') {

					var countofUniqueItems = (Array.isArray(currentCartIDs) && currentCartIDs.length) ? currentCartIDs.length : 0;

					if(countofUniqueItems &&  countofUniqueItems >= parseInt(mi.options.MaxUniqueItems,10)){
						addToConsole(currentCartIDs + ' is more than max allowed');
						mi._showMessage({'result': -703, 'APImessage': cartUniqueLimit});
						return false;
					}
				}

				var curVal = mi._getContent($(this).prev().find('.sc-cart-item-qty'));

				addToConsole('plus change qty: ' + curVal);

				var myITEM_ID = $(this).parents('.sc-cart-item').data('unique-key');
				mi.options.lastProccessedItemID = myITEM_ID;

                var newVal = curVal;
                newVal = (newVal-0) + 1;

				let p = mi.options._saleProducts[myITEM_ID];
				addToConsole(p);

				if(mi._checkItemConditions(p)){

					let p = mi._getCartItembyID(myITEM_ID);

					if(mi._checkRestrictions(p, newVal)){
						mi._triggerEvent("quantityUpdated", [p, newVal]);
						//mi._updateCartQuantity($(this).parents('.sc-cart-item').data('unique-key'), curVal);
					}else{
						addToConsole('.sc-plus-item failed and there should have been an error message')
					}

				}else{

				}
            });

            // Item quantity change event
			$(document).delegate('.sc-minus-item', "click", function (e) {
                e.preventDefault();

                if ($(this).hasClass('disabled') || $(this).hasClass('locked')) {
                    return false;
                }

				var curVal = mi._getContent($(this).next().find('.sc-cart-item-qty'));

				addToConsole('current minus qty: ' + curVal);

				var myITEM_ID = $(this).parents('.sc-cart-item').data('unique-key');
				mi.options.lastProccessedItemID = myITEM_ID;

				let p = mi.options._saleProducts[myITEM_ID];

                var newVal = curVal;
                if(newVal - 1){

					mi._triggerEvent("quantityUpdated", [p, (newVal-1)]);
                    //mi._updateCartQuantity(myITEM_ID, (newVal-1));

                }else{

					addToConsole('remove item via minus click for: ' + myITEM_ID);

					mi._triggerEvent("quantityUpdated", [p, 0]);

					mi._removeFromCart(myITEM_ID);

                    $(this).parents('.sc-cart-item').remove();

					mi._hasCartChange();

				}

                //mi._hasCartChange();
            });


            // Cart checkout event
			$(document).delegate('.sc-cart-checkout, #btn-checkout', 'click', function(e) {
            //$(this.cart_element).on("click", '.sc-cart-checkout, #btn-checkout', function (e) {

                if ($(this).hasClass('disabled')) {
                    return false;
                }
                e.preventDefault();

				modalHide();

				mi._Z8Games_balanceCheck(
					function(){mi._confirmCart();},
					function(result){mi._Z8Games_exception(result);}
				);

            });

        },

		_registerTimeLimitedItem: function(ITEM_ID, seconds_remaining){

			var mi = this;

			addToConsole('registering removal of ITEM_ID: ' + ITEM_ID + ' after ' + seconds_remaining + ' seconds');

			if(parseInt(seconds_remaining,10)){
				let myIntervalId = setInterval(function(){
					seconds_remaining-=1;
					if(seconds_remaining <= 0){
						try{
							mi._removeFromCart(ITEM_ID);
							mi._removeItem(ITEM_ID);
							clearInterval(myIntervalId);
						}catch(e){
							// refresh page just in case?
						}
					}
				}, 1000);
			}else{
				try{
					mi._removeFromCart(ITEM_ID);
					mi._removeItem(ITEM_ID);
				}catch(e){
					// refresh page just in case?
				}
			}
		},

		_calcDiscountPercentage: function (top, bottom){

			let mi = this;
			if(parseInt(mi.options.discount,10)){
				return mi.options.discount;
			}else{
				return (100 - ((top/bottom) * 100)).toFixed(0);
			}
		},

		_createPriceDivElements: function (item, buttonFlag = true){

			let mi = this;
			let priceDiv, discountString, buttonText = '';

			const ITEM_ID = item.ITEM_ID;
			const PRICE = item.PRICE;
			const REGPRICE = item.ORIGINAL_PRICE;
			const currency = item.CURRENCY;
			const limitedItem = (-1 !== ((item.ITEM_CATEGORY).toLowerCase()).indexOf('limit')) ? true : false;

			buttonText = buttonFlag ? '<button class="card_button button-add sc-add-to-cart" data-id="'+ ITEM_ID +'" data-ITEM_ID="'+ ITEM_ID +'"><span>' + add_to_cart_text + '</span></button>' : '';

			if(REGPRICE && PRICE < REGPRICE){
                discountString = '<div class="price_discount price_discount_' + ITEM_ID + '">' + mi._calcDiscountPercentage(PRICE,REGPRICE) +'%</div>';
                priceDiv = '<div class="price_listed price_listed_' + ITEM_ID + '" data-original-price="' + addCommas(REGPRICE) + ' ' + currency + '">' + addCommas(PRICE) + ' ' + currency + '</div>';

            }else{
                discountString = (!limitedItem && ('BLACKFRIDAY' == mi.options.shop_type || 'BOXINGWEEK' == mi.options.shop_type)) ? '<div class="price_discount price_discount_' + ITEM_ID + '" style="display: none;"></div>' : '';
                if(PRICE){
                    priceDiv = '<div class="price_listed price_listed_' + ITEM_ID + '">' + addCommas(PRICE) + ' ' + currency + '</div>';
                }else{
                    priceDiv = '<div class="price_listed price_listed_' + ITEM_ID + '">' + free_item_text + '</div>';
                }
            }

			var carUIElems = [
				'    <div class="card_ui">'
				,       discountString
				,       priceDiv
				, 		buttonText
				,'    </div>'
			];

			return carUIElems.join('');
		},

		/**
		*
		*	Preload the cart API call
        *
		*/
		_preloadCart: function() {
			var mi = this;
			var result;

			addToConsole(' -- preloading cart --');

			let command = ('VIPSKINSALE' === mi.options.shop_type) ? 'getvipcart' :'getcfshopcart';

            var data = {
                'command': command
				,'event': mi.options.shop_type
				,'event_id' : mi.options.shop_event_id
            };

            $.ajax({
                data: data,
                type: 'get',
                url: webshopAPI,
                success: function(result) {

                    // set the preload flag so that we do NOT save it in the cart again
                    mi.options.preload_action = true;

					// show the coupon? even if the user hasn't added anything to their cart?
					addToConsole(result)

                    if(result.APIresult === "000")
                    {
						// update coupon image if reimbursed

						if(result.discountcard && result.discountcard[0] ){

							mi.options.couponReimbursed = result.discountcard[0].used;
							mi._displayCoupon();
						}
					}


                    if(result.APIresult === "000" && result.cart)
                    {
						// update coupon image if reimbursed

						if(result.discountcard && result.discountcard[0] ){

							mi.options.couponReimbursed = result.discountcard[0].used;
							mi._displayCoupon();
						}

						// update progress bar if reward has been claimed

						if(result.receivedbonusitem ){


							mi.options.rewardWon = result.receivedbonusitem;

							if(mi.options.rewardWon && mi.options.rewardWon.length && (typeof updateBonuses === "function")){

								addToConsole('received bonus');
								addToConsole(result.receivedbonusitem);

								updateBonuses(result.receivedbonusitem);
							}
						}

						addToConsole('got cart data so we load it');
						//('.cart_wrapper').html(result.cart)
						mi._loadCartItems(result.cart);

                    }else{
                        // nothing in your cart

                        // possibly tell the player to log in!!!!

						addToConsole('did not find a previous cart for user');

                    }

                    // update the preload flag so that we CAN save it in the cart again
                    mi.options.preload_action = false;
                },
                fail: function(result) {
                    // nothing in your cart, or took too long
                    addToConsole('could not get cart.');

					//mi._Z8Games_exception({'APIresult': '612', 'message': 'not signed in'});
					mi._Z8Games_exception({'APIresult': result.APIresult, 'message': result.APImessage});

                    //mi._loadCartItems(window.customerCart);
                },
				complete: function(result){
					mi._triggerEvent("cartListRetrieved");
				}

            });
		},
		/**
		 *
		 * Update the user's cart with specifics from the user's inventory
		 *
		 */
		_userInventoryCheck(){
			var mi = this;

			addToConsole(' -- _userInventoryCheck start --');

            var data = {
                'command': 'checkcfshopcart'
				,'event': mi.options.shop_type
            };

            $.ajax({
                data: data,
                type: 'get',
                url: webshopAPI,
                success: function(result) {

					addToConsole(result)

                    if(result.APIresult === "000" && 0 == result.p_o_ErrID && result.items)
                    {

						//addToConsole(result.items);

						/**
						"items": [
							{
								"ITEM_ID": "3000200601",
								"EXISTS_CNT": 1
							}
						],
						 */

						// update the cart
						$.each(result.items, function(i, item) {

							//(mi.cart).find(cartItem => cartItem.ITEM_ID == item.ITEM_ID)

							// update the user inventory

							let tempITEM_ID = parseInt(item.ITEM_ID,10);
							let tempCount = parseInt(item.EXISTS_CNT,10);

							mi.options.userInventory[tempITEM_ID] = item;
							mi.options.userInventory[tempITEM_ID].EXISTS_CNT = tempCount;

							// update the cart EXISTS_CNT (even though I do not believe it is used)
							(mi.cart).find((cartItem, index) => {

								if (cartItem.ITEM_ID == item.ITEM_ID) {
									cartItem.EXISTS_CNT = item.EXISTS_CNT;

									addToConsole(item.ITEM_ID + ' EXISTS_CNT in cart updated with ' + cartItem.EXISTS_CNT);

								}
							});

							// update the internal sale object if it has restrictions
							if(mi.options._saleProducts[tempITEM_ID] && mi.options._saleProducts[tempITEM_ID].RESTRICTIONS){

								mi.options._saleProducts[tempITEM_ID].EXISTS_CNT = item.EXISTS_CNT;

								//we could optionally update the USER_LIMIT
								//mi.options._saleProducts[ITEM_ID].LIMIT_PER_USER = (mi.options._saleProducts[item.ITEM_ID].RESTRICTIONS - 0) - item.EXISTS_CNT;
							}

						});
					}
				},
                fail: function(result) {
                    // nothing in your cart, or took too long
                    addToConsole('could not complete user inventory check.');
                }
            });

			addToConsole('_userInventoryCheck is complete');

			if(mi.options.debug){
				window.RAWUserInventory = mi.options.userInventory;
			}

		},
		/**
		 *
		 * Load the current user's cart into memory (this.cart)
		 * We are going to assume that quantities are NOT incorrect
		 * There is a secondary test in another function for quantity correctness -> mi._userInventoryCheck();
		 *
		 */
		_loadCartItems: function (customerCart){

			addToConsole('-START- _loadCartItems');
			let mi = this;

			let cartChanged = false;

			$.each(customerCart, function(i, item) {

				addToConsole('-START- load');
				addToConsole(item);

				try {

					let cartSavedQuantity = parseInt(item.QUANTITY,10);

					// use item from _saleProducts
					let newCartItem = mi.options._saleProducts[parseInt(item.ITEM_ID,10)];

					newCartItem.QUANTITY = cartSavedQuantity;

					addToConsole('-START- preload: ' + newCartItem.ITEM_ID);
					addToConsole(newCartItem);

					//var p = mi._addToCart(item);
					var p = mi._preloadToCart(newCartItem);

					if(p){
						addToConsole('-- preload cart uniqueID: ' + p.unique_key + ' item in DOM: ' + newCartItem.ITEM_ID);
					 /*
						// now update the quantity
						if(item.QUANTITY > 1){
							mi._updateCartQuantity(p.unique_key, item.QUANTITY);
							addToConsole('-- preload cart uniqueID: ' + p.unique_key + ' item in DOM: ' + item.ITEM_ID);
						}
					//*/

						/**/
						// it is possible that a user has put an item in their cart that is now sold out
						// we 'should' remove it, but we should let LP decide
						// if we leave it, the user 'should' not be allowed to increase the quantity

						if(parseInt(newCartItem.REMAINING_PRECENTAGE,10) && newCartItem.REMAINING_PRECENTAGE <= 0){

							mi._logMessage('outputting a show message at _loadCartItems');
							mi._showMessage({'result': "824", 'APImessage': webshop_msg_824, 'ITEM_ID': newCartItem.ITEM_ID});

							//mi._removeFromCart(item.ITEM_ID);	// does too much
							//mi._updateCartQuantity(item.ITEM_ID, 0);	// does too much
							//mi._updateCartItem(item.ITEM_ID, 0, function(){}, function(){});
							//return false;
						}else{
							cartChanged = true;
						}

						// */

					}else{

						// it is possible that a user has put an item in their cart that is no longer part of the sale
						// we 'should' remove it

						addToConsole('not added to cart')
						addToConsole(item)

						mi._updateCartItem(item.ITEM_ID, 0, function(){
							addToConsole('removed missing save cart item: ' + item.ITEM_ID);
						}, function(){
							addToConsole('could not remove missing save cart item: ' + item.ITEM_ID);
						});
					}
				}catch(e){

					// it is possible that a user has put an item in their cart that is no longer part of the sale
					// we 'should' remove it

					addToConsole('-ERROR- preload: not added to cart')
					addToConsole(item)

					mi._updateCartItem(item.ITEM_ID, 0, function(){
						addToConsole('removed missing save cart item: ' + item.ITEM_ID);
					}, function(){
						addToConsole('could not remove missing save cart item: ' + item.ITEM_ID);
					});

					addToConsole(e.message);
					mi._logError(e.message);
				}
			});

			// double check items
			if('CFSHOP' == mi.options.shop_type){
				//vvip skin sale has completed this with refreshlist (which gets user)
				mi._userInventoryCheck();
			}

			//if(this.options.show_cart){
			mi._renderCart();
			//}

			addToConsole('_loadCartItems is complete');
			if(cartChanged){
				mi._hasCartChange();
			}

		},

		_renderBanners: function(bannerObj){

			var mi = this;
			var bannerCount = 0;

			$.each(bannerObj, function(id, banner) {

				if(banner && banner.IMG_URL){

					let headerArr = [];
					let webButton = null;
					let timerDiv = null;

					if(banner.WEBSITE_URL){
						var text = (banner.TAG_DIRECTION) ? banner.TAG_DIRECTION : null;
						if(text){
							webButton = '<a target="_blank" href="' + banner.WEBSITE_URL + '"><button><span> ' + text + '</span></button></a>';
						}
					}

					if(banner.PREVIEW && banner.END_DATE){
						timerDiv = '<div class="timer" id="myBannerTimer" data-date="' + banner.END_DATE + '" data-range="dhms" aria-label="Countdown Timer"></div>'
					}

					if(webButton || timerDiv){
						headerArr = [
							'<div class="header_ui">'
							,	webButton
							,	timerDiv
							,'</div>'
						];
					}

					let stringArr = [
						'<div id="banner_' +  id +'" class="header_banner">'
						,' <picture>'
						,	'<source media="(max-width: 600px)" srcset="' +  banner.TAG_TEXT_COLOUR +'" width="600px" height="695px">'
						,	'<source media="(max-width: 960px)" srcset="' +  banner.BANNER_TEXT +'" width="960px" height="540px">'
						,	'<source media="(max-width: 1420px)" srcset="' + banner.THUMB_URL  +'" width="1420px" height="600px">'
						,	'<img src="' +  banner.IMG_URL +'" width="1920px" height="800px">'
						,' </picture>'
						, headerArr.join('')
						,'</div>'
					];

					$('.bannerDyanmicInputSpot').append(stringArr.join(''));

					// update meta property
					// <meta property="og:image"
					bannerCount++;
				}
			});

			if(bannerCount > 1){
				$('.bannerDyanmicInputSpot').attr('data-autoplay', 1);
				$('.bannerDyanmicInputSpot').addClass('carousel');
			}else{
				//$('.bannerDyanmicInputSpot').removeClass('carousel');
			}

			addToConsole('banners render complete');
		},

		/**
		 *
		 * Populate the DOM with the user's cart (given from DB acquired user session)
		 *
         * Display a list of all items in the cart by currency
         */
        _renderCart: function() {

            var mi = this;

			$('.sc-cart-item-list').empty();

			// hide all currencies
			$('.checkout_list').hide();

			// hide checkout
			$('.checkout_table').hide();

			// hide error div
			$(".emptycart").hide();

			let priceDiv = '';
			let extendedDescription = '';
			let productAmount = '';
			let imageString = '';
			let imgDimensions = 'width="540" height="400"';
			let  newPrice = '';
			let iconTypeString = '';
			let iconType = '';
			let iconVIPClass = '';
			let possesionDiv = '';

			let cartSavings = 0;
			let subTotalvalue = 0;
			let regTotalvalue = 0;

			var cartList = [];

            //var cartListElement = $('.sc-cart-item-list', this.cart_element);
            var elmMain = '';

            addToConsole('_renderCart start');
			//addToConsole(mi.cart);

            if(mi.options.currencySettings.accepted){
                addToConsole(mi.options.currencySettings.accepted);

                $.each(mi.options.currencySettings.accepted, function (i, currency) {

                    cartList.push(currency);
					cartList[currency] = [];
					cartList[currency].count = 0;
                    // loop through cart for currency
                    // add list of items in that currency
                    // show a subtotal of that currency

					var currency_lc = currency.toLowerCase();

                    var itemCount = 0;
                    $.each(mi.cart, function (k, p) {

						// verify that this is a populated sales product
						let p_details = mi.options._saleProducts[p.ITEM_ID];

						iconTypeString = '';
						iconVIPClass = '';

						if('CFSHOP' !== mi.options.shop_type){
							//possesionDiv = '<div class="details_counter owned_' + p.ITEM_ID + '">' + ownedText + ':&nbsp;<span class="defaultamount">' + p.EXISTS_CNT + '</span></div>';
						}

                        if (mi._getValidateNumber(p_details.PRICE)) {  //  && p.CURRENCY == currency -- not necessary for Boxing Week/Black Friday

                            priceDiv = mi._createPriceDivElements(p_details, false);

                            extendedDescription = (p_details.SHORT_DESCRIPTION) ? '<span class="card_label_sub">&nbsp;&mdash;&nbsp;' + p_details.SHORT_DESCRIPTION + '</span>' : '';

							newPrice = (p_details.DISCOUNTPRICE) ? p_details.DISCOUNTPRICE : p_details.PRICE;

							productAmount = (p[mi.options.paramSettings.productQuantity] - 0) * (newPrice - 0);

                            imageString = '<figure class="cart_image"><img ' + imgDimensions + ' loading="lazy" src="' + p_details.IMG_URL + '" /></figure>' + iconTypeString;

							try{
								if('CRATE' == p_details.CART_TYPE){
									possesionDiv = '';
								}
							}catch(e){}

                            var labelandPriceString = [
                                '	<div class="cart_label">'
                                ,'    <div class="card_label">'
                                ,'        <p class="card_label_main">' + p_details.ITEM_NAME + extendedDescription + '</p>'
                                ,'    </div>'
                                ,	  priceDiv
								,	  possesionDiv
                                ,'  </div>'
                            ].join('');

                            var cartControlString = [
                                '	<div class="cart_control">'
                                ,'    <button class="icon cfshop-icon-delete cart_delete sc-cart-remove">' + removeText + '</button>'
                                ,'    <div class="cart_quantity">'
                                ,'		<button class="quantity_sub sc-minus-item">-</button>'
                                ,'		<div class="quantity_counter"><input type="number" onfocus="this.oldvalue = this.value;" class="sc-cart-item-qty" id="item_qty_' + p.ITEM_ID +'" name="item_qty_' + p.ITEM_ID +'" value="' + mi._getValueOrEmpty(p[mi.options.paramSettings.productQuantity]) + '" step="1" maxlength="2" /></div>'
                                ,'		<button class="quantity_add sc-plus-item">+</button>'
                                ,'    </div>'
                                ,'  </div>'
                            ].join('');

                            var pricingString = [
                                '<div class="cart_price sc-cart-item-amount">'
                                ,'	<p>' + mi._getMoneyFormatted(productAmount) + ' ' + currency +'</p>'
                                ,'</div>'
                            ].join('');

                            var cartItemElement = '<div id="_cart_item_' + p_details.ITEM_ID + '" class="cart_item sc-cart-item" data-unique-key="' + p_details.ITEM_ID + '">'
                                                    + imageString
                                                    + labelandPriceString
                                                    + cartControlString
                                                    + pricingString
                                                + '</div>';

                            cartList[currency].push(cartItemElement);

							if(null !== mi.options.cartCountType && 'unique' == mi.options.cartCountType){
								itemCount++;
							}else{
								itemCount += (p[mi.options.paramSettings.productQuantity] - 0);
							}

							//addToConsole(cartList[currency]);
                        }else{
							addToConsole(p);
							addToConsole(currency + ' ' + p_details.CURRENCY + ' ' + (p_details.CURRENCY === currency))
							addToConsole(p.ITEM_ID + ': invalid price or currency with this preload item'); //, probably a difference in the currency I was looking for)
						}

                    });

					cartSavings = mi._getCartSavingsbyCurrency(currency);
					subTotalvalue = mi._getSubTotalbyCurrency(currency);
					regTotalvalue = mi._getRegTotalbyCurrency(currency);

                    addToConsole(currency + ' Sub Total: ' + subTotalvalue);
					addToConsole(currency + ' Savings: ' + cartSavings);

					//set class names so that we may update this dynamically
					// - .cart_subtotal_(zp|ep|mp)
					// - .cart_subtotal_(zp|ep|mp)_item_count
					// - .cart_total_(zp|ep|mp)_value

                    var subTotalString = [
                        '<div class="cart_subtotal cart_subtotal_' + currency_lc +'">'
                        ,'  <p class="icon cfshop-icon-' + currency_lc +' cart_subtotal_' + currency_lc +'_item_count">' + subtotal + ' (' + itemCount + ' ' + itemsText + ')</p>'
                        ,'  <p class="cart_total cart_total_' + currency_lc +'_value">' + addCommas(subTotalvalue) + ' ' + currency + '</p>'
                        ,'</div>'

                    ].join('');

					//addToConsole(subTotalString);

                    cartList[currency].push(subTotalString);
					cartList[currency].count = itemCount;

					// Update Totals Display
					if(cartList[currency].count){

						var myCurrencyContainerElem = $('.' + currency_lc + '_checkout_data');
						var myCurrencySubTotalElem = $('.' + currency_lc + '_sub_total');
						var myCurrencyTotalElem = $('.' + currency_lc + '_final_total');
						var myCurrencySavingsElem = $('.' + currency_lc + '_bonus_total');

						// updated by _Z8Games_balanceCheck
						// var myCurrencyBalanceElem = $('.my_' + currency_lc + '_balance');
						var myCurrencyRemainingElem = $('.my_' + currency_lc + '_remaining');

						var currentCurrenyBalance = (mi.options['my' + currency + 'Balance']) ? mi.options['my' + currency + 'Balance'] : 0;
						var balance = currentCurrenyBalance - subTotalvalue;

						if(balance < 0){
							// show deposit or err warning
						}

						myCurrencyTotalElem.text(addCommas(subTotalvalue) + ' ' + currency);
						myCurrencySubTotalElem.text(addCommas(regTotalvalue) + ' ' + currency);
						myCurrencyRemainingElem.text(addCommas(balance) + ' ' + currency);
						myCurrencyContainerElem.show();


						if(cartSavings > 0){
							myCurrencySavingsElem.text(addCommas(cartSavings) + ' ' + currency);
							myCurrencySavingsElem.parent().parent().show();
						}else{
							myCurrencySavingsElem.text('0 ' + currency);
							myCurrencySavingsElem.parent().parent().hide();
						}

						$('.checkout_table').show();
					}
                });

                $.each(cartList, function (i, currency) {
					if(cartList[currency].count){
						//addToConsole(cartList[currency]);
						$('.sc-cart-item-list').append(cartList[currency]);
					}

                });

            }else{

				addToConsole('No currencies initiated');
                addToConsole('no currencies were initiated in currencySettings');

                // show empty cart message
				$(".emptycart").show();
            }

			$('.checkout_table').show();

			mi.options.cartRenderComplete = true;

			// determine if cart items were displayed
			if($('.checkout_table').is(":hidden")){

                // show empty cart message
				//$(".emptycart").show();
			}

			mi._displayCheckoutErrors();

			if(!mi.cart.length){
                // show empty cart message
				$(".emptycart").show();
				$('.checkout_table').show();

				mi.options.cartRenderComplete = true;

			}

			addToConsole('_renderCart is complete');
			if(mi.options.debug){
				window.RAWSaleItems = mi.options._saleProducts;
			}

        },

		/**
		 * Update the subtotals and balances
		 *  This function truly does the same work as _renderCart. But I'll keep it for now.
		 */
		_refreshCartDisplayTotals: function(){

			var mi = this;
			addToConsole(' -- _refreshCartDisplayTotals -- start');
			addToConsole(mi.options.currencySettings.accepted);

			$.each(mi.options.currencySettings.accepted, function (i, currency) {

				var currency_lc = currency.toLowerCase();

				var itemCount = 0;
				$.each(mi.cart, function (k, p) {

					// verify that this is a populated sales product
					var p_details = mi.options._saleProducts[p.ITEM_ID];

					//addToConsole(' -- _refreshCartDisplayTotals -- $.each: ' + k);
					//addToConsole(p);

					if (mi._getValidateNumber(p_details.PRICE)){ //  && p.CURRENCY && p.CURRENCY === currency) { -- not necessary for Black Friday/Boxing Week

						if(null !== mi.options.cartCountType && 'unique' == mi.options.cartCountType){
							itemCount++;
						}else{
							itemCount += (p[mi.options.paramSettings.productQuantity] - 0);
						}
					}else{
						addToConsole('_refreshCartDisplayTotals ' + p.ITEM_ID + ' is invalid with no price: ' )
					}
				});

				var cartSavings = mi._getCartSavingsbyCurrency(currency);
				var subTotalvalue = mi._getSubTotalbyCurrency(currency);
				var regTotalvalue = mi._getRegTotalbyCurrency(currency);

				addToConsole(currency + ' _refreshCartDisplayTotals  Sub Total: ' + subTotalvalue);
				addToConsole(currency + ' _refreshCartDisplayTotals Savings: ' + cartSavings);
				addToConsole(currency + ' _refreshCartDisplayTotals Sub Total: ' + subTotalvalue);

				// Update Totals Display
				if(itemCount){

					addToConsole('updating DOM item count')

					// update item count
					$('.cart_subtotal_' + currency_lc +'_item_count').text(subtotal + ' (' + itemCount + ' ' + itemsText + ')');

					// update subtotal cost
					$('.cart_total_' + currency_lc +'_value').text(addCommas(subTotalvalue) + ' ' + currency);

					var myCurrencyContainerElem = $('.' + currency_lc + '_checkout_data');
					var myCurrencySubTotalElem = $('.' + currency_lc + '_sub_total');
					var myCurrencyTotalElem = $('.' + currency_lc + '_final_total');

					var myCurrencySavingsElem = $('.' + currency_lc + '_bonus_total');

					// updated by _Z8Games_balanceCheck
					// var myCurrencyBalanceElem = $('.my_' + currency_lc + '_balance');
					var myCurrencyRemainingElem = $('.my_' + currency_lc + '_remaining');

					var currentCurrenyBalance = (mi.options['my' + currency + 'Balance']) ? mi.options['my' + currency + 'Balance'] : 0;
					var balance = currentCurrenyBalance - subTotalvalue;

					if(balance < 0){
						// show deposit or err warning
					}

					myCurrencyTotalElem.text(addCommas(subTotalvalue) + ' ' + currency);
					myCurrencySubTotalElem.text(addCommas(regTotalvalue) + ' ' + currency);
					myCurrencyRemainingElem.text(addCommas(balance) + ' ' + currency);
					myCurrencyContainerElem.show();

					if(cartSavings > 0){

						myCurrencySavingsElem.text(addCommas(cartSavings) + ' ' + currency);
						myCurrencySavingsElem.parent().parent().show();
					}else{
						myCurrencySavingsElem.text('0' + currency);
						myCurrencySavingsElem.parent().parent().hide();
					}

					$('.checkout_table').show();
				}
			});

			addToConsole(' -- _refreshCartDisplayTotals -- end');
		},
