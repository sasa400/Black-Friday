						message = webshop_msg_709;
						actionVerb = "cancel";
						actionText = continueShoppingActionText;
				} break;
				case "-719" : case -719 : case "719" : case 719 :{
						title = general_error_title;
						message = webshop_msg_719;
						actionVerb = "cancel";
						actionText = continueShoppingActionText;
				} break;
				case "-705" : case -705 : case "705" : case 705 :{
						title = general_error_title;
						message = webshop_msg_705;
						actionVerb = "cancel";
						actionText = continueShoppingActionText;
				} break;
                case "-703" : case -703 : {
					title = itemLimitTitle;
					message = cartUniqueLimit.replace('xNumber', mi.options.MaxUniqueItems);
					actionVerb = "cancel";
					actionText = continueShoppingActionText;

                } break;
				case "-714" : case -714 : case "714" : case 714 : {
						title = general_error_title;
						message = webshop_msg_714;
						actionVerb = "cancel";
						actionText = continueShoppingActionText;
				} break;
				case "-791" : case -791 : case "791" : case 791 :{
						title = general_error_title;
						message = webshop_msg_791;
						actionVerb = "cancel";
						actionText = continueShoppingActionText;
				} break;
				case "792" : case 792 :{
						title = general_error_title;
						message = webshop_msg_792;
						actionVerb = "cancel";
						actionText = continueShoppingActionText;
				} break;
				case "793" : case 793 :{
						title = general_error_title;
						message = webshop_msg_793;
						actionVerb = "cancel";
						actionText = continueShoppingActionText;
				} break;
				case "100" : case 100 :{
						title = general_error_title;
						message = webshop_msg_100;
						actionVerb = "cancel";
						actionText = continueShoppingActionText;
				} break;
				case "101" : case 101 :{
						title = general_error_title;
						message = webshop_msg_101;
						actionVerb = "cancel";
						actionText = continueShoppingActionText;
				} break;
				case "102" : case 102 :{
						title = general_error_title;
						message = webshop_msg_102;
						actionVerb = "cancel";
						actionText = continueShoppingActionText;
				} break;
				case "103" : case 103 :{
						title = general_error_title;
						message = webshop_msg_103;
						actionVerb = "cancel";
						actionText = continueShoppingActionText;
				} break;

				case "-601" : {
					//event end

					title = general_error_title;
					message = expired_error_message;
					actionVerb = "gotoCrossfire";
					actionText = continueShoppingActionText;

				}
				break;

				case 604 :
				case "604" : {
					//event end

					title = general_error_title;
					message = webshop_msg_604;
					actionVerb = "cancel";
					actionText = continueShoppingActionText;

				}
				break;

				case 603 :
				case "603" : {
					//event end

					title = general_error_title;
					message = webshop_msg_603;
					actionVerb = "gotoCrossfire";
					actionText = continueShoppingActionText;

				}
				break;

				case 691 :
				case "691" : {
					//event end

					title = general_error_title;
					message = webshop_msg_691;
					actionVerb = "cancel";
					actionText = continueShoppingActionText;

				}
				break;

				case -702 :
				case "-702" : {
					//no character

					title = general_error_title;
					message = default_no_char_message;
					actionVerb = "gotoCrossfire";
					actionText = continueShoppingActionText;

				}
				break;

				case "672" : {
					//select limit error

					title = general_error_title;
					message = default_limit_message;
					actionVerb = "cancel";
					actionText = continueShoppingActionText;
				}
				break;

				case "673" : {
					//no item select

					title = general_error_title;
					message = no_mainitem_selected_message;
					actionVerb = "cancel";
					actionText = continueShoppingActionText;

				}
				break;

				//-1001 , -140 , -1381, -140
				default : {

					title = ('' == title ) ? general_error_title : title;
					message = ('' == message ) ? default_error_message : message;
					actionVerb = "cancel";
					actionText = continueShoppingActionText;
				}
				break;
			}
			mi._popUpGeneralMessage(title, message, actionVerb, actionText, itemID, code);
		},

		_Z8Games_balanceCheck: function (callback, callback_false) {

			var mi = this;

			var mybalanceAPI = balanceAPI;

			if('CFSHOP' !== mi.options.shop_type){
				mybalanceAPI = balanceAPI + "&callback=?"
			}

			addToConsole('Balance API calling: "' + mybalanceAPI);

			// Set Defaults (sorry, just easier)
			mi.options.myZPBalance = 0;
			mi.options.myEPBalance = 0;
			mi.options.vip_status = false;

			//console.table(mi.options);

			// updates the Shop Page
			$('#zp > span').text(addCommas(mi.options.myZPBalance));
			$('#ep > span').text(addCommas(mi.options.myEPBalance));

			// updates the Cart Page
			$('.my_zp_balance').text(addCommas(mi.options.myZPBalance) + ' ZP');
			$('.my_ep_balance').text(addCommas(mi.options.myEPBalance) + ' EP');
			//$('.my_mp_balance').text(addCommas(mi.options.myMPBalance) + ' MP');

			$.ajax({
				url: mybalanceAPI,
				type: 'GET',
				dataType: 'json',
				success: function(result) {
					addToConsole(result);

					result.apiresult = result.result?result.result:result.apiresult;
					result.returnValue = result.apiresult;

					if(result.status == 'false' || result.ZPBalance == 'Error'){

						mi.options.userSignedIn = false;
						mi.pleaseSignInMessage();

					}

					if(result.status == 'true' || result.apiresult == '000')
					{
						var myzpbalanceTest1 = (result.zp_balance !== 'undefined') ? result.zp_balance : null;
						var myzpbalanceTest2 = (result.ZPBalance !== 'undefined') ? result.ZPBalance : null;

						mi.options.myBalance = 0;
						mi.options.myEPBalance = 0;

						mi.options.myZPBalance = mi.options.myBalance;

						if(!result.zp_balance){
							// check another
							if(result.ZPBalance){
								mi.options.myBalance = parseInt(result.ZPBalance, 10);
								addToConsole('result.ZPBalance', parseInt(result.ZPBalance, 10));
							}
						}else{
							mi.options.myBalance = parseInt(result.zp_balance, 10);
							addToConsole('result.zp_balance', parseInt(result.zp_balance, 10));
						}

						mi.options.userSignedIn = true;

						mi.options.myZPBalance = mi.options.myBalance;
						mi.options.myEPBalance = (result.ep_balance ) ? parseInt(result.ep_balance) : 0;
						mi.options.vip_status = (result.vip_status) ? (2 == parseInt(result.vip_status)) : false;

						//console.table(mi.options);

						// updates the Shop Page
						$('#zp > span').text(addCommas(mi.options.myZPBalance));
						$('#ep > span').text(addCommas(mi.options.myEPBalance));

						// updates the Cart Page
						$('.my_zp_balance').text(addCommas(mi.options.myZPBalance) + ' ZP');
						$('.my_ep_balance').text(addCommas(mi.options.myEPBalance) + ' EP');
						//$('.my_mp_balance').text(addCommas(mi.options.myMPBalance) + ' MP');

						try{
							callback(result);
						}catch(e){
							//addToConsole(e.message);
							mi._logMessage(e.message);
						}
					} else {
						try{
							callback_false(result);
						}catch(e){
							mi._logMessage(e.message);
						}
					}
				},
				fail: function(result) {
					try{
						callback_false(result);
					}catch(e){
						mi._logMessage(e.message);
					}
				},
				error: function(result) {
					try{
						callback_false(result);
					}catch(e){
						mi._logMessage(e.message);
					}
				}
			});
		},

		_shopPageCalculatePagination: function(page=1, numItems){

			var mi = this;

			// remove active status
			$('button.page_number_button').removeClass('active');

			// remove all numbered page buttons
			$('button.page_number_button').remove();

			var pageLimit = mi.options.numItemsPerWebShopPage;

			page = ((typeof page !== 'undefined') && '' !== page) ? parseInt(page, 10) : 1;

			//<!--button class="pagination_button" data-page="2">2</button>

			var numPages = 1;
			var elementButton = '';
			var isActive = ''

			if(numItems && parseInt(numItems) && numItems > pageLimit){
				numPages = Math.ceil(numItems/pageLimit);

				for(var i=1;i<=numPages;i++){

					isActive = (page == i) ? ' active ' : '';

					elementButton = '<button class="pagination_button page_number_button ' + isActive + '" data-page="' + i + '">' + i + '</button>';
					$('.next_button').before(elementButton);

				}
			}

			// set prev and next buttons
			$('.prev_button').attr('data-page', ((page - 1) > 0) ? (page - 1) : 1 );
			$('.next_button').attr('data-page', ((page + 1) < numPages) ? (page + 1) : numPages);

		},

		_Z8Games_shopevent: function() {
			var mi = this;

			const webshopAPI = 'https://' + window.location.hostname + '/rest/webshopitems.json';

			var params = {
				'command' : 'getcfshopevent'
				,'event': mi.options.shop_type
				,'event_id' : mi.options.shop_event_id
			};

			addToConsole('_Z8Games_shopevent');
			addToConsole(params);

			// refresh by hiding error elements
			$(".errorDiv").hide();
			$(".error1").hide();
			$(".error601").hide();
			$(".error500").hide();
			$(".error404").hide();
			$(".error10").hide();

			$(".sc-product-item").remove();

			$.ajax({
				url: webshopAPI,
				type: 'GET',
				data: params,
				dataType: 'json', // added data type
				success: function(result) {

					//addToConsole(result);
					/*
					// Special Pages like Boxing/Black/VIP render from page. Everything else renders via JS
					//*/

					if(result.dsWebshopSaleFAQResult){
						mi._renderFaqs(result.dsWebshopSaleFAQResult);
					}

					if(result.dsWebshopSaleSubEventBannerResult){
						mi._renderSubEventBanners(result.dsWebshopSaleSubEventBannerResult);
					}

					// hopefuly soon to be result.dsWebshopSaleDiscountTiersResult
					// for BlackFriday and BoxingWeek
					if(DiscountTiers && DiscountTiers.length){
						mi.options.DiscountTiers = DiscountTiers;
						let subTotal = 0;
						mi.options.discount = mi._displayTierRewards(mi.options.DiscountTiers, subTotal);
					}

					// we need to update the global object first

					if(result && result.dsWebshopSaleResult && result.dsWebshopSaleItemTotal && result.dsWebshopSaleItemTotal[0] && result.dsWebshopSaleItemTotal[0].CNT){

						// we should have results


						// this object is simply easier to filter (and used in raw format for other features)
						//mi.options._RAWsaleProducts = result.dsWebshopSaleItemResult;
						// mi.options._saleProducts
						//mi.options._RAWsaleProducts = result.dsWebshopSaleItemResult;
						if(mi.options.debug){

							// so we can test it
							//window.RAWItems = result.dsWebshopSaleItemResult;
						}

						mi._renderShopItems(result.dsWebshopSaleItemResult);

						// set the date on the banner and/or add the faq
						if('CFSHOP' !== mi.options.shop_type && 'BOXINGWEEK' !== mi.options.shop_type){

							// add the faq
							$("#categoriesDropdown").append('<a class="categoryanchor" movetarget="faq" data-href="#faq" role="menuitem"><button class="nav_button" movetarget="faq">FAQ</button></a>');

						}


						if(mi.options.debug){
							//window.RAWSaleItems = mi.options._saleProducts;
						}

						if('CFSHOP' !== mi.options.shop_type){

							// get user ZP, and possessions and update list
							addToConsole('prepare to refresh list ')
							mi._triggerEvent("itemListRetrieved");

							// most sales usually have an end date
							// try to add an end date if countdown forgotten to add to the banner

							try{

								if(result && result.dsWebshopSaleResult && result.dsWebshopSaleResult[0].END_DATE){

									addToConsole(result.dsWebshopSaleResult[0].END_DATE);

									let timerContainer = $('header.container-grid .header_ui');
									addToConsole(timerContainer);

									let timerFound = timerContainer.find('.timer').length;
									addToConsole('Timer found: ' + timerFound);

									if(!timerFound){
										timerContainer.append('<div class="timer" id="myBannerTimer" data-date="' + (result.dsWebshopSaleResult[0].END_DATE).replace(".000","") + '" data-range="dhms" aria-label="Countdown Timer"></div>');
										initializeClock();
									}
								}

							}catch(e){
								addToConsole(e);
							}

						}else{
							addToConsole('prepare to preload the cart ')
							mi._triggerEvent("preloadCart");
						}

					}else{

						// some kind of error

						/*
						"p_o_ErrID": -201,
						"p_o_ErrID": -201,
						"APImessage": "OK",
						"APIresult": "000",
						"p_o_ErrDesc": "SALE SRL does not exists!"
						// */

						addToConsole(result);

						if(result && result.p_o_ErrID && -201 == result.p_o_ErrID){

							$('body').hide();
							// no current sale or expired
							window.location.href = 'https://' + window.location.hostname + '/error663.html';

						}else{

							addToConsole('some other kind of error')
							// some other kind of error
							//$('.container-grid').hide();

							if('CFSHOP' == mi.options.shop_type){
								// no items
								$(".errorDiv").show();
								$(".error1").show();
							}else{
								$(document).click(function() {
									location.href = window.location.origin;
								});
								mi._popUpGeneralMessage(general_error_title, '', "gotoCrossfire", continueShoppingActionText);

								window.location.href = 'https://' + window.location.hostname + '/error663.html';
							}
						}
					}


				},
				fail:function(result) {
					mi._Z8Games_exception(result);

					$(".errorDiv").show();
					$(".error500").show();
					mi._shopPageCalculatePagination(0,0);
				},
				complete:function(result) {
					//mi._discountLevelAmount();
					//mi._triggerEvent("showShopPurchasePage");

				}
			});


		},


        /**
         *
         * Get BF Attedance event redeemable item
         *
         */
		 _getBFAttendance: function(){

			addToConsole('getting attendance');

			var redeemFlag = false;
			var daysCompleted = 0; // 2;
			const hoursDiffMax = 24;
			var redeemTimeReached = false;
			var redeemableDate = null;
			var redeemableItem = null;
			var currentDate = null;
			var dateDiff = null;
			const finalDay = 5;

			var myStartDate = ((typeof attendanceStartDate !== 'undefined') && '' !== attendanceStartDate) ? attendanceStartDate : td;

            var mi = this;
            var data = {
                    'command': 'getattendance'
                }

            $.ajax({
                data: data,
                type: 'get',
                url: 'https://' + window.location.hostname +'/rest/blackfriday.json',
				success: function(result) {

					if(result.APIresult && result.APIresult === "000" && result.p_o_ErrID && result.p_o_ErrID === 1 && result.ds_BLACK_FRIDAY_ATTENDANCE_ITEM_LIST_Get)
					{
						addToConsole('found attendance redeemable item to display');
						addToConsole(result);

						// display redeemable item in the dom
						try{

							if(result.ds_BLACK_FRIDAY_ATTENDANCE_Result
								&& result.ds_BLACK_FRIDAY_ATTENDANCE_Result[0]
								&& result.ds_BLACK_FRIDAY_ATTENDANCE_Result[0].daysCompleted){

								addToConsole('this merc can redeem based on attendance. Days completed: ' + result.ds_BLACK_FRIDAY_ATTENDANCE_Result[0].daysCompleted);
								daysCompleted = result.ds_BLACK_FRIDAY_ATTENDANCE_Result[0].daysCompleted;

								currentDate = new Date(result.ds_BLACK_FRIDAY_ATTENDANCE_Result[0].currentDate);
								redeemFlag = true;
							}else{
								addToConsole('this merc can NOT redeem based on attendance');
							}


							// loop through list to show redeemable items

							// add to button -> $(this).attr('data-id');

							if(redeemFlag){

								$.each(result.ds_BLACK_FRIDAY_ATTENDANCE_ITEM_LIST_Get, function(i, item) {

									// check date
									// only display redeemable item for current day

									var maxHours = parseInt(item.DAYS_NEEDED,10) * hoursDiffMax;
									var minHours = (parseInt(item.DAYS_NEEDED,10) - 1) * hoursDiffMax;

									addToConsole('checking redeem dates for Day: ' + item.DAYS_NEEDED);
									//addToConsole('checking max redeem hours: ' + maxHours);
									//addToConsole('checking min redeem hours: ' + minHours);
									addToConsole('Attendance Start Date:' + myStartDate);
									addToConsole('Current Date:' + currentDate);

									// only check for lastRedeemable date
									if(item.CAN_REDEEM){
										redeemableDate = item.DAYS_NEEDED;
										redeemableItem = item;
									}else{

									}
								});

								if(redeemableDate){
									addToConsole('Display Redeem Day: ' + redeemableItem.DAYS_NEEDED);
									addRedeemableItem(redeemableItem, daysCompleted, redeemableItem.IS_REDEEMED);
								}else{
									addToConsole('Do NOT display Redeem Possibility');
								}

							}

						}catch(e){
							// could not display redeemable
							addToConsole('caught error: attendance redeemable item display ');
							addToConsole(e.message);
						}

					}else{
						addToConsole('no redeemable item to display');
						// pop up modal that there was an error attempting to redeem
					}
				},
				fail: function(result) {
					addToConsole('fail to find redeemable item to display');
				}
            });

			function addRedeemableItem(item, daysCompleted, redeemedStatus){

				let redeemButton = '';
				let id = parseInt(item.ITEM_ID,10);
				let extendedDescription = (item.SHORT_DESCRIPTION) ? '<span class="card_label_sub">&nbsp;&mdash;&nbsp;' + item.SHORT_DESCRIPTION + '</span>' : '';

				daysCompleted = parseInt(daysCompleted, 10);

				if(!item.IS_REDEEMED){
					redeemButton = '<button class="card_button claimBFEventItem" data-itemid="' + id + '" data-id="' + id + '" data-unique-key="' + id + '"><span>' + redeemText + '</span></button>';
				}

				let stringArr = [

									'<section class="breakout zone sgwz8_shop">'
									,'	<div class="limited-package">'
									,'		<div class="limited-package-heading"><h3>' + attendanceTitle + '</h3></div>'

									,'		<figure class="card_image">'
									,'			<img src="' + item.IMG_URL + '" alt="redeemable attendance reward">'
									,'		</figure>'

									,'		<div class="card_ui">'
									,			redeemButton
									,'  	</div>'

									,		'<div class="card_label">'
									,  			'<p class="card_label_main">' + item.ITEM_NAME + extendedDescription + '</p>'
												//,'<button class="card_info icon cfshop-icon-info" data-modal="#sample_details_modal" data-animation="top" aria-haspopup="true" aria-label="Learn More"></button>'
									,		'</div>'

									,		'<div class="card_disclaimer">'
									,		'	<ul>'
									,		'		<li>' + redeemPara1 + item.DAYS_NEEDED + redeemPara2 + '</li>'
									,		'		<li>' + redeemNotice + daysCompleted + '</li>'
									,		'	</ul>'
									,		'</div>'
									,	'</div>'
									,'</section>'
				];

				$('.nav_sub').after(stringArr.join(''));

			}

		},

        /**
         *
         * Claim BF Attedance event item
         *
         */
		_claimBFEventItem: function(ITEMID){

            var mi = this;
            var data = {'command': 'claimitem', 'ITEM_ID' : ITEMID};

			addToConsole('this merc wants to redeem: ' + ITEMID);

			if(ITEMID){
				$.ajax({
					data: data,
					type: 'post',
					url: 'https://' + window.location.hostname +'/rest/blackfriday.json',
					success: function(result) {

						if(result.APIresult && result.APIresult === "000"
						&& result.p_o_ErrID && result.p_o_ErrID === 1
						&& result.ds_BLACK_FRIDAY_ATTENDANCE_ITEM_CLAIM_Result && result.ds_BLACK_FRIDAY_ATTENDANCE_ITEM_CLAIM_Result[0]
						&& result.ds_BLACK_FRIDAY_ATTENDANCE_ITEM_CLAIM_Result[0].IS_DELIVERED)
						{

							//addToConsole(result);

							addToConsole('redeemed item: ' + ITEMID);
							// pop up modal that item was claimed

							// hide claimbox (nah)

							//mi._showMessage({'result': 'redeemed'});
							mi._popUpGeneralMessage(purchaseCompleteTitle, general_delivery_success, 'success', continueShoppingActionText, null, null);

						}else{
							addToConsole('could not redeem item: ' + ITEMID);
							// pop up modal that there was an error attempting to redeem
							mi._showMessage({'result': -8000, 'APImessage': 'redeem error: ' + general_delivery_error});
						}
					},
					fail: function(result) {
						addToConsole('could not redeem item: ' + ITEMID);
						// pop up modal that there was an error
						mi._showMessage({'result': -8000, 'APImessage': 'redeem fail: ' + general_delivery_error});
					}
				});
			}
		},
		_renderSubEventBanners: function(subEventBanners){

			let mi = this;
			// <nav class="container" id="stickybar"> BF
			//
			const location = $('#subeventbanners');

			let stringArr,stringsArr = [];
			let count = 0;
			const maxCount = 4;

			$.each(subEventBanners, function(i, subeventImg) {
					stringArr = [
							'<div class="sgwz8_shop" style="display:none;">'
								,'<a href="' + subeventImg.WEBSITE_URL + '" target="_blank">'
									//,'<picture>'
									//	,'<source srcset="' + subeventImg.IMG_URL + '" media="(max-width: 600px)">'
										,'<img src="' + subeventImg.IMG_URL + '" />'
									//,'</picture>'
								,'</a>'
							,'</div>'
					];
					count++;

					if(count>maxCount){return false;}

					stringsArr.push(stringArr.join(''));
			});

			if(count){
				location.append(
					 stringsArr.join('')
				);
			}
		},

		_updateDiscountProgress: function (tierRewards, subTotal){

			let spendMore = 0;

			subTotal = (subTotal - 0) ? subTotal : 0;

			let discount = 0;
			let progressElem = '.progress1';
			let altText = '';

			//addToConsole(tierRewards)

			for(let i=0;i<tierRewards.length;i++){

				if(tierRewards[i].DISCOUNT){

					progressElem = '.progress' + (i);
					spendMore = addCommas((tierRewards[i].UPPER_LEVEL + 1) - subTotal);

					if(subTotal >= tierRewards[i].LOWER_LEVEL){
						//activeClass = ' active';

						$(progressElem).attr('active', '');
						$(progressElem).addClass('active');

						discount = tierRewards[i].DISCOUNT;
						altText = SpendMoreForSavingsText1 + ' ' + spendMore + ' ZP ' + SpendMoreForSavingsText2;


						if(i == (tierRewards.length - 1)){
							altText = SpendMoreForSavingsText3;
							$('#savingsLevel').html(SpendMoreForSavingsText3);
						}else{
							$('#savingsLevel').html(SpendMoreForSavingsText1 + ' <span class="tiers-target">' + spendMore + '</span>' + SpendMoreForSavingsText2);
						}

						$(progressElem).attr('alt', altText);
						$(progressElem).find('.status').addClass('icon cfshop-icon-checked'); //.html('<span>' + obtainedText + '</span>');

					}else{
						//spendMore = addCommas(tierRewards[i].LOWER_LEVEL - subTotal);
						//altText = SpendMoreForSavingsText1 + ' ' + spendMore + ' ZP ' + SpendMoreForSavingsText2;
						$(progressElem).attr('alt', altText);
						$(progressElem).removeClass('active');
						$(progressElem).removeAttr('active');
					}
				}
			}

			return [
				discount
				,spendMore
			];

		},

		_displayTierRewards: function (tierRewards, subTotal=0){
			if(!tierRewards) return;

			let spendMore = 0;

			if(subtotal >= 0) {
				spendMore = addCommas(9999 - subTotal + 1);
			}
			const rewardsLocation = $('.tiers-rewards');
			const trackerLocation = $('.tiers-tracker');

			//rewardsLocation.empty();
			//trackerLocation.empty();

			let discount = 0;
			let rewardStringArr = [];
			let trackerStringArr = [];
			let altText = '';
			let activeClass = '';

			for(let i=0;i<tierRewards.length;i++){

				if(tierRewards[i].DISCOUNT){

					altText = ''; // <!-- active, current-->
					activeClass = '';

					if(0 == i){activeClass = ' active'; discount = tierRewards[i].DISCOUNT;}

					if(subTotal < tierRewards[i].LOWER_LEVEL){
						spendMore = addCommas(tierRewards[i].LOWER_LEVEL - subTotal);
						altText = SpendMoreForSavingsText1 + ' ' + spendMore + ' ZP ' + SpendMoreForSavingsText2;

						if(subTotal > tierRewards[i].UPPER_LEVEL){
							activeClass = ' active'
						}
					}

					//if((tierRewards.length == i) && subTotal >= tierRewards[i].UPPER_LEVEL){activeClass = ' active'; altText = SpendMoreForSavingsText3;}

					trackerStringArr = [
						'<button class="tiers-tracker-bar tooltip progress' + i + activeClass + '"'
						,' alt="' + altText + '">'
						//,'<span>' + tierText + ' ' + (i + 1) + ' ' + tierRewards[i].DISCOUNT + '%</span>'
						,'<span>' + tierRewards[i].DISCOUNT + '%</span>'
						,'</button>'
					];

					trackerLocation.append(trackerStringArr.join(''));
				}

				if(tierRewards[i].REWARD_IMG_URL){

					rewardStringArr = [
						'<figure class="tiers-reward progress' + i + '">'
						,'	<img src="' + tierRewards[i].REWARD_IMG_URL + '" alt="' + tierRewards[i].REWARD_NAME + '">'
						,'	<figcaption><span>' + tierText + ' ' + i + '<br></span>' + tierRewards[i].REWARD_NAME + '</figcaption>'
						,'	<div class="status"></div>'
						,'</figure>'
					];

					rewardsLocation.append(rewardStringArr.join(''));
				}
			}
			return discount;

		},


		_renderFaqs: function(faqItems){

			let mi = this;

			let location = ('VIPSKINSALE' == mi.options.shop_type) ? $('#faq .accordion') : $('#faq');

			let stringArr = [];
			let img = '';
			let defaultLang = "EN";
			let directionStyle = "";

			let currentLang = '';

			function getLangName(lang = 'EN'){
				lang = lang.toLowerCase();
				switch (lang){
					case 'en' : return 'English'; break;
					case 'tu' : return 'Türkçe'; break;
					case 'es' : return 'Español'; break;
					case 'pt' : return 'Português'; break;
					case 'ar' : return 'لعربية'; break;
					case 'de' : return 'Deutsch'; break;
					default: return 'English'; break;
				}
			}

			if('pt' == document.documentElement.lang){

				location = $('#faq .accordion');

				$.each(faqItems, function(i, faq) {

					img = ('' !== faq.IMG_URL) ? '<img src="' + faq.IMG_URL + '" alt="faq img" />' : '';
					directionStyle =  (1 == faq.LTR)
								? ' dir="ltr" class="helplang" direction: ltr;" '
								: ' dir="rtl" class="helplang" direction: rtl;" ';

					stringArr = [
								,'<dt><h3 ' + directionStyle + '>' + faq.QUESTION + '</h3></dt>'
								,'<dd ' + directionStyle + '>'
								,	'<div class="faq-flex">'
								,		img
								,		'<div class="content">' +  faq.ANSWER + '</div>'
								,	'</div>'
								,'</dd>'
					];

					location.append(stringArr.join(''));
				});
			}else{
				$.each(faqItems, function(i, faq) {

					// check if category exists
					if(currentLang !== faq.LANG){
						currentLang = faq.LANG;
					}

					location = $('.lang_' + currentLang);

					let directionStyle =  (1 == faq.LTR)
								? ' dir="ltr" class="helplang" style="direction: ltr;" '
								: ' dir="rtl" class="helplang" style="direction: rtl;" ';

					// check if element has been created or not
					if(!($('#lang_' + currentLang).length)){

						// add language to option select
						$('#faqlang').append('<option id="lang_' + currentLang + '" value="' + currentLang + '">' + getLangName(currentLang) + '</option>');

						// add language to accordion container
						$('#faq > .languages').after('<dl class="accordion lang_' + currentLang + '" ' + directionStyle + ' />');
						location = $('dl.lang_' + currentLang);
					}

					img = ('' !== faq.IMG_URL) ? '<img src="' + faq.IMG_URL + '" alt="faq img" />' : '';

					stringArr = [
								,'<dt><h3>' + faq.QUESTION + '</h3></dt>'
								,'<dd>'
								,	'<div class="faq-flex">'
								,		img
								,		'<div class="content">' +  faq.ANSWER + '</div>'
								,	'</div>'
								,'</dd>'
					];

					//addToConsole(i + ' ' + faq.QUESTION)
					location.append(stringArr.join(''));
				});

				$('.accordion').hide();
				$('.lang_' + defaultLang).show();

				$(".languages").on('change', function(event){

					var langVal = event.target.value;
					$('.accordion').hide();
					$('.lang_' + langVal).show();

				});
			}
		},

		_Z8Games_itemlist: function(callback, callback_false) {

			var mi = this;

			addToConsole(' doing items list check with getUserItems');

			const webshopAPI = 'https://' + window.location.hostname + '/rest/webshopitems.json';

			var params = {
				'command' : 'getUserItems'
				,'event': mi.options.shop_type
				,'event_id' : mi.options.shop_event_id
			};

			addToConsole(params);
			// jQuery.getJSON(itemlistAPI + "&callback=?", null, function (result) {

			$.ajax({
				url: webshopAPI,
				type: 'GET',
				data: params,
				dataType: 'json', // added data type
				success: function(result) {

					addToConsole('_Z8Games_itemlist success');
					addToConsole(result)

					//{"p_o_ErrID":0,"APImessage":"OK","APIresult":"000","p_o_ErrDesc":null}

					if(result.returnValue == '0' || '000' == result.APIresult)
					{
						callback(result);

					} else {
						callback_false(result);
					}
				},
				fail: function(result){
					addToConsole('_Z8Games_itemlist fail');
					addToConsole(result);
					callback_false(result);
				}
			});
		},
		_lockConditionalItems: function(ITEM_ID){

			var mi = this;
			var items = Object.keys(mi.options._saleProducts);
			var currVIPItem = parseInt(ITEM_ID,10);

			if(!currVIPItem){
				return;
			}

			$.each(items, function(i, value) {

				value = parseInt(value,10);

				if(mi.options._saleProducts[value] && mi.options._saleProducts[value].CONDITION && -1 !== (mi.options._saleProducts[value].CONDITION).indexOf(currVIPItem)){
				//if(currVIPItem == mi.options._saleProducts[value].CONDITION){
					addToConsole('locking item: ' +  mi.options._saleProducts[value].ITEM_NAME + ' ' +  mi.options._saleProducts[value].ITEM_ID);
					mi.options._saleProducts[value].LOCKED = 1;
					mi._lockITEM_ID( mi.options._saleProducts[value].ITEM_ID);
				}

				/*
				// old way
				if(currVIPItem == mi.options._saleProducts[value].CONDITION){
					addToConsole('locking item: ' +  mi.options._saleProducts[value].ITEM_NAME + ' ' +  mi.options._saleProducts[value].ITEM_ID);
					mi.options._saleProducts[value].LOCKED = 1;
					mi._lockITEM_ID( mi.options._saleProducts[value].ITEM_ID);
				}
				// */
			});
		},
		_unLockConditionalItems: function(ITEM_ID){

			var mi = this;
			var items = Object.keys(mi.options._saleProducts);
			var currVIPItem = parseInt(ITEM_ID,10);

			if(!currVIPItem){
				return;
			}

			$.each(items, function(i, value) {

				value = parseInt(value,10);

				//addToConsole('unlocking item check: (' + value);

				if(mi.options._saleProducts[value] && mi.options._saleProducts[value].CONDITION && -1 !== (mi.options._saleProducts[value].CONDITION).indexOf(currVIPItem)){
				//if(currVIPItem == mi.options._saleProducts[value].CONDITION){
					addToConsole('unlocking item: ' +  mi.options._saleProducts[value].ITEM_NAME + ' ' +  mi.options._saleProducts[value].ITEM_ID);
					//addToConsole('unlocking item: ' +  mi.options._saleProducts[value].ITEM_NAME + ' ' +  mi.options._saleProducts[value].ITEM_ID);
					mi.options._saleProducts[value].LOCKED = 0;
					mi._unLockITEM_ID( mi.options._saleProducts[value].ITEM_ID);
				}

				/*
				// old way
				if(currVIPItem == mi.options._saleProducts[value].CONDITION){
					addToConsole('unlocking item: ' +  mi.options._saleProducts[value].ITEM_NAME + ' ' +  mi.options._saleProducts[value].ITEM_ID);
					//addToConsole('unlocking item: ' +  mi.options._saleProducts[value].ITEM_NAME + ' ' +  mi.options._saleProducts[value].ITEM_ID);
					mi.options._saleProducts[value].LOCKED = 0;
					mi._unLockITEM_ID( mi.options._saleProducts[value].ITEM_ID);
				}
				// */
			});

		},
		_countofITEM_IDInCart: function(ITEM_ID){

			var mi = this;
			var currItem = parseInt(ITEM_ID,10);
			var cartCount = 0;

			addToConsole ('counting ITEM_ID in cart:' + currItem);

            $.each(mi.cart, function (i, p) {

				// verify that this is a populated sales product
				p = mi.options._saleProducts[p.ITEM_ID];

				var currKey = parseInt(p.unique_key, 10);

                if (currKey == currItem ) {

                    cartCount += (p[mi.options.paramSettings.productQuantity] - 0);

                }
            });
			return cartCount;
		},
		_countofTypeInCart: function(cartType){

			var mi = this;
			if('Doll' == cartType || 'Mascote' == cartType || 'DOLL' == cartType || 'MASCOTE' == cartType ){
				cartType = 'SKIN';
			}
			var cartCount = 0;
			var currentCartElemCount = 0;
			var tempCartType = '';

			addToConsole(mi.cart);

            $.each(mi.cart, function (i, p) {

				// verify that this is a populated sales product
				p = mi.options._saleProducts[p.ITEM_ID];

				if('Doll' == p.CART_TYPE || 'Mascote' == p.CART_TYPE || 'DOLL' == p.CART_TYPE || 'MASCOTE' == p.CART_TYPE ){
					tempCartType = 'SKIN';
				}else{
					tempCartType = p.CART_TYPE;
				}
				addToConsole('_countofTypeInCart: checking count of ' + tempCartType);

                if (tempCartType == cartType ) {
					currentCartElemCount = (p[mi.options.paramSettings.productQuantity] - 0);
                    cartCount += ('pt' == document.documentElement.lang) ? 1 : currentCartElemCount;
                }
            });
			addToConsole('_countofTypeInCart: counted ' + cartCount + ' of ' + cartType);
			return cartCount;
		},

		/*

			Update the mercenary's counts and limits and restrictions
		// */
		_updatePosessions: function (mercItems){

			addToConsole(mercItems)

			var mi = this;

			var newMaxUserLimit = maxVIPLimit;		// currently 14

			addToConsole('-- _updatePosessions by displaying mercenary items --');
			addToConsole(mercItems);

			$.each(mercItems, function(i, item) {

				item.ITEM_ID = parseInt(item.ITEM_ID,10);

				let userCount = 0;

				try{
					userCount = (item.hasOwnProperty('EXIST_CNT')) ? item.EXIST_CNT : item.EXISTS_CNT;
					userCount = parseInt(userCount,10);
				}catch(e){
					addToConsole(e);
				}

				addToConsole('_updatePosessions: (not tested) mercItems _updatePosessions item: ' + item.ITEM_TYPE + ' ' + item.DISPLAY_NAME + ' ' + item.ITEM_ID + ' check');
				addToConsole("_updatePosessions: (not tested) mercItems _updatePosessions item EXISTS_CNT ::" + userCount + " itemID :: " + item.ITEM_ID);

				if(!mi.options._saleProducts[item.ITEM_ID]){

					//addToConsole(mi.options._saleProducts);
					addToConsole('not in the current sale :: mercList item: ' + item.ITEM_ID + ' ' + item.DISPLAY_NAME);
					addToConsole(item.ITEM_ID + ',' + item.DISPLAY_NAME);

					return true;
				}

				let saleItem = mi.options._saleProducts[item.ITEM_ID];

				addToConsole('_updatePosessions: (Tested) mercItems _updatePosessions item: ' + saleItem.ITEM_TYPE + ' ' + saleItem.ITEM_NAME + ' ' + item.ITEM_ID + ' check');
				addToConsole("_updatePosessions: (Tested) mercItems _updatePosessions item EXISTS_CNT ::" + userCount + " itemID :: " + item.ITEM_ID);

				try {

					// update the DOM if possible
					//$('.owned_' + item.ITEM_ID).html(ownedText + ':&nbsp;<span>' + userCount + '</span>');

					// save the user count with the saleProducts
					mi.options._saleProducts[item.ITEM_ID].EXISTS_CNT = userCount;

					addToConsole("restriction on ::  " + item.ITEM_ID + " -> " + parseInt(mi.options._saleProducts[item.ITEM_ID].RESTRICTIONS - 0));

					if(!mi.options._saleProducts[item.ITEM_ID].hasOwnProperty('RESTRICTIONS')){

						// this is probably a hidden item in the DOM

						addToConsole("restriction on ::  " + item.ITEM_ID + " could not be found ");

						//$('.owned_' + item.ITEM_ID).html(ownedText + ':&nbsp;<span>0</span>');
						return true;
					}

					if(parseInt(mi.options._saleProducts[item.ITEM_ID].RESTRICTIONS,10) - 0){

						addToConsole("restriction check on: " + item.ITEM_ID + " userCount " + userCount);

						//addToConsole( mi.options._saleProducts[item.ITEM_ID].ITEM_NAME + ' limit: max: ' + mi.options._saleProducts[item.ITEM_ID].RESTRICTIONS + ' user count: ' + userCount);

						var max = (mi.options._saleProducts[item.ITEM_ID].RESTRICTIONS-0);

						if(userCount){

							//addToConsole('this mercenary has ' + userCount + ' of the ' + item.DISPLAY_NAME);
							addToConsole('this mercenary has ' + userCount + ' of the ' + saleItem.ITEM_NAME);

							// display the user's count
							//$('.owned_' + item.ITEM_ID).html(ownedText + ':&nbsp;<span>' + userCount + '</span>');

							if(userCount === max){

								// lock the item

									// disable
									mi._lockITEM_ID(item.ITEM_ID);

									// grey out
									// by adding limit attribute

									$('#' + item.ITEM_ID).attr('limit');

									// update number owned text
									//$('.owned_' + item.ITEM_ID).html(ownedLimitReachedText);


							}else if(userCount < max){

								//alert('unlocking ' + item.ITEM_ID + ' ' + mi.options._saleProducts[item.ITEM_ID].ITEM_NAME);

								mi._unLockConditionalItems(item.ITEM_ID);

								if((Math.abs(max - userCount)) >= 0){

									addToConsole('This mercenary is allowed to purchase ' + (max - userCount) + ' more items with name: ' + mi.options._saleProducts[item.ITEM_ID].ITEM_NAME);

									newMaxUserLimit = ((max - userCount) >= 0) ? (max - userCount) : 0;

									mi.options._saleProducts[item.ITEM_ID].LIMIT_PER_USER = newMaxUserLimit;
								}
							}
						}
					}
				}catch(e){
				   //mi._logError(e.message);

				   //console.log(e)
				   addToConsole('-----')
				   addToConsole('saleProducts[' + item.ITEM_ID +'].RESTRICTIONS - 0 ' + e.message);
				}
			});

			// now set vfx and skin restrictions since the list is now complete
			$.each(mercItems, function(i, item) {
				// if item is a VIP weapon, update the upper limit of the corresponding skin/vfx ...

				if(!mi.options._saleProducts[item.ITEM_ID]){
					addToConsole('mercList item: ' + item.ITEM_ID + ' ' + item.DISPLAY_NAME + ' not in the current sale');
					return true;
				}

			});

			/**/

			// now lock vfx and skin restrictions since the list is now complete
			$.each(mercItems, function(i, item) {

				if(!mi.options._saleProducts[item.ITEM_ID]){
					addToConsole('mercList item: ' + item.ITEM_ID + ' ' + item.DISPLAY_NAME + ' not in the current sale');
					return true;
				}

				try{
					// if the skin/vfx has a condition, lock it if the user does not have the skin/vfx OR the user does not have the corresponding VIP
					if(mi.options._saleProducts[item.ITEM_ID].CONDITION && (null !== mi.options._saleProducts[item.ITEM_ID].CONDITION || '' !== mi.options._saleProducts[item.ITEM_ID].CONDITION)
						&&
						!mi.options._saleProducts[item.ITEM_ID].EXISTS_CNT
						//&&
						//!mi.options._saleProducts[parseInt(mi.options._saleProducts[item.ITEM_ID].CONDITION,10)].EXISTS_CNT
						){

							try{

								// only

								let IDs = (mi.options._saleProducts[item.ITEM_ID].CONDITION).split(',');

								// loop through
								var lockThisItem = true;

								IDs.forEach((ITEM_ID) => {

									ITEM_ID = parseInt(ITEM_ID,10);
									var conditionalITEM_ID = ITEM_ID;

									addToConsole('userPosessionsInit -> Checking conditional ITEMID : ' + conditionalITEM_ID);

									if(mi.options._saleProducts[conditionalITEM_ID].EXISTS_CNT){
										lockThisItem = false;
									}

								});

								if(lockThisItem){
									addToConsole('userPosessionsInit -> Locking: ' + item.ITEM_ID + ' (' + mi.options._saleProducts[item.ITEM_ID].ITEM_NAME + ')');
									mi._lockITEM_ID(item.ITEM_ID);
								}else{
									mi._unLockITEM_ID(item.ITEM_ID);
								}

								//});
							}catch(e){
								addToConsole(e)
							}
					}
				}catch(e){
					//mi._logError(e.message);
					addToConsole('saleProducts[' + item.ITEM_ID +'].RESTRICTIONS - 0 ' + e.message);
				}
			});
			// */

		},
		_refreshCart: function (){
			modalHide();
			//activateModal('.modal__checkout-cart');
			//addToConsole('checkout');
		},
		/**
		 *
		 * Get the user's inventory to update their possessions and restrictions (and update locked items)
		 * Used for VVIP skin sale (could possibly be used for other shops)
		 *
		 */
		_refreshList: function (){

			var mi = this;

			if('CFSHOP' !== mi.options.shop_type){

				addToConsole(' time to do item update');
				//ITEM Update
				mi._Z8Games_itemlist(function(result){

					//addToConsole(items);

					addToConsole(' time to check user possessions');

					// we might save these mercitems to process AFTER the sale items render is complete
					//window.mercItems = items;

					mi._triggerEvent("itemListRefreshed", result);

					mi._triggerEvent("preloadCart");

					return;

				},
				function(result){

					addToConsole(' did not get result from user possessions');
					mi._Z8Games_exception(result);
				});
			}
		},

		/**
		 *
		 * Save an item to the player's cart in the storage area
		 */
		_updateCartItem: function (ITEM_ID, quantity, callback, callback_false)
		{

			/**
			//if(debug){

				const successfulResult = {

					'cartItems':[
						{'result': 2}
					],
					'APIMessage': 'OK',
					'APIResult': '000',
				};

				callback(successfulResult);
				return;
			//}
			// */


			var mi = this;

			// we no longer save to the DB
			//return true;
			var retVal = false;

			quantity = (quantity - 0) ? quantity : 0;

			if(!quantity){
				// delete
				addToConsole('INVOICE Delete: ' + ITEM_ID);
				quantity = 0;
			}

			addToConsole('INVOICE Update: ' + ITEM_ID + ' Quantity: ' + quantity);

			var mycommand = ('VIPSKINSALE' === mi.options.shop_type) ? 'savevipcart' : 'savecfshopcart';

			var data = {
				'command': mycommand,
				'event': mi.options.shop_type,
				'ITEM_ID': ITEM_ID,
				'QUANTITY': quantity,
				'event_id' : mi.options.shop_event_id
			};

			if(mi.options.xhrItemPool[ITEM_ID])
			{
				mi.options.xhrItemPool[ITEM_ID].abort();
				mi.options.xhrItemPool[ITEM_ID] = null;
			}

			var xhr = new window.XMLHttpRequest();
			var request = $.ajax({
				data: data,
				type: 'post',
				url: webshopAPI,
				xhr: function(){
					mi.options.xhrItemPool[ITEM_ID] = xhr;
					return xhr;
				},
				success: function(result) {

					addToConsole(result)

					if(result.APIresult === "000" || result.apiresult == '000' || result.result == '000')
					{

						let p_o_ErrID = 0;

						if(result.hasOwnProperty('p_o_ErrID')){
							p_o_ErrID = result.p_o_ErrID;
						}

						if(p_o_ErrID == 0){
							retVal = true;

							callback(result);

							//mi._hasCartChange();
						}else{

							callback_false(result);
						}

					}else{
						addToConsole(result.APIresult + ': ' + couldNotSaveCart);
						addToConsole(result.APImessage);
						// something happend on the way to the cart

						callback_false(result);
					}
				},
				fail: function(result) {

					addToConsole(result)
					// nothing in your cart, or took too long
					addToConsole(couldNotSaveCart);
					callback_false(result);
				}
			});

			return retVal;
		},
		noCharacterMessage: function(result = {}){
			$(document).click(function() {
				location.href = window.location.origin;
			});
			let mi = this;

			let outputMessage = nochar_msg_messg;
			if(result && result.hasOwnProperty('trackID')){
				outputMessage += ', tracerID: ' + result.trackID;
			}
			if(result && result.hasOwnProperty('APIresult')){
				outputMessage += ', code: ' + result.APIresult;
			}
			mi._popUpGeneralMessage(nochar_msg_title, outputMessage, "gotoCrossfire", continueShoppingActionText);
		},
		pleaseSignInMessage: function(msg=pleaseLoginContinue){

			$(document).click(function() {
				location.href = LOGIN_PAGE_URL;
			});
			let mi = this;
			mi._popUpGeneralMessage(logged_in_title, msg, "gotologin", continueShoppingActionText);
		},
		getPlayerIGN: function (callback, callback_false){

			let mi = this;
			let trackID = Math.random().toString(36).substring(2, 2 + 7);

			const checkSTATSURL = 'https://' + window.location.hostname + '/rest/salesevent.json';
			$.ajax({
				type: 'get',
				data: {'command' : 'getign', 'trackID': trackID},
				url: checkSTATSURL,
				success: function(result) {

					addToConsole(result);
					result.trackID = trackID

					try{

						if(-1 !== result.nick[0].result){
							mi.options.userHasCharacter = true;
							callback();
						}else{
							mi.options.userHasCharacter = false;

							callback_false(result);
						}

					}catch(e){

						addToConsole(e.message);
						callback_false(result);
					}
				},
				fail: function(result) {
					// perhaps the user has to sign in
					addToConsole('get ign fail');
					result.trackID = 'fail: ' + trackID;

					callback_false(result);

				},
				error: function(result) {
					// perhaps the user has to sign in
					addToConsole('get ign error');
					result.trackID = 'error: ' + trackID;
					callback_false(result);
				},
				complete: function(result){

					// get data
				}

			});
		},

		/*
			This function should update the cart with
		*/
		_updateCart: function(){

			addToConsole('updating the cart');
		},

        /*
         * Event raiser
         */
        _triggerEvent: function (name, params) {
            var mi = this;
			var message = '';

			// params[0] = product object
			// params[1] = quantity

            switch(name)
            {
                case "itemAdded" : {

					addToConsole("itemAdded trigger");

					addToConsole(' itemAdded (start) > mi._updateCartItem ');
					addToConsole(params);

					var quantity = 1;

					if(params && params[0] && params[0].unique_key){
						addToConsole('item: ' + params[0].unique_key + ' quantity: ' + quantity);
					}

					//alert(' itemAdded preload action: ' + mi.options.preload_action)
					addToConsole(' itemAdded preload action: ' + mi.options.preload_action);

                    if(!mi.options.preload_action)
                    {
						addToConsole(' itemAdded (not preload) > mi._updateCartItem: ');
						addToConsole(params);

						mi._updateCartItem(params[0].ITEM_ID,quantity,
							function(result){

								let eventResult = mi._cartItemEventCheck(result, params[0].ITEM_ID, params[0], quantity);

								if(eventResult){
									//mi._updateCartQuantity(params[0].ITEM_ID, quantity);

									var pf = $.grep(mi.cart, function (n, i) {
										return mi._isObjectsEqual(n, params[0]);
									});

									if (pf.length > 0) {

										addToConsole('actually inserting quantity of: ' + quantity);
										var idx = mi.cart.indexOf(pf[0]);
										addToConsole(mi.cart[idx]);
										mi.cart[idx][mi.options.paramSettings.productQuantity] = quantity;

										p = mi.cart[idx];
									}else{

										// push to cart because it wasn't found in the cart
                                        let mynewItem = params[0];  // for my own clarity/sanity
                                        mynewItem[mi.options.paramSettings.productQuantity] = quantity;
										mi.cart.push(mynewItem);
									}

									addToConsole(' itemAdded _cartItemEventCheck complete');
									mi._hasCartChange();
								}else{
									// failure results are handled in '_cartItemEventCheck'
								}
							},
							function(result){
								mi._cartItemEventFail(result, params[0].ITEM_ID);
								addToConsole(' itemAdded _cartItemEventFail complete');
							}
						);

                    }else{
						addToConsole('ATTEMPT itemAdded (preload) > mi._updateCartItem: ');
					}
                }
                break;

                case "itemRemoved" : {

					addToConsole("itemRemoved trigger");

					mi._refreshCartDisplayTotals();
                    mi._hasCartChange();
					// re-render cart in case there are no items to purchase

					//if(this.options.show_cart && this.cart.length <= 1){
					if(mi.options.show_cart){
						mi._renderCart();
					}
                }
                break;

                case "itemLocked" : {

					if(params && params[0] && params[0].unique_key){
						// update to locked img and disable button
						mi._lockITEM_ID(params[0].unique_key);
					}
                }
                break;

                case "itemUnLocked" : {

					if(params && params[0] && params[0].unique_key){
						// update to locked img and disable button
						mi._unLockITEM_ID(params[0].unique_key);
					}
                }
                break;

                case "quantityUpdated" : {

					addToConsole("quantityUpdated trigger");

					addToConsole('params');
					addToConsole(params);

					if(params && params[0] && params[0].unique_key){

						if(params[1] || 0 == params[1]){
							addToConsole('item: ' + params[0].unique_key + ' quantity: ' + params[1]);
						}else{
							addToConsole('item: ' + params[0].unique_key);
						}

						addToConsole(' quantityUpdated > mi._updateCartItem: ');
						addToConsole(params);

						let quantity = params[1];

						mi._updateCartItem(params[0].ITEM_ID,params[1],
							function(result){
								let eventResult = mi._cartItemEventCheck(result, params[0].ITEM_ID, params[0], quantity);

								if(eventResult){
                                    //addToConsole('yup quantity updated');
									mi._updateCartQuantity(params[0].ITEM_ID, quantity);
									addToConsole(' quantityUpdated _cartItemEventCheck complete');
									mi._hasCartChange();
								}else{
                                    //addToConsole('nope quantity not updated');
									// failure results are handled in '_cartItemEventCheck'
								}
							},
							function(result){
								mi._cartItemEventFail(result, params[0].ITEM_ID);
							}
						);
					}
                }break;

                case "itemUpdated" : {
					addToConsole("itemUpdated trigger");

					if(params && params[0] && params[0].unique_key){

						if(params[1] || 0 == params[1]){
							addToConsole('item: ' + params[0].unique_key + ' quantity: ' + params[1]);
						}else{
							addToConsole('item: ' + params[0].unique_key);
						}
					}

					addToConsole(' itemUpdated > mi._updateCartItem: ');
					addToConsole(params);

					let quantity = params[1];

					mi._updateCartItem(params[0].ITEM_ID,params[1],
						function(result){
							let eventResult = mi._cartItemEventCheck(result, params[0].ITEM_ID, params[0], quantity);

							if(eventResult){
                                //addToConsole('yup item updated');
								mi._updateCartQuantity(params[0].ITEM_ID, quantity);
								addToConsole(' itemUpdated _cartItemEventCheck complete');
								mi._hasCartChange();
							}else{
								// failure results are handled in '_cartItemEventCheck'
                                //addToConsole('nope item not updated');
							}
						},
						function(result){
							mi._cartItemEventFail(result, params[0].ITEM_ID);
						}
					);
                }
                break;

				case "itemListRetrieved" : {

					addToConsole("itemListRetrieved trigger");
					mi._refreshList();

				} break;

				case "preloadCart" : {

					addToConsole('prepare to preload cart')
					mi._preloadCart();

				} break;

				case "itemListRefreshed" : {

					addToConsole("itemListRetrieved trigger");

					let items = [];
					if(params && params.dsItemList){
						items = params.dsItemList;
					}
					if(params && params.items){
						items = params.items;
					}

					addToConsole('prepare to update possessions ')
					mi._updatePosessions(items);

				} break;

				case "cartListRetrieved" : {
					addToConsole("cartListRetrieved trigger");
					mi._renderCart();
				}
				break;

				case "userPossessionsRetrieved" : {
					addToConsole("userPossessionsRetrieved trigger");
				}
				break;

				case "showCompletePurchasePage" : {
					addToConsole("showCompletePurchasePage trigger");

					mi.options.show_cart = false;
					$('.sgwz8_cart').hide();
					$('.sgwz8_shop').hide();
					$('.sgwz8_complete').show();

				}
				break;

				case "showShopPurchasePage" : {
					addToConsole("showShopPurchasePage trigger");
					closeOpenDialog();

					mi.options.show_cart = false;
					$('.sgwz8_cart').hide();
					$('.sgwz8_shop').show();

				}
				break;

				case "showCartPage" : {
					closeOpenDialog();
					addToConsole("showCartPage trigger");

					mi.options.show_cart = true;
					mi._renderCart();
					$('.sgwz8_shop').hide();
					$('.sgwz8_cart').show();

					window.scrollTo({
						top: 0,
						behavior: 'smooth'
					});
				}
				break;
            }

            // Trigger an event
            var e = $.Event(name);
            this.cart_element.trigger(e, params);
            if (e.isDefaultPrevented()) {
                return false;
            }
            return e.result;
        },
        /*
         * Get unique key
         */
        _getUniqueKey: function () {
            var d = new Date();
            return d.getTime();
        },
        /*
         * Log message to console
         */
        _logMessage: function (msg) {
			addToConsole(msg);
        },
        /*
         * Log error to console and terminate execution
         */
        _logError: function (msg) {
            addToConsole(msg);
        },

        // PUBLIC FUNCTIONS
        /*
         * Public function to sumbit the cart
         */
        submit: function () {
            //this._submitCartCheck();
        },
        /*
         * Public function to clear the cart
         */
        clear: function () {
            this._clearCart();
        }
    });

    // Wrapper for the plugin
    $.fn.smartCart = function (options) {
        var args = arguments;
        var instance;

        if (options === undefined || typeof options === 'object') {
            return this.each(function () {
                if (!$.data(this, "smartCart")) {
                    $.data(this, "smartCart", new SmartCart(this, options));
                }
            });
        } else if (typeof options === 'string' && options[0] !== '_' && options !== 'init') {
            instance = $.data(this[0], 'smartCart');

            if (options === 'destroy') {
                $.data(this, 'smartCart', null);
            }

            if (instance instanceof SmartCart && typeof instance[options] === 'function') {
                return instance[options].apply(instance, Array.prototype.slice.call(args, 1));
            } else {
                return this;
            }
        }
    };

})(jQuery, window, document);